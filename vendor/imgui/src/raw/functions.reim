    /// return true when activated + toggle (*p_selected) if p_selected != NULL
    pub fn ImGui_MenuItemBoolPtr(label: *const c::Char, shortcut: *const c::Char, p_selected: *mut bool, enabled: bool) -> bool;

    /// Tooltips
    /// - Tooltips are windows following the mouse. They do not take focus away.
    /// - A tooltip window can contain items of any types.
    /// - SetTooltip() is more or less a shortcut for the 'if (BeginTooltip()) { Text(...); EndTooltip(); }' idiom (with a subtlety that it discard any previously submitted tooltip)
    /// begin/append a tooltip window.
    pub fn ImGui_BeginTooltip() -> bool;

    /// only call EndTooltip() if BeginTooltip()/BeginItemTooltip() returns true!
    pub fn ImGui_EndTooltip();

    /// set a text-only tooltip. Often used after a ImGui::IsItemHovered() check. Override any previous call to SetTooltip().
    pub fn ImGui_SetTooltipUnformatted(text: *const c::Char);

    /// Calls Dear ImGui's `ImGui::SetTooltipV` operation through the generated C ABI.
    pub fn ImGui_SetTooltipV(fmt: *const c::Char, args: *mut ());

    /// Tooltips: helpers for showing a tooltip when hovering an item
    /// - BeginItemTooltip() is a shortcut for the 'if (IsItemHovered(ImGuiHoveredFlags_ForTooltip) && BeginTooltip())' idiom.
    /// - SetItemTooltip() is a shortcut for the 'if (IsItemHovered(ImGuiHoveredFlags_ForTooltip)) { SetTooltip(...); }' idiom.
    /// - Where 'ImGuiHoveredFlags_ForTooltip' itself is a shortcut to use 'style.HoverFlagsForTooltipMouse' or 'style.HoverFlagsForTooltipNav' depending on active input type. For mouse it defaults to 'ImGuiHoveredFlags_Stationary | ImGuiHoveredFlags_DelayShort'.
    /// begin/append a tooltip window if preceding item was hovered.
    pub fn ImGui_BeginItemTooltip() -> bool;

    /// set a text-only tooltip if preceding item was hovered. override any previous call to SetTooltip().
    pub fn ImGui_SetItemTooltipUnformatted(text: *const c::Char);

    /// Calls Dear ImGui's `ImGui::SetItemTooltipV` operation through the generated C ABI.
    pub fn ImGui_SetItemTooltipV(fmt: *const c::Char, args: *mut ());

    /// Popups, Modals
    /// - They block normal mouse hovering detection (and therefore most mouse interactions) behind them.
    /// - If not modal: they can be closed by clicking anywhere outside them, or by pressing ESCAPE.
    /// - Their visibility state (~bool) is held internally instead of being held by the programmer as we are used to with regular Begin*() calls.
    /// - The 3 properties above are related: we need to retain popup visibility state in the library because popups may be closed as any time.
    /// - You can bypass the hovering restriction by using ImGuiHoveredFlags_AllowWhenBlockedByPopup when calling IsItemHovered() or IsWindowHovered().
    /// - IMPORTANT: Popup identifiers are relative to the current ID stack, so OpenPopup and BeginPopup generally needs to be at the same level of the stack.
    /// This is sometimes leading to confusing mistakes. May rework this in the future.
    /// - BeginPopup(): query popup state, if open start appending into the window. Call EndPopup() afterwards if returned true. ImGuiWindowFlags are forwarded to the window.
    /// - BeginPopupModal(): block every interaction behind the window, cannot be closed by user, add a dimming background, has a title bar.
    /// return true if the popup is open, and you can start outputting to it.
    pub fn ImGui_BeginPopup(str_id: *const c::Char, flags: types::ImGuiWindowFlags) -> bool;

    /// return true if the modal is open, and you can start outputting to it.
    pub fn ImGui_BeginPopupModal(name: *const c::Char, p_open: *mut bool, flags: types::ImGuiWindowFlags) -> bool;

    /// only call EndPopup() if BeginPopupXXX() returns true!
    pub fn ImGui_EndPopup();

    /// Popups: open/close functions
    /// - OpenPopup(): set popup state to open. ImGuiPopupFlags are available for opening options.
    /// - If not modal: they can be closed by clicking anywhere outside them, or by pressing ESCAPE.
    /// - CloseCurrentPopup(): use inside the BeginPopup()/EndPopup() scope to close manually.
    /// - CloseCurrentPopup() is called by default by Selectable()/MenuItem() when activated (FIXME: need some options).
    /// - Use ImGuiPopupFlags_NoOpenOverExistingPopup to avoid opening a popup if there's already one at the same level. This is equivalent to e.g. testing for !IsAnyPopupOpen() prior to OpenPopup().
    /// - Use IsWindowAppearing() after BeginPopup() to tell if a window just opened.
    /// call to mark popup as open (don't call every frame!).
    pub fn ImGui_OpenPopup(str_id: *const c::Char, popup_flags: types::ImGuiPopupFlags);

    /// id overload to facilitate calling from nested stacks
    pub fn ImGui_OpenPopupID(id: types::ImGuiID, popup_flags: types::ImGuiPopupFlags);

    /// helper to open popup when clicked on last item. Default to ImGuiPopupFlags_MouseButtonRight == 1. (note: actually triggers on the mouse _released_ event to be consistent with popup behaviors)
    pub fn ImGui_OpenPopupOnItemClick(str_id: *const c::Char, popup_flags: types::ImGuiPopupFlags);

    /// manually close the popup we have begin-ed into.
    pub fn ImGui_CloseCurrentPopup();

    /// Popups: Open+Begin popup combined functions helpers to create context menus.
    /// - Helpers to do OpenPopup+BeginPopup where the Open action is triggered by e.g. hovering an item and right-clicking.
    /// - IMPORTANT: Notice that BeginPopupContextXXX takes ImGuiPopupFlags just like OpenPopup() and unlike BeginPopup(). For full consistency, we may add ImGuiWindowFlags to the BeginPopupContextXXX functions in the future.
    /// - IMPORTANT: If you ever used the left mouse button with BeginPopupContextXXX() helpers before 1.92.6:
    /// - Before this version, OpenPopupOnItemClick(), BeginPopupContextItem(), BeginPopupContextWindow(), BeginPopupContextVoid() had 'a ImGuiPopupFlags popup_flags = 1' default value in their function signature.
    /// - Before: Explicitly passing a literal 0 meant ImGuiPopupFlags_MouseButtonLeft. The default = 1 meant ImGuiPopupFlags_MouseButtonRight.
    /// - After: The default = 0 means ImGuiPopupFlags_MouseButtonRight. Explicitly passing a literal 1 also means ImGuiPopupFlags_MouseButtonRight (if legacy behavior are enabled) or will assert (if legacy behavior are disabled).
    /// - TL;DR: if you don't want to use right mouse button for popups, always specify it explicitly using a named ImGuiPopupFlags_MouseButtonXXXX value.
    /// - Read "API BREAKING CHANGES" 2026/01/07 (1.92.6) entry in imgui.cpp or GitHub topic #9157 for all details.
    /// Implied str_id = NULL, popup_flags = 0
    pub fn ImGui_BeginPopupContextItem() -> bool;

    /// open+begin popup when clicked on last item. Use str_id==NULL to associate the popup to previous item. If you want to use that on a non-interactive item such as Text() you need to pass in an explicit ID here. read comments in .cpp!
    pub fn ImGui_BeginPopupContextItemEx(str_id: *const c::Char, popup_flags: types::ImGuiPopupFlags) -> bool;

    /// Implied str_id = NULL, popup_flags = 0
    pub fn ImGui_BeginPopupContextWindow() -> bool;

    /// open+begin popup when clicked on current window.
    pub fn ImGui_BeginPopupContextWindowEx(str_id: *const c::Char, popup_flags: types::ImGuiPopupFlags) -> bool;

    /// Implied str_id = NULL, popup_flags = 0
    pub fn ImGui_BeginPopupContextVoid() -> bool;

    /// open+begin popup when clicked in void (where there are no windows).
    pub fn ImGui_BeginPopupContextVoidEx(str_id: *const c::Char, popup_flags: types::ImGuiPopupFlags) -> bool;

    /// Popups: query functions
    /// - IsPopupOpen(): return true if the popup is open at the current BeginPopup() level of the popup stack.
    /// - IsPopupOpen() with ImGuiPopupFlags_AnyPopupId: return true if any popup is open at the current BeginPopup() level of the popup stack.
    /// - IsPopupOpen() with ImGuiPopupFlags_AnyPopupId + ImGuiPopupFlags_AnyPopupLevel: return true if any popup is open.
    /// return true if the popup is open.
    pub fn ImGui_IsPopupOpen(str_id: *const c::Char, flags: types::ImGuiPopupFlags) -> bool;

    /// Tables
    /// - Full-featured replacement for old Columns API.
    /// - See Demo->Tables for demo code. See top of imgui_tables.cpp for general commentary.
    /// - See ImGuiTableFlags_ and ImGuiTableColumnFlags_ enums for a description of available flags.
    /// The typical call flow is:
    /// - 1. Call BeginTable(), early out if returning false.
    /// - 2. Optionally call TableSetupColumn() to submit column name/flags/defaults.
    /// - 3. Optionally call TableSetupScrollFreeze() to request scroll freezing of columns/rows.
    /// - 4. Optionally call TableHeadersRow() to submit a header row. Names are pulled from TableSetupColumn() data.
    /// - 5. Populate contents:
    /// - In most situations you can use TableNextRow() + TableSetColumnIndex(N) to start appending into a column.
    /// - If you are using tables as a sort of grid, where every column is holding the same type of contents,
    /// you may prefer using TableNextColumn() instead of TableNextRow() + TableSetColumnIndex().
    /// TableNextColumn() will automatically wrap-around into the next row if needed.
    /// - IMPORTANT: Comparatively to the old Columns() API, we need to call TableNextColumn() for the first column!
    /// - Summary of possible call flow:
    /// - TableNextRow() -> TableSetColumnIndex(0) -> Text("Hello 0") -> TableSetColumnIndex(1) -> Text("Hello 1")  // OK
    /// - TableNextRow() -> TableNextColumn()      -> Text("Hello 0") -> TableNextColumn()      -> Text("Hello 1")  // OK
    /// -                   TableNextColumn()      -> Text("Hello 0") -> TableNextColumn()      -> Text("Hello 1")  // OK: TableNextColumn() automatically gets to next row!
    /// - TableNextRow()                           -> Text("Hello 0")                                               // Not OK! Missing TableSetColumnIndex() or TableNextColumn()! Text will not appear!
    /// - 5. Call EndTable()
    /// Implied outer_size = ImVec2(0.0f, 0.0f), inner_width = 0.0f
    pub fn ImGui_BeginTable(str_id: *const c::Char, columns: c::Int, flags: types::ImGuiTableFlags) -> bool;

    /// Calls Dear ImGui's `ImGui::BeginTable` operation through the generated C ABI.
    pub fn ImGui_BeginTableEx(str_id: *const c::Char, columns: c::Int, flags: types::ImGuiTableFlags, outer_size: types::ImVec2, inner_width: f32) -> bool;

    /// only call EndTable() if BeginTable() returns true!
    pub fn ImGui_EndTable();

    /// Implied row_flags = 0, min_row_height = 0.0f
    pub fn ImGui_TableNextRow();

    /// append into the first cell of a new row. 'min_row_height' include the minimum top and bottom padding aka CellPadding.y * 2.0f.
    pub fn ImGui_TableNextRowEx(row_flags: types::ImGuiTableRowFlags, min_row_height: f32);

    /// append into the next column (or first column of next row if currently in last column). Return true when column is visible.
    pub fn ImGui_TableNextColumn() -> bool;

    /// append into the specified column. Return true when column is visible.
    pub fn ImGui_TableSetColumnIndex(column_n: c::Int) -> bool;

    /// Tables: Headers & Columns declaration
    /// - Use TableSetupColumn() to specify label, resizing policy, default width/weight, id, various other flags etc.
    /// - Use TableHeadersRow() to create a header row and automatically submit a TableHeader() for each column.
    /// Headers are required to perform: reordering, sorting, and opening the context menu.
    /// The context menu can also be made available in columns body using ImGuiTableFlags_ContextMenuInBody.
    /// - You may manually submit headers using TableNextRow() + TableHeader() calls, but this is only useful in
    /// some advanced use cases (e.g. adding custom widgets in header row).
    /// - Use TableSetupScrollFreeze() to lock columns/rows so they stay visible when scrolled. When freezing columns you would usually also use ImGuiTableColumnFlags_NoHide on them.
    /// Implied init_width_or_weight = 0.0f, user_id = 0
    pub fn ImGui_TableSetupColumn(label: *const c::Char, flags: types::ImGuiTableColumnFlags);

    /// Calls Dear ImGui's `ImGui::TableSetupColumn` operation through the generated C ABI.
    pub fn ImGui_TableSetupColumnEx(label: *const c::Char, flags: types::ImGuiTableColumnFlags, init_width_or_weight: f32, user_id: types::ImGuiID);

    /// lock columns/rows so they stay visible when scrolled.
    pub fn ImGui_TableSetupScrollFreeze(cols: c::Int, rows: c::Int);

    /// submit one header cell manually (rarely used)
    pub fn ImGui_TableHeader(label: *const c::Char);

    /// submit a row with headers cells based on data provided to TableSetupColumn() + submit context menu
    pub fn ImGui_TableHeadersRow();

    /// submit a row with angled headers for every column with the ImGuiTableColumnFlags_AngledHeader flag. MUST BE FIRST ROW.
    pub fn ImGui_TableAngledHeadersRow();

    /// Tables: Sorting & Miscellaneous functions
    /// - Sorting: call TableGetSortSpecs() to retrieve latest sort specs for the table. NULL when not sorting.
    /// When 'sort_specs->SpecsDirty == true' you should sort your data. It will be true when sorting specs have
    /// changed since last call, or the first time. Make sure to set 'SpecsDirty = false' after sorting,
    /// else you may wastefully sort your data every frame!
    /// - Functions args 'int column_n' treat the default value of -1 as the same as passing the current column index.
    /// get latest sort specs for the table (NULL if not sorting).  Lifetime: don't hold on this pointer over multiple frames or past any subsequent call to BeginTable().
    pub fn ImGui_TableGetSortSpecs() -> *mut types::ImGuiTableSortSpecs;

    /// return number of columns (value passed to BeginTable)
    pub fn ImGui_TableGetColumnCount() -> c::Int;

    /// return current column index.
    pub fn ImGui_TableGetColumnIndex() -> c::Int;

    /// return current row index (header rows are accounted for)
    pub fn ImGui_TableGetRowIndex() -> c::Int;

    /// return "" if column didn't have a name declared by TableSetupColumn(). Pass -1 to use current column.
    pub fn ImGui_TableGetColumnName(column_n: c::Int) -> *const c::Char;

    /// return column flags so you can query their Enabled/Visible/Sorted/Hovered status flags. Pass -1 to use current column.
    pub fn ImGui_TableGetColumnFlags(column_n: c::Int) -> types::ImGuiTableColumnFlags;

    /// change user accessible enabled/disabled state of a column. Set to false to hide the column. User can use the context menu to change this themselves (right-click in headers, or right-click in columns body with ImGuiTableFlags_ContextMenuInBody)
    pub fn ImGui_TableSetColumnEnabled(column_n: c::Int, v: bool);

    /// return hovered column. return -1 when table is not hovered. return columns_count if the unused space at the right of visible columns is hovered. Can also use (TableGetColumnFlags() & ImGuiTableColumnFlags_IsHovered) instead.
    pub fn ImGui_TableGetHoveredColumn() -> c::Int;

    /// change the color of a cell, row, or column. See ImGuiTableBgTarget_ flags for details.
    pub fn ImGui_TableSetBgColor(target: types::ImGuiTableBgTarget, color: types::ImU32, column_n: c::Int);

    /// Legacy Columns API (prefer using Tables!)
    /// - You can also use SameLine(pos_x) to mimic simplified columns.
    /// Implied count = 1, id = NULL, borders = true
    pub fn ImGui_Columns();

    /// Calls Dear ImGui's `ImGui::Columns` operation through the generated C ABI.
    pub fn ImGui_ColumnsEx(count: c::Int, id: *const c::Char, borders: bool);

    /// next column, defaults to current row or next row if the current row is finished
    pub fn ImGui_NextColumn();

    /// get current column index
    pub fn ImGui_GetColumnIndex() -> c::Int;

    /// get column width (in pixels). pass -1 to use current column
    pub fn ImGui_GetColumnWidth(column_index: c::Int) -> f32;

    /// set column width (in pixels). pass -1 to use current column
    pub fn ImGui_SetColumnWidth(column_index: c::Int, width: f32);

    /// get position of column line (in pixels, from the left side of the contents region). pass -1 to use current column, otherwise 0..GetColumnsCount() inclusive. column 0 is typically 0.0f
    pub fn ImGui_GetColumnOffset(column_index: c::Int) -> f32;

    /// set position of column line (in pixels, from the left side of the contents region). pass -1 to use current column
    pub fn ImGui_SetColumnOffset(column_index: c::Int, offset_x: f32);

    /// Calls Dear ImGui's `ImGui::GetColumnsCount` operation through the generated C ABI.
    pub fn ImGui_GetColumnsCount() -> c::Int;

    /// Tab Bars, Tabs
    /// - Note: Tabs are automatically created by the docking system (when in 'docking' branch). Use this to create tab bars/tabs yourself.
    /// create and append into a TabBar
    pub fn ImGui_BeginTabBar(str_id: *const c::Char, flags: types::ImGuiTabBarFlags) -> bool;

    /// only call EndTabBar() if BeginTabBar() returns true!
    pub fn ImGui_EndTabBar();

    /// create a Tab. Returns true if the Tab is selected.
    pub fn ImGui_BeginTabItem(label: *const c::Char, p_open: *mut bool, flags: types::ImGuiTabItemFlags) -> bool;

    /// only call EndTabItem() if BeginTabItem() returns true!
    pub fn ImGui_EndTabItem();

    /// create a Tab behaving like a button. return true when clicked. cannot be selected in the tab bar.
    pub fn ImGui_TabItemButton(label: *const c::Char, flags: types::ImGuiTabItemFlags) -> bool;

    /// notify TabBar or Docking system of a closed tab/window ahead (useful to reduce visual flicker on reorderable tab bars). For tab-bar: call after BeginTabBar() and before Tab submissions. Otherwise call with a window name.
    pub fn ImGui_SetTabItemClosed(tab_or_docked_window_label: *const c::Char);

    /// Logging/Capture
    /// - All text output from the interface can be captured into tty/file/clipboard. By default, tree nodes are automatically opened during logging.
    /// start logging to tty (stdout)
    pub fn ImGui_LogToTTY(auto_open_depth: c::Int);

    /// start logging to file
    pub fn ImGui_LogToFile(auto_open_depth: c::Int, filename: *const c::Char);

    /// start logging to OS clipboard
    pub fn ImGui_LogToClipboard(auto_open_depth: c::Int);

    /// stop logging (close file, etc.)
    pub fn ImGui_LogFinish();

    /// helper to display buttons for logging to tty/file/clipboard
    pub fn ImGui_LogButtons();

    /// pass text data straight to log (without being displayed)
    pub fn ImGui_LogTextUnformatted(text: *const c::Char);

    /// Calls Dear ImGui's `ImGui::LogTextV` operation through the generated C ABI.
    pub fn ImGui_LogTextV(fmt: *const c::Char, args: *mut ());

    /// Drag and Drop
    /// - On source items, call BeginDragDropSource(), if it returns true also call SetDragDropPayload() + EndDragDropSource().
    /// - On target candidates, call BeginDragDropTarget(), if it returns true also call AcceptDragDropPayload() + EndDragDropTarget().
    /// - If you stop calling BeginDragDropSource() the payload is preserved however it won't have a preview tooltip (we currently display a fallback "..." tooltip, see #1725)
    /// - An item can be both drag source and drop target.
    /// call after submitting an item which may be dragged. when this return true, you can call SetDragDropPayload() + EndDragDropSource()
    pub fn ImGui_BeginDragDropSource(flags: types::ImGuiDragDropFlags) -> bool;

    /// type is a user defined string of maximum 32 characters. Strings starting with '_' are reserved for dear imgui internal types. Data is copied and held by imgui. Return true when payload has been accepted.
    pub fn ImGui_SetDragDropPayload(type_value: *const c::Char, data: *const (), sz: usize, cond: types::ImGuiCond) -> bool;

    /// only call EndDragDropSource() if BeginDragDropSource() returns true!
    pub fn ImGui_EndDragDropSource();

    /// call after submitting an item that may receive a payload. If this returns true, you can call AcceptDragDropPayload() + EndDragDropTarget()
    pub fn ImGui_BeginDragDropTarget() -> bool;

    /// accept contents of a given type. If ImGuiDragDropFlags_AcceptBeforeDelivery is set you can peek into the payload before the mouse button is released.
    pub fn ImGui_AcceptDragDropPayload(type_value: *const c::Char, flags: types::ImGuiDragDropFlags) -> *const types::ImGuiPayload;

    /// only call EndDragDropTarget() if BeginDragDropTarget() returns true!
    pub fn ImGui_EndDragDropTarget();

    /// peek directly into the current payload from anywhere. returns NULL when drag and drop is finished or inactive. use ImGuiPayload::IsDataType() to test for the payload type.
    pub fn ImGui_GetDragDropPayload() -> *const types::ImGuiPayload;

    /// Disabling [BETA API]
    /// - Disable all user interactions and dim items visuals (applying style.DisabledAlpha over current colors)
    /// - Those can be nested but it cannot be used to enable an already disabled section (a single BeginDisabled(true) in the stack is enough to keep everything disabled)
    /// - Tooltips windows are automatically opted out of disabling. Note that IsItemHovered() by default returns false on disabled items, unless using ImGuiHoveredFlags_AllowWhenDisabled.
    /// - BeginDisabled(false)/EndDisabled() essentially does nothing but is provided to facilitate use of boolean expressions (as a micro-optimization: if you have tens of thousands of BeginDisabled(false)/EndDisabled() pairs, you might want to reformulate your code to avoid making those calls)
    pub fn ImGui_BeginDisabled(disabled: bool);

    /// Calls Dear ImGui's `ImGui::EndDisabled` operation through the generated C ABI.
    pub fn ImGui_EndDisabled();

    /// Clipping
    /// - Mouse hovering is affected by ImGui::PushClipRect() calls, unlike direct calls to ImDrawList::PushClipRect() which are render only.
    pub fn ImGui_PushClipRect(clip_rect_min: types::ImVec2, clip_rect_max: types::ImVec2, intersect_with_current_clip_rect: bool);

    /// Calls Dear ImGui's `ImGui::PopClipRect` operation through the generated C ABI.
    pub fn ImGui_PopClipRect();

    /// Focus, Activation
    /// make last item the default focused item of a newly appearing window.
    pub fn ImGui_SetItemDefaultFocus();

    /// Implied offset = 0
    pub fn ImGui_SetKeyboardFocusHere();

    /// focus keyboard on the next widget. Use positive 'offset' to access sub components of a multiple component widget. Use -1 to access previous widget.
    pub fn ImGui_SetKeyboardFocusHereEx(offset: c::Int);

    /// Keyboard/Gamepad Navigation
    /// alter visibility of keyboard/gamepad cursor. by default: show when using an arrow key, hide when clicking with mouse.
    pub fn ImGui_SetNavCursorVisible(visible: bool);

    /// Overlapping mode
    /// allow next item to be overlapped by a subsequent item. Typically useful with InvisibleButton(), Selectable(), TreeNode() covering an area where subsequent items may need to be added. Note that both Selectable() and TreeNode() have dedicated flags doing this.
    pub fn ImGui_SetNextItemAllowOverlap();

    /// Item/Widgets Utilities and Query Functions
    /// - Most of the functions are referring to the previous Item that has been submitted.
    /// - See Demo Window under "Widgets->Querying Status" for an interactive visualization of most of those functions.
    /// is the last item hovered? (and usable, aka not blocked by a popup, etc.). See ImGuiHoveredFlags for more options.
    pub fn ImGui_IsItemHovered(flags: types::ImGuiHoveredFlags) -> bool;

    /// is the last item active? (e.g. button being held, text field being edited. This will continuously return true while holding mouse button on an item. Items that don't interact will always return false)
    pub fn ImGui_IsItemActive() -> bool;

    /// is the last item focused for keyboard/gamepad navigation?
    pub fn ImGui_IsItemFocused() -> bool;

    /// Implied mouse_button = 0
    pub fn ImGui_IsItemClicked() -> bool;

    /// is the last item hovered and mouse clicked on? (**)  == IsMouseClicked(mouse_button) && IsItemHovered()Important. (**) this is NOT equivalent to the behavior of e.g. Button(). Read comments in function definition.
    pub fn ImGui_IsItemClickedEx(mouse_button: types::ImGuiMouseButton) -> bool;

    /// is the last item visible? (items may be out of sight because of clipping/scrolling)
    pub fn ImGui_IsItemVisible() -> bool;

    /// did the last item modify its underlying value this frame? or was pressed? This is generally the same as the "bool" return value of many widgets.
    pub fn ImGui_IsItemEdited() -> bool;

    /// was the last item just made active (item was previously inactive).
    pub fn ImGui_IsItemActivated() -> bool;

    /// was the last item just made inactive (item was previously active). Useful for Undo/Redo patterns with widgets that require continuous editing.
    pub fn ImGui_IsItemDeactivated() -> bool;

    /// was the last item just made inactive and made a value change when it was active? (e.g. Slider/Drag moved). Useful for Undo/Redo patterns with widgets that require continuous editing. Note that you may get false positives (some widgets such as Combo()/ListBox()/Selectable() will return true even when clicking an already selected item).
    pub fn ImGui_IsItemDeactivatedAfterEdit() -> bool;

    /// was the last item open state toggled? set by TreeNode().
    pub fn ImGui_IsItemToggledOpen() -> bool;

    /// is any item hovered?
    pub fn ImGui_IsAnyItemHovered() -> bool;

    /// is any item active?
    pub fn ImGui_IsAnyItemActive() -> bool;

    /// is any item focused?
    pub fn ImGui_IsAnyItemFocused() -> bool;

    /// get ID of last item (~~ often same ImGui::GetID(label) beforehand)
    pub fn ImGui_GetItemID() -> types::ImGuiID;

    /// get upper-left bounding rectangle of the last item (screen space)
    pub fn ImGui_GetItemRectMin() -> types::ImVec2;

    /// get lower-right bounding rectangle of the last item (screen space)
    pub fn ImGui_GetItemRectMax() -> types::ImVec2;

    /// get size of last item
    pub fn ImGui_GetItemRectSize() -> types::ImVec2;

    /// get generic flags of last item
    pub fn ImGui_GetItemFlags() -> types::ImGuiItemFlags;

    /// Viewports
    /// - Currently represents the Platform Window created by the application which is hosting our Dear ImGui windows.
    /// - In 'docking' branch with multi-viewport enabled, we extend this concept to have multiple active viewports.
    /// - In the future we will extend this concept further to also represent Platform Monitor and support a "no main platform window" operation mode.
    /// return primary/default viewport. This can never be NULL.
    pub fn ImGui_GetMainViewport() -> *mut types::ImGuiViewport;

    /// Background/Foreground Draw Lists
    /// this draw list will be the first rendered one. Useful to quickly draw shapes/text behind dear imgui contents.
    pub fn ImGui_GetBackgroundDrawList() -> *mut types::ImDrawList;

    /// this draw list will be the last rendered one. Useful to quickly draw shapes/text over dear imgui contents.
    pub fn ImGui_GetForegroundDrawList() -> *mut types::ImDrawList;

    /// Miscellaneous Utilities
    /// test if rectangle (of given size, starting from cursor position) is visible / not clipped.
    pub fn ImGui_IsRectVisibleBySize(size: types::ImVec2) -> bool;

    /// test if rectangle (in screen space) is visible / not clipped. to perform coarse clipping on user's side.
    pub fn ImGui_IsRectVisible(rect_min: types::ImVec2, rect_max: types::ImVec2) -> bool;

    /// get global imgui time. incremented by io.DeltaTime every frame.
    pub fn ImGui_GetTime() -> f64;

    /// get global imgui frame count. incremented by 1 every frame.
    pub fn ImGui_GetFrameCount() -> c::Int;

    /// you may use this when creating your own ImDrawList instances.
    pub fn ImGui_GetDrawListSharedData() -> *mut types::ImDrawListSharedData;

    /// get a string corresponding to the enum value (for display, saving, etc.).
    pub fn ImGui_GetStyleColorName(idx: types::ImGuiCol) -> *const c::Char;

    /// replace current window storage with our own (if you want to manipulate it yourself, typically clear subsection of it)
    pub fn ImGui_SetStateStorage(storage: *mut types::ImGuiStorage);

    /// Calls Dear ImGui's `ImGui::GetStateStorage` operation through the generated C ABI.
    pub fn ImGui_GetStateStorage() -> *mut types::ImGuiStorage;

    /// Text Utilities
    /// Implied text_end = NULL, hide_text_after_double_hash = false, wrap_width = -1.0f
    pub fn ImGui_CalcTextSize(text: *const c::Char) -> types::ImVec2;

    /// Calls Dear ImGui's `ImGui::CalcTextSize` operation through the generated C ABI.
    pub fn ImGui_CalcTextSizeEx(text: *const c::Char, text_end: *const c::Char, hide_text_after_double_hash: bool, wrap_width: f32) -> types::ImVec2;

    /// Color Utilities
    pub fn ImGui_ColorConvertU32ToFloat4(in_value: types::ImU32) -> types::ImVec4;

    /// Calls Dear ImGui's `ImGui::ColorConvertFloat4ToU32` operation through the generated C ABI.
    pub fn ImGui_ColorConvertFloat4ToU32(in_value: types::ImVec4) -> types::ImU32;

    /// Calls Dear ImGui's `ImGui::ColorConvertRGBtoHSV` operation through the generated C ABI.
    pub fn ImGui_ColorConvertRGBtoHSV(r: f32, g: f32, b: f32, out_h: *mut f32, out_s: *mut f32, out_v: *mut f32);

    /// Calls Dear ImGui's `ImGui::ColorConvertHSVtoRGB` operation through the generated C ABI.
    pub fn ImGui_ColorConvertHSVtoRGB(h: f32, s: f32, v: f32, out_r: *mut f32, out_g: *mut f32, out_b: *mut f32);

    /// Inputs Utilities: Raw Keyboard/Mouse/Gamepad Access
    /// - Consider using the Shortcut() function instead of IsKeyPressed()/IsKeyChordPressed()! Shortcut() is easier to use and better featured (can do focus routing check).
    /// - the ImGuiKey enum contains all possible keyboard, mouse and gamepad inputs (e.g. ImGuiKey_A, ImGuiKey_MouseLeft, ImGuiKey_GamepadDpadUp...).
    /// - (legacy: before v1.87 (2022-02), we used ImGuiKey < 512 values to carry native/user indices as defined by each backends. This was obsoleted in 1.87 (2022-02) and completely removed in 1.91.5 (2024-11). See https://github.com/ocornut/imgui/issues/4921)
    /// is key being held.
    pub fn ImGui_IsKeyDown(key: types::ImGuiKey) -> bool;

    /// Implied repeat = true
    pub fn ImGui_IsKeyPressed(key: types::ImGuiKey) -> bool;

    /// was key pressed (went from !Down to Down)? Repeat rate uses io.KeyRepeatDelay / KeyRepeatRate.
    pub fn ImGui_IsKeyPressedEx(key: types::ImGuiKey, repeat: bool) -> bool;

    /// was key released (went from Down to !Down)?
    pub fn ImGui_IsKeyReleased(key: types::ImGuiKey) -> bool;

    /// was key chord (mods + key) pressed, e.g. you can pass 'ImGuiMod_Ctrl | ImGuiKey_S' as a key-chord. This doesn't do any routing or focus check, please consider using Shortcut() function instead.
    pub fn ImGui_IsKeyChordPressed(key_chord: types::ImGuiKeyChord) -> bool;

    /// uses provided repeat rate/delay. return a count, most often 0 or 1 but might be >1 if RepeatRate is small enough that DeltaTime > RepeatRate
    pub fn ImGui_GetKeyPressedAmount(key: types::ImGuiKey, repeat_delay: f32, rate: f32) -> c::Int;

    /// [DEBUG] returns English name of the key. Those names are provided for debugging purpose and are not meant to be saved persistently nor compared.
    pub fn ImGui_GetKeyName(key: types::ImGuiKey) -> *const c::Char;

    /// Override io.WantCaptureKeyboard flag next frame (said flag is left for your application to handle, typically when true it instructs your app to ignore inputs). e.g. force capture keyboard when your widget is being hovered. This is equivalent to setting "io.WantCaptureKeyboard = want_capture_keyboard"; after the next NewFrame() call.
    pub fn ImGui_SetNextFrameWantCaptureKeyboard(want_capture_keyboard: bool);

    /// Inputs Utilities: Shortcut Testing & Routing
    /// - Typical use is e.g.: 'if (ImGui::Shortcut(ImGuiMod_Ctrl | ImGuiKey_S)) { ... }'.
    /// - Flags: Default route use ImGuiInputFlags_RouteFocused, but see ImGuiInputFlags_RouteGlobal and other options in ImGuiInputFlags_!
    /// - Flags: Use ImGuiInputFlags_Repeat to support repeat.
    /// - ImGuiKeyChord = a ImGuiKey + optional ImGuiMod_Alt/ImGuiMod_Ctrl/ImGuiMod_Shift/ImGuiMod_Super.
    /// ImGuiKey_C                          // Accepted by functions taking ImGuiKey or ImGuiKeyChord arguments
    /// ImGuiMod_Ctrl | ImGuiKey_C          // Accepted by functions taking ImGuiKeyChord arguments
    /// only ImGuiMod_XXX values are legal to combine with an ImGuiKey. You CANNOT combine two ImGuiKey values.
    /// - The general idea is that several callers may register interest in a shortcut, and only one owner gets it.
    /// Parent   -> call Shortcut(Ctrl+S)    // When Parent is focused, Parent gets the shortcut.
    /// Child1 -> call Shortcut(Ctrl+S)    // When Child1 is focused, Child1 gets the shortcut (Child1 overrides Parent shortcuts)
    /// Child2 -> no call                  // When Child2 is focused, Parent gets the shortcut.
    /// The whole system is order independent, so if Child1 makes its calls before Parent, results will be identical.
    /// This is an important property as it facilitate working with foreign code or larger codebase.
    /// - To understand the difference:
    /// - IsKeyChordPressed() compares mods and call IsKeyPressed()
    /// -> the function has no side-effect.
    /// - Shortcut() submits a route, routes are resolved, if it currently can be routed it calls IsKeyChordPressed()
    /// -> the function has (desirable) side-effects as it can prevents another call from getting the route.
    /// - Visualize registered routes in 'Metrics/Debugger->Inputs'.
    pub fn ImGui_Shortcut(key_chord: types::ImGuiKeyChord, flags: types::ImGuiInputFlags) -> bool;

    /// Calls Dear ImGui's `ImGui::SetNextItemShortcut` operation through the generated C ABI.
    pub fn ImGui_SetNextItemShortcut(key_chord: types::ImGuiKeyChord, flags: types::ImGuiInputFlags);

    /// Inputs Utilities: Key/Input Ownership [BETA]
    /// - One common use case would be to allow your items to disable standard inputs behaviors such
    /// as Tab or Alt key handling, Mouse Wheel scrolling, etc.
    /// e.g. `Button(...); if (SetItemKeyOwner(ImGuiKey_MouseWheelY)) { ... }` to make hovering/activating a button disable wheel for scrolling.
    /// - Reminder ImGuiKey enum include access to mouse buttons and gamepad, so key ownership can apply to them.
    /// - The return value of SetItemKeyOwner() says if ownership has been requested for the item, which is a shortcut to calling yet non-public TestKeyOwner() function.
    /// - Many related features are still in imgui_internal.h. For instance, most IsKeyXXX()/IsMouseXXX() functions have an owner-id-aware version.
    /// Set key owner to last item ID if it is hovered or active. Return true when ownership has been set. Roughly equivalent to 'if (TestKeyOwner(key, GetItemID()) && (IsItemHovered() || IsItemActive())) { SetKeyOwner(key, GetItemID());'.
    pub fn ImGui_SetItemKeyOwner(key: types::ImGuiKey) -> bool;

    /// Inputs Utilities: Mouse
    /// - To refer to a mouse button, you may use named enums in your code e.g. ImGuiMouseButton_Left, ImGuiMouseButton_Right.
    /// - You can also use regular integer: it is forever guaranteed that 0=Left, 1=Right, 2=Middle.
    /// - Dragging operations are only reported after mouse has moved a certain distance away from the initial clicking position (see 'lock_threshold' and 'io.MouseDraggingThreshold')
    /// is mouse button held?
    pub fn ImGui_IsMouseDown(button: types::ImGuiMouseButton) -> bool;

    /// Implied repeat = false
    pub fn ImGui_IsMouseClicked(button: types::ImGuiMouseButton) -> bool;

    /// did mouse button clicked? (went from !Down to Down). Same as GetMouseClickedCount() == 1.
    pub fn ImGui_IsMouseClickedEx(button: types::ImGuiMouseButton, repeat: bool) -> bool;

    /// did mouse button released? (went from Down to !Down)
    pub fn ImGui_IsMouseReleased(button: types::ImGuiMouseButton) -> bool;

    /// did mouse button double-clicked? Same as GetMouseClickedCount() == 2. (note that a double-click will also report IsMouseClicked() == true)
    pub fn ImGui_IsMouseDoubleClicked(button: types::ImGuiMouseButton) -> bool;

    /// delayed mouse release (use very sparingly!). Generally used with 'delay >= io.MouseDoubleClickTime' + combined with a 'io.MouseClickedLastCount==1' test. This is a very rarely used UI idiom, but some apps use this: e.g. MS Explorer single click on an icon to rename.
    pub fn ImGui_IsMouseReleasedWithDelay(button: types::ImGuiMouseButton, delay: f32) -> bool;

    /// return the number of successive mouse-clicks at the time where a click happen (otherwise 0).
    pub fn ImGui_GetMouseClickedCount(button: types::ImGuiMouseButton) -> c::Int;

    /// Implied clip = true
    pub fn ImGui_IsMouseHoveringRect(r_min: types::ImVec2, r_max: types::ImVec2) -> bool;

    /// is mouse hovering given bounding rect (in screen space). clipped by current clipping settings, but disregarding of other consideration of focus/window ordering/popup-block.
    pub fn ImGui_IsMouseHoveringRectEx(r_min: types::ImVec2, r_max: types::ImVec2, clip: bool) -> bool;

    /// by convention we use (-FLT_MAX,-FLT_MAX) to denote that there is no mouse available
    pub fn ImGui_IsMousePosValid(mouse_pos: *const types::ImVec2) -> bool;

    /// [WILL OBSOLETE] is any mouse button held? This was designed for backends, but prefer having backend maintain a mask of held mouse buttons, because upcoming input queue system will make this invalid.
    pub fn ImGui_IsAnyMouseDown() -> bool;

    /// shortcut to ImGui::GetIO().MousePos provided by user, to be consistent with other calls
    pub fn ImGui_GetMousePos() -> types::ImVec2;

    /// retrieve mouse position at the time of opening popup we have BeginPopup() into (helper to avoid user backing that value themselves)
    pub fn ImGui_GetMousePosOnOpeningCurrentPopup() -> types::ImVec2;

    /// is mouse dragging? (uses io.MouseDraggingThreshold if lock_threshold < 0.0f)
    pub fn ImGui_IsMouseDragging(button: types::ImGuiMouseButton, lock_threshold: f32) -> bool;

    /// return the delta from the initial clicking position while the mouse button is pressed or was just released. This is locked and return 0.0f until the mouse moves past a distance threshold at least once (uses io.MouseDraggingThreshold if lock_threshold < 0.0f)
    pub fn ImGui_GetMouseDragDelta(button: types::ImGuiMouseButton, lock_threshold: f32) -> types::ImVec2;

    /// Implied button = 0
    pub fn ImGui_ResetMouseDragDelta();

    /// Calls Dear ImGui's `ImGui::ResetMouseDragDelta` operation through the generated C ABI.
    pub fn ImGui_ResetMouseDragDeltaEx(button: types::ImGuiMouseButton);

    /// get desired mouse cursor shape. Important: reset in ImGui::NewFrame(), this is updated during the frame. valid before Render(). If you use software rendering by setting io.MouseDrawCursor ImGui will render those for you
    pub fn ImGui_GetMouseCursor() -> types::ImGuiMouseCursor;

    /// set desired mouse cursor shape
    pub fn ImGui_SetMouseCursor(cursor_type: types::ImGuiMouseCursor);

    /// Override io.WantCaptureMouse flag next frame (said flag is left for your application to handle, typical when true it instructs your app to ignore inputs). This is equivalent to setting "io.WantCaptureMouse = want_capture_mouse;" after the next NewFrame() call.
    pub fn ImGui_SetNextFrameWantCaptureMouse(want_capture_mouse: bool);

    /// Clipboard Utilities
    /// - Also see the LogToClipboard() function to capture GUI into clipboard, or easily output text data to the clipboard.
    pub fn ImGui_GetClipboardText() -> *const c::Char;

    /// Calls Dear ImGui's `ImGui::SetClipboardText` operation through the generated C ABI.
    pub fn ImGui_SetClipboardText(text: *const c::Char);

    /// Settings/.Ini Utilities
    /// - The disk functions are automatically called if io.IniFilename != NULL (default is "imgui.ini").
    /// - Set io.IniFilename to NULL to load/save manually. Read io.WantSaveIniSettings description about handling .ini saving manually.
    /// - Important: default value "imgui.ini" is relative to current working dir! Most apps will want to lock this to an absolute path (e.g. same path as executables).
    /// call after CreateContext() and before the first call to NewFrame(). NewFrame() automatically calls LoadIniSettingsFromDisk(io.IniFilename).
    pub fn ImGui_LoadIniSettingsFromDisk(ini_filename: *const c::Char);

    /// call after CreateContext() and before the first call to NewFrame() to provide .ini data from your own data source.
    pub fn ImGui_LoadIniSettingsFromMemory(ini_data: *const c::Char, ini_size: usize);

    /// this is automatically called (if io.IniFilename is not empty) a few seconds after any modification that should be reflected in the .ini file (and also by DestroyContext).
    pub fn ImGui_SaveIniSettingsToDisk(ini_filename: *const c::Char);

    /// return a zero-terminated string with the .ini data which you can save by your own mean. call when io.WantSaveIniSettings is set, then save data by your own mean and clear io.WantSaveIniSettings.
    pub fn ImGui_SaveIniSettingsToMemory(out_ini_size: *mut usize) -> *const c::Char;

