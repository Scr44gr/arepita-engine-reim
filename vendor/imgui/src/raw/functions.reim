    /// Note: Transfer ownership of 'ttf_data' to ImFontAtlas! Will be deleted after destruction of the atlas. Set font_cfg->FontDataOwnedByAtlas=false to keep ownership of your data and it won't be freed.
    pub fn ImFontAtlas_AddFontFromMemoryTTF(self_value: *mut types::ImFontAtlas, font_data: *mut (), font_data_size: c::Int, size_pixels: f32, font_cfg: *const types::ImFontConfig, glyph_ranges: *const types::ImWchar) -> *mut types::ImFont;

    /// 'compressed_font_data' still owned by caller. Compress with binary_to_compressed_c.cpp.
    pub fn ImFontAtlas_AddFontFromMemoryCompressedTTF(self_value: *mut types::ImFontAtlas, compressed_font_data: *const (), compressed_font_data_size: c::Int, size_pixels: f32, font_cfg: *const types::ImFontConfig, glyph_ranges: *const types::ImWchar) -> *mut types::ImFont;

    /// 'compressed_font_data_base85' still owned by caller. Compress with binary_to_compressed_c.cpp with -base85 parameter.
    pub fn ImFontAtlas_AddFontFromMemoryCompressedBase85TTF(self_value: *mut types::ImFontAtlas, compressed_font_data_base85: *const c::Char, size_pixels: f32, font_cfg: *const types::ImFontConfig, glyph_ranges: *const types::ImWchar) -> *mut types::ImFont;

    /// Calls Dear ImGui's `RemoveFont` operation through the generated C ABI.
    pub fn ImFontAtlas_RemoveFont(self_value: *mut types::ImFontAtlas, font: *mut types::ImFont);

    /// Clear everything (fonts + textures). Don't call mid-frame!
    pub fn ImFontAtlas_Clear(self_value: *mut types::ImFontAtlas);

    /// Clear input+output font data/glyphs. You can call this mid-frame if you load new fonts afterwards!
    pub fn ImFontAtlas_ClearFonts(self_value: *mut types::ImFontAtlas);

    /// Compact cached glyphs and texture.
    pub fn ImFontAtlas_CompactCache(self_value: *mut types::ImFontAtlas);

    /// Change font loader at runtime.
    pub fn ImFontAtlas_SetFontLoader(self_value: *mut types::ImFontAtlas, font_loader: *const types::ImFontLoader);

    /// As we are transitioning toward a new font system, we expect to obsolete those soon:
    /// [OBSOLETE] Clear input data (all ImFontConfig structures including sizes, TTF data, glyph ranges, etc.) = all the data used to build the texture and fonts.
    pub fn ImFontAtlas_ClearInputData(self_value: *mut types::ImFontAtlas);

    /// [OBSOLETE] Clear CPU-side copy of the texture data. Saves RAM once the texture has been copied to graphics memory.
    pub fn ImFontAtlas_ClearTexData(self_value: *mut types::ImFontAtlas);

    /// Legacy path for build atlas + retrieving pixel data.
    /// - User is in charge of copying the pixels into graphics memory (e.g. create a texture with your engine). Then store your texture handle with SetTexID().
    /// - The pitch is always = Width * BytesPerPixels (1 or 4)
    /// - Building in RGBA32 format is provided for convenience and compatibility, but note that unless you manually manipulate or copy color data into
    /// the texture (e.g. when using the AddCustomRect*** api), then the RGB pixels emitted will always be white (~75% of memory/bandwidth waste).
    /// - From 1.92 with backends supporting ImGuiBackendFlags_RendererHasTextures:
    /// - Calling Build(), GetTexDataAsAlpha8(), GetTexDataAsRGBA32() is not needed.
    /// - In backend: replace calls to ImFontAtlas::SetTexID() with calls to ImTextureData::SetTexID() after honoring texture creation.
    /// Build pixels data. This is called automatically for you by the GetTexData*** functions.
    pub fn ImFontAtlas_Build(self_value: *mut types::ImFontAtlas) -> bool;

    /// 1 byte per-pixel
    pub fn ImFontAtlas_GetTexDataAsAlpha8(self_value: *mut types::ImFontAtlas, out_pixels: *mut *mut u8, out_width: *mut c::Int, out_height: *mut c::Int, out_bytes_per_pixel: *mut c::Int);

    /// 4 bytes-per-pixel
    pub fn ImFontAtlas_GetTexDataAsRGBA32(self_value: *mut types::ImFontAtlas, out_pixels: *mut *mut u8, out_width: *mut c::Int, out_height: *mut c::Int, out_bytes_per_pixel: *mut c::Int);

    /// Called by legacy backends. May be called before texture creation.
    pub fn ImFontAtlas_SetTexID(self_value: *mut types::ImFontAtlas, id: types::ImTextureID);

    /// Called by legacy backends.
    pub fn ImFontAtlas_SetTexIDImTextureRef(self_value: *mut types::ImFontAtlas, id: types::ImTextureRef);

    /// Bit ambiguous: used to detect when user didn't build texture but effectively we should check TexID != 0 except that would be backend dependent..
    pub fn ImFontAtlas_IsBuilt(self_value: *const types::ImFontAtlas) -> bool;

    /// Since 1.92: specifying glyph ranges is only useful/necessary if your backend doesn't support ImGuiBackendFlags_RendererHasTextures!
    /// Basic Latin, Extended Latin
    pub fn ImFontAtlas_GetGlyphRangesDefault(self_value: *mut types::ImFontAtlas) -> *const types::ImWchar;

    /// Helpers to retrieve list of common Unicode ranges (2 value per range, values are inclusive, zero-terminated list)
    /// NB: Make sure that your string are UTF-8 and NOT in your local code page.
    /// Read https://github.com/ocornut/imgui/blob/master/docs/FONTS.md/#about-utf-8-encoding for details.
    /// NB: Consider using ImFontGlyphRangesBuilder to build glyph ranges from textual data.
    /// Default + Greek and Coptic
    pub fn ImFontAtlas_GetGlyphRangesGreek(self_value: *mut types::ImFontAtlas) -> *const types::ImWchar;

    /// Default + Korean characters
    pub fn ImFontAtlas_GetGlyphRangesKorean(self_value: *mut types::ImFontAtlas) -> *const types::ImWchar;

    /// Default + Hiragana, Katakana, Half-Width, Selection of 2999 Ideographs
    pub fn ImFontAtlas_GetGlyphRangesJapanese(self_value: *mut types::ImFontAtlas) -> *const types::ImWchar;

    /// Default + Half-Width + Japanese Hiragana/Katakana + full set of about 21000 CJK Unified Ideographs
    pub fn ImFontAtlas_GetGlyphRangesChineseFull(self_value: *mut types::ImFontAtlas) -> *const types::ImWchar;

    /// Default + Half-Width + Japanese Hiragana/Katakana + set of 2500 CJK Unified Ideographs for common simplified Chinese
    pub fn ImFontAtlas_GetGlyphRangesChineseSimplifiedCommon(self_value: *mut types::ImFontAtlas) -> *const types::ImWchar;

    /// Default + about 400 Cyrillic characters
    pub fn ImFontAtlas_GetGlyphRangesCyrillic(self_value: *mut types::ImFontAtlas) -> *const types::ImWchar;

    /// Default + Thai characters
    pub fn ImFontAtlas_GetGlyphRangesThai(self_value: *mut types::ImFontAtlas) -> *const types::ImWchar;

    /// Default + Vietnamese characters
    pub fn ImFontAtlas_GetGlyphRangesVietnamese(self_value: *mut types::ImFontAtlas) -> *const types::ImWchar;

    /// Register and retrieve custom rectangles
    /// - You can request arbitrary rectangles to be packed into the atlas, for your own purpose.
    /// - Since 1.92.0, packing is done immediately in the function call (previously packing was done during the Build call)
    /// - You can render your pixels into the texture right after calling the AddCustomRect() functions.
    /// - VERY IMPORTANT:
    /// - Texture may be created/resized at any time when calling ImGui or ImFontAtlas functions.
    /// - IT WILL INVALIDATE RECTANGLE DATA SUCH AS UV COORDINATES. Always use latest values from GetCustomRect().
    /// - UV coordinates are associated to the current texture identifier aka 'atlas->TexRef'. Both TexRef and UV coordinates are typically changed at the same time.
    /// - If you render colored output into your custom rectangles: set 'atlas->TexPixelsUseColors = true' as this may help some backends decide of preferred texture format.
    /// - Read docs/FONTS.md for more details about using colorful icons.
    /// - Note: this API may be reworked further in order to facilitate supporting e.g. multi-monitor, varying DPI settings.
    /// - (Pre-1.92 names) ------------> (1.92 names)
    /// - GetCustomRectByIndex()   --> Use GetCustomRect()
    /// - CalcCustomRectUV()       --> Use GetCustomRect() and read uv0, uv1 fields.
    /// - AddCustomRectRegular()   --> Renamed to AddCustomRect()
    /// - AddCustomRectFontGlyph() --> Prefer using custom ImFontLoader inside ImFontConfig
    /// - ImFontAtlasCustomRect    --> Renamed to ImFontAtlasRect
    /// Register a rectangle. Return -1 (ImFontAtlasRectId_Invalid) on error.
    pub fn ImFontAtlas_AddCustomRect(self_value: *mut types::ImFontAtlas, width: c::Int, height: c::Int, out_r: *mut types::ImFontAtlasRect) -> types::ImFontAtlasRectId;

    /// Unregister a rectangle. Existing pixels will stay in texture until resized / garbage collected.
    pub fn ImFontAtlas_RemoveCustomRect(self_value: *mut types::ImFontAtlas, id: types::ImFontAtlasRectId);

    /// Get rectangle coordinates for current texture. Valid immediately, never store this (read above)!
    pub fn ImFontAtlas_GetCustomRect(self_value: *const types::ImFontAtlas, id: types::ImFontAtlasRectId, out_r: *mut types::ImFontAtlasRect) -> bool;

    /// RENAMED in 1.92.0
    pub fn ImFontAtlas_AddCustomRectRegular(self_value: *mut types::ImFontAtlas, w: c::Int, h: c::Int) -> types::ImFontAtlasRectId;

    /// OBSOLETED in 1.92.0
    pub fn ImFontAtlas_GetCustomRectByIndex(self_value: *mut types::ImFontAtlas, id: types::ImFontAtlasRectId) -> *const types::ImFontAtlasRect;

    /// OBSOLETED in 1.92.0
    pub fn ImFontAtlas_CalcCustomRectUV(self_value: *const types::ImFontAtlas, r: *const types::ImFontAtlasRect, out_uv_min: *mut types::ImVec2, out_uv_max: *mut types::ImVec2);

    /// OBSOLETED in 1.92.0: Use custom ImFontLoader in ImFontConfig
    pub fn ImFontAtlas_AddCustomRectFontGlyph(self_value: *mut types::ImFontAtlas, font: *mut types::ImFont, codepoint: types::ImWchar, w: c::Int, h: c::Int, advance_x: f32, offset: types::ImVec2) -> types::ImFontAtlasRectId;

    /// ADDED AND OBSOLETED in 1.92.0
    pub fn ImFontAtlas_AddCustomRectFontGlyphForSize(self_value: *mut types::ImFontAtlas, font: *mut types::ImFont, font_size: f32, codepoint: types::ImWchar, w: c::Int, h: c::Int, advance_x: f32, offset: types::ImVec2) -> types::ImFontAtlasRectId;

