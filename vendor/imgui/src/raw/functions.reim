    pub fn ImGui_ImageButtonEx(str_id: *const c::Char, tex_ref: types::ImTextureRef, image_size: types::ImVec2, uv0: types::ImVec2, uv1: types::ImVec2, bg_col: types::ImVec4, tint_col: types::ImVec4) -> bool;

    /// Widgets: Combo Box (Dropdown)
    /// - The BeginCombo()/EndCombo() api allows you to manage your contents and selection state however you want it, by creating e.g. Selectable() items.
