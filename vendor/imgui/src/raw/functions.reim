    /// Calls Dear ImGui's `ImGui::ListBox` operation through the generated C ABI.
    pub fn ImGui_ListBoxCallbackEx(label: *const c::Char, current_item: *mut c::Int, getter: *mut fn(*mut (), c::Int) -> *const c::Char, user_data: *mut (), items_count: c::Int, height_in_items: c::Int) -> bool;

