    /// ID stack/scopes
    /// Read the FAQ (docs/FAQ.md or http://dearimgui.com/faq) for more details about how ID are handled in dear imgui.
    /// - Those questions are answered and impacted by understanding of the ID stack system:
    /// - "Q: Why is my widget not reacting when I click on it?"
    /// - "Q: How can I have widgets with an empty label?"
    /// - "Q: How can I have multiple widgets with the same label?"
    /// - Short version: ID are hashes of the entire ID stack. If you are creating widgets in a loop you most likely
    /// want to push a unique identifier (e.g. object pointer, loop index) to uniquely differentiate them.
    /// - You can also use the "Label##foobar" syntax within widget label to distinguish them from each others.
    /// - In this header file we use the "label"/"name" terminology to denote a string that will be displayed + used as an ID,
    /// whereas "str_id" denote a string that is only used as an ID and not normally displayed.
    /// push string into the ID stack (will hash string).
    pub fn ImGui_PushID(str_id: *const c::Char);

    /// push string into the ID stack (will hash string).
    pub fn ImGui_PushIDStr(str_id_begin: *const c::Char, str_id_end: *const c::Char);

    /// push pointer into the ID stack (will hash pointer).
    pub fn ImGui_PushIDPtr(ptr_id: *const ());

    /// push integer into the ID stack (will hash integer).
    pub fn ImGui_PushIDInt(int_id: c::Int);

    /// pop from the ID stack.
    pub fn ImGui_PopID();

    /// calculate unique ID (hash of whole ID stack + given parameter). e.g. if you want to query into ImGuiStorage yourself
    pub fn ImGui_GetID(str_id: *const c::Char) -> types::ImGuiID;

    /// Calls Dear ImGui's `ImGui::GetID` operation through the generated C ABI.
    pub fn ImGui_GetIDStr(str_id_begin: *const c::Char, str_id_end: *const c::Char) -> types::ImGuiID;

    /// Calls Dear ImGui's `ImGui::GetID` operation through the generated C ABI.
    pub fn ImGui_GetIDPtr(ptr_id: *const ()) -> types::ImGuiID;

    /// Calls Dear ImGui's `ImGui::GetID` operation through the generated C ABI.
    pub fn ImGui_GetIDInt(int_id: c::Int) -> types::ImGuiID;

    /// Widgets: Text
    /// Implied text_end = NULL
    pub fn ImGui_TextUnformatted(text: *const c::Char);

    /// raw text without formatting. Roughly equivalent to Text("%s", text) but: A) doesn't require null terminated string if 'text_end' is specified, B) it's faster, no memory copy is done, no buffer size limits, recommended for long chunks of text.
    pub fn ImGui_TextUnformattedEx(text: *const c::Char, text_end: *const c::Char);

    /// Calls Dear ImGui's `ImGui::TextV` operation through the generated C ABI.
    pub fn ImGui_TextV(fmt: *const c::Char, args: *mut ());

    /// shortcut for PushStyleColor(ImGuiCol_Text, col); Text(fmt, ...); PopStyleColor();
    pub fn ImGui_TextColoredUnformatted(col: types::ImVec4, text: *const c::Char);

    /// Calls Dear ImGui's `ImGui::TextColoredV` operation through the generated C ABI.
    pub fn ImGui_TextColoredV(col: types::ImVec4, fmt: *const c::Char, args: *mut ());

    /// shortcut for PushStyleColor(ImGuiCol_Text, style.Colors[ImGuiCol_TextDisabled]); Text(fmt, ...); PopStyleColor();
    pub fn ImGui_TextDisabledUnformatted(text: *const c::Char);

    /// Calls Dear ImGui's `ImGui::TextDisabledV` operation through the generated C ABI.
    pub fn ImGui_TextDisabledV(fmt: *const c::Char, args: *mut ());

    /// shortcut for PushTextWrapPos(0.0f); Text(fmt, ...); PopTextWrapPos();. Note that this won't work on an auto-resizing window if there's no other widgets to extend the window width, yoy may need to set a size using SetNextWindowSize().
    pub fn ImGui_TextWrappedUnformatted(text: *const c::Char);

    /// Calls Dear ImGui's `ImGui::TextWrappedV` operation through the generated C ABI.
    pub fn ImGui_TextWrappedV(fmt: *const c::Char, args: *mut ());

    /// display text+label aligned the same way as value+label widgets
    pub fn ImGui_LabelTextUnformatted(label: *const c::Char, text: *const c::Char);

    /// Calls Dear ImGui's `ImGui::LabelTextV` operation through the generated C ABI.
    pub fn ImGui_LabelTextV(label: *const c::Char, fmt: *const c::Char, args: *mut ());

    /// shortcut for Bullet()+Text()
    pub fn ImGui_BulletTextUnformatted(text: *const c::Char);

    /// Calls Dear ImGui's `ImGui::BulletTextV` operation through the generated C ABI.
    pub fn ImGui_BulletTextV(fmt: *const c::Char, args: *mut ());

    /// currently: formatted text with a horizontal line
    pub fn ImGui_SeparatorText(label: *const c::Char);

    /// Widgets: Main
    /// - Most widgets return true when the value has been changed or when pressed/selected
    /// - You may also use one of the many IsItemXXX functions (e.g. IsItemActive, IsItemHovered, etc.) to query widget state.
    /// Implied size = ImVec2(0, 0)
    pub fn ImGui_Button(label: *const c::Char) -> bool;

    /// button
    pub fn ImGui_ButtonEx(label: *const c::Char, size: types::ImVec2) -> bool;

    /// button with (FramePadding.y == 0) to easily embed within text
    pub fn ImGui_SmallButton(label: *const c::Char) -> bool;

    /// flexible button behavior without the visuals, frequently useful to build custom behaviors using the public api (along with IsItemActive, IsItemHovered, etc.)
    pub fn ImGui_InvisibleButton(str_id: *const c::Char, size: types::ImVec2, flags: types::ImGuiButtonFlags) -> bool;

    /// square button with an arrow shape
    pub fn ImGui_ArrowButton(str_id: *const c::Char, dir: types::ImGuiDir) -> bool;

    /// Calls Dear ImGui's `ImGui::Checkbox` operation through the generated C ABI.
    pub fn ImGui_Checkbox(label: *const c::Char, v: *mut bool) -> bool;

