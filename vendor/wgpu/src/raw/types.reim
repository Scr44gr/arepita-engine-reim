    /// If set to WGPUPresentMode_Undefined,
    /// [defaults](SentinelValues) to WGPUPresentMode_Fifo.
    ///
    /// The `INIT` macro sets this to WGPUPresentMode_Undefined.
    pub present_mode: WGPUPresentMode,
}

