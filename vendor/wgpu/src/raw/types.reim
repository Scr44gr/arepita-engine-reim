/// Wayland display connection data for WGPUNativeDisplayHandle.
@repr(C)
pub struct WGPUWaylandDisplayHandle {
    /// Pointer to the Wayland display (i.e. wl_display*). Must not be NULL.
    pub display: *mut (),
}

/// Platform display connection, passed as a field of WGPUInstanceExtras.
///
/// This is a tagged union. Set type to indicate which variant is active, then
/// populate the corresponding field in data. Zero-initialization yields
/// WGPUNativeDisplayHandleType_None, meaning no display handle is provided.
///
/// Currently required by the GLES backend when presenting on Wayland. Other
/// backends ignore this field. If the instance is created with a display handle,
/// all surfaces created from it must use the same display connection.
@repr(C)
pub struct WGPUNativeDisplayHandle {
    /// Native `type` field.
    pub type_value: WGPUNativeDisplayHandleType,
    /// Native `xlib` field.
    pub xlib: WGPUXlibDisplayHandle,
    /// Native `xcb` field.
    pub xcb: WGPUXcbDisplayHandle,
    /// Native `wayland` field.
    pub wayland: WGPUWaylandDisplayHandle,
}

/// C-compatible storage for WebGPU's `WGPUInstanceExtras` structure.
@repr(C)
pub struct WGPUInstanceExtras {
    /// Native `chain` field.
    pub chain: WGPUChainedStruct,
    /// Which backends to enable.
    /// Zero (WGPUInstanceBackend_All) enables all backends.
    pub backends: WGPUInstanceBackend,
    /// Flags controlling debug/validation behavior.
    /// See WGPUInstanceFlag for available flags.
    pub flags: WGPUInstanceFlag,
    /// Which DX12 shader compiler to use.
    /// See WGPUDx12Compiler. Ignored on non-DX12 backends.
    pub dx12_shader_compiler: WGPUDx12Compiler,
    /// Which OpenGL ES 3 minor version to request.
    /// See WGPUGles3MinorVersion. Ignored on non-GL backends.
    pub gles3_minor_version: WGPUGles3MinorVersion,
    /// Controls OpenGL fence synchronization behavior.
    /// See WGPUGLFenceBehaviour. Ignored on non-GL backends.
    pub gl_fence_behaviour: WGPUGLFenceBehaviour,
    /// File system path to dxcompiler.dll for dynamic DXC loading.
    /// Only used when dx12ShaderCompiler is WGPUDx12Compiler_Dxc.
    /// An empty/undefined string view means the DLL will be searched for
    /// on the system PATH.
    pub dxc_path: WGPUStringView,
    /// Maximum HLSL shader model version that DXC should target.
    /// See WGPUDxcMaxShaderModel. Only used with the DXC compiler.
    pub dxc_max_shader_model: WGPUDxcMaxShaderModel,
    /// Which DX12 presentation system (swapchain kind) to use.
    /// See WGPUDx12SwapchainKind. Ignored on non-DX12 backends.
    pub dx12_presentation_system: WGPUDx12SwapchainKind,
    /// Native `budgetForDeviceCreation` field.
    pub budget_for_device_creation: *const u8,
    /// Native `budgetForDeviceLoss` field.
    pub budget_for_device_loss: *const u8,
    /// Platform display connection to associate with this instance.
    /// Zero-initialized yields WGPUNativeDisplayHandleType_None (no handle).
    pub display_handle: WGPUNativeDisplayHandle,
}

/// C-compatible storage for WebGPU's `WGPUDeviceExtras` structure.
