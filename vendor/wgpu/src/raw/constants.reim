/// `WGPUGLFenceBehaviour_Normal` value from `WGPUGLFenceBehaviour`.
pub const WGPUGLFenceBehaviour_Normal: types::WGPUGLFenceBehaviour = 0x00000000;
/// Fences are short-circuited to always report completion immediately.
///
/// This solves a specific issue that arose due to a bug in wgpu-core that
/// made many WebGL programs work when they shouldn't have. If you have
/// code that calls wgpuDevicePoll with wait=true on WebGL, you
/// may need to enable this option for "wait" to behave how you expect.
///
/// When this is set, wgpuQueueOnCompletedWorkDone callbacks will fire
/// the next time the device is polled, not when work is actually done on
/// the GPU.
pub const WGPUGLFenceBehaviour_AutoFinish: types::WGPUGLFenceBehaviour = 0x00000001;
/// `WGPUGLFenceBehaviour_Force32` value from `WGPUGLFenceBehaviour`.
pub const WGPUGLFenceBehaviour_Force32: types::WGPUGLFenceBehaviour = 0x7fffffff;

/// `WGPUDx12SwapchainKind_Undefined` value from `WGPUDx12SwapchainKind`.
pub const WGPUDx12SwapchainKind_Undefined: types::WGPUDx12SwapchainKind = 0x00000000;
/// Use a DXGI swapchain created directly from the window's HWND.
///
/// This does not support transparency but has better support from
/// developer tooling such as RenderDoc.
pub const WGPUDx12SwapchainKind_DxgiFromHwnd: types::WGPUDx12SwapchainKind = 0x00000001;
/// Use a DXGI swapchain created from a DirectComposition visual made
/// automatically from the window's HWND.
///
/// This creates a single IDCompositionVisual over the entire window.
/// Supports transparency. If you want to manage the composition tree
/// yourself, create your own device and composition and pass the relevant
/// visual via the surface target.
pub const WGPUDx12SwapchainKind_DxgiFromVisual: types::WGPUDx12SwapchainKind = 0x00000002;
/// `WGPUDx12SwapchainKind_Force32` value from `WGPUDx12SwapchainKind`.
pub const WGPUDx12SwapchainKind_Force32: types::WGPUDx12SwapchainKind = 0x7fffffff;

