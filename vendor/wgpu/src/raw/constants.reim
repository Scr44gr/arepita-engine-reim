pub const WGPUInstanceBackend_Force32: types::WGPUInstanceBackend = 0x7fffffff;

/// No flags set.
pub const WGPUInstanceFlag_Empty: types::WGPUInstanceFlag = 0x00000000;

/// Generate debug information in shaders and objects.
///
/// When using WGPUInstanceFlag_WithEnv, takes value from the
/// WGPU_DEBUG environment variable.
pub const WGPUInstanceFlag_Debug: types::WGPUInstanceFlag = 0x00000001;

/// Enable validation in the backend API, if possible:
///
/// - On the DX12 backend, this calls ID3D12Debug::EnableDebugLayer.
/// - On the Vulkan backend, this enables the Vulkan Validation Layers.
/// - On the GLES backend (Windows), this enables debug output.
/// - On the GLES backend (non-Windows), this calls eglDebugMessageControlKHR.
///
/// When using WGPUInstanceFlag_WithEnv, takes value from the
/// WGPU_VALIDATION environment variable.
pub const WGPUInstanceFlag_Validation: types::WGPUInstanceFlag = 0x00000002;

/// Don't pass labels to the backend API (wgpu-hal).
///
/// When using WGPUInstanceFlag_WithEnv, takes value from the
/// WGPU_DISCARD_HAL_LABELS environment variable.
pub const WGPUInstanceFlag_DiscardHalLabels: types::WGPUInstanceFlag = 0x00000004;

/// Whether wgpu should expose adapters that run on top of non-compliant
/// adapters.
///
/// Turning this on might mean that some of the functionality provided by the
/// wgpu adapter/device is not working or broken. This mainly applies to a
/// Vulkan driver's compliance version. If the major compliance version is 0,
/// then the driver is ignored unless this flag is set.
///
/// When using WGPUInstanceFlag_WithEnv, takes value from the
/// WGPU_ALLOW_UNDERLYING_NONCOMPLIANT_ADAPTER environment variable.
pub const WGPUInstanceFlag_AllowUnderlyingNoncompliantAdapter: types::WGPUInstanceFlag = 0x00000008;

/// Enable GPU-based validation. Implies WGPUInstanceFlag_Validation.
/// Currently only changes behavior on the DX12 and Vulkan backends.
///
/// - D3D12: Called "GPU-based validation" (GBV).
/// - Vulkan: Called "GPU-Assisted Validation" via VK_LAYER_KHRONOS_validation.
///
/// When using WGPUInstanceFlag_WithEnv, takes value from the
/// WGPU_GPU_BASED_VALIDATION environment variable.
pub const WGPUInstanceFlag_GPUBasedValidation: types::WGPUInstanceFlag = 0x00000010;

/// Validate indirect buffer content prior to issuing indirect draws/dispatches.
///
/// This validation will transform indirect calls into no-ops if they are not
/// valid. For example, dispatch_workgroups_indirect arguments must be less
/// than the max_compute_workgroups_per_dimension device limit.
///
/// When using WGPUInstanceFlag_WithEnv, takes value from the
/// WGPU_VALIDATION_INDIRECT_CALL environment variable.
pub const WGPUInstanceFlag_ValidationIndirectCall: types::WGPUInstanceFlag = 0x00000020;

/// Enable automatic timestamp normalization. When enabled,
/// wgpuCommandEncoderResolveQuerySet will automatically normalize timestamps
/// to nanoseconds instead of returning raw timestamp values.
///
/// This introduces a compute shader into the resolution of query sets. When
/// enabled, the timestamp period returned by wgpuQueueGetTimestampPeriod
/// will always be 1.0.
pub const WGPUInstanceFlag_AutomaticTimestampNormalization: types::WGPUInstanceFlag = 0x00000040;

/// Use the default flags for the current build configuration.
/// In debug builds, this typically enables WGPUInstanceFlag_Debug and
/// WGPUInstanceFlag_Validation.
pub const WGPUInstanceFlag_Default: types::WGPUInstanceFlag = 0x01000000;

/// Convenience alias that enables WGPUInstanceFlag_Debug and
/// WGPUInstanceFlag_Validation.
pub const WGPUInstanceFlag_Debugging: types::WGPUInstanceFlag = 0x02000000;

/// Convenience alias that enables WGPUInstanceFlag_Debug,
/// WGPUInstanceFlag_Validation, and
/// WGPUInstanceFlag_GPUBasedValidation.
pub const WGPUInstanceFlag_AdvancedDebugging: types::WGPUInstanceFlag = 0x04000000;

/// Modify the flags based on environment variables. Flags with environment
/// variable support (e.g. WGPU_DEBUG, WGPU_VALIDATION) will be read
/// from the process environment and applied on top of the explicitly set flags.
pub const WGPUInstanceFlag_WithEnv: types::WGPUInstanceFlag = 0x08000000;

/// WebGPU constant `WGPUInstanceFlag_Force32`.
pub const WGPUInstanceFlag_Force32: types::WGPUInstanceFlag = 0x7fffffff;

/// WebGPU constant `WGPUShaderRuntimeChecks_None`.
pub const WGPUShaderRuntimeChecks_None: types::WGPUShaderRuntimeChecks = 0x00000000;

/// Enforce bounds checks in shaders, even if the underlying driver doesn’t support doing so natively.
pub const WGPUShaderRuntimeChecks_BoundsChecks: types::WGPUShaderRuntimeChecks = 0x00000001;

/// If not set, the caller MUST ensure that all passed shaders do not contain any infinite loops.
pub const WGPUShaderRuntimeChecks_ForceLoopBounding: types::WGPUShaderRuntimeChecks = 0x00000002;

/// If not set, the caller MUST ensure that in all passed shaders every function operating on a ray
/// query must obey these rules (functions using wgsl naming).
pub const WGPUShaderRuntimeChecks_RayQueryInitializationTracking: types::WGPUShaderRuntimeChecks = 0x00000004;

/// If not set, task shaders will not validate that the mesh shader grid they dispatch is within legal limits.
pub const WGPUShaderRuntimeChecks_TaskShaderDispatchTracking: types::WGPUShaderRuntimeChecks = 0x00000008;

/// If not set, mesh shaders won’t clamp the output primitives’ vertex indices, which can lead to
/// undefined behavior and arbitrary memory access.
pub const WGPUShaderRuntimeChecks_MeshShaderPrimitiveIndicesClamp: types::WGPUShaderRuntimeChecks = 0x00000010;

