from std::alloc import AllocError, general_allocator;
import std::c;
from std::collections import Vec;
import std::slice;
from std::string import as_ptr as string_as_ptr, byte_len as string_byte_len;

import self::raw::constants as constants;
import self::raw::functions as api;
import self::raw::types as types;

@link("wgpu_bridge")
extern "C" {
    fn wgpuBridgeCreateInstance() -> types::WGPUInstance;
    fn wgpuBridgeRequestAdapter(
        instance: types::WGPUInstance,
        options: *const types::WGPURequestAdapterOptions,
        status: *mut types::WGPURequestAdapterStatus,
        adapter: *mut types::WGPUAdapter,
    ) -> types::WGPUWaitStatus;
    fn wgpuBridgeRequestDevice(
        adapter: types::WGPUAdapter,
        descriptor: *const types::WGPUDeviceDescriptor,
        status: *mut types::WGPURequestDeviceStatus,
        device: *mut types::WGPUDevice,
    ) -> types::WGPUWaitStatus;
    fn wgpuBridgeMapBuffer(
        device: types::WGPUDevice,
        buffer: types::WGPUBuffer,
        mode: types::WGPUMapMode,
        offset: usize,
        size: usize,
        status: *mut types::WGPUMapAsyncStatus,
    ) -> types::WGPUWaitStatus;
    fn wgpuBridgeSurfaceSupportsPresentMode(
        surface: types::WGPUSurface,
        adapter: types::WGPUAdapter,
        present_mode: types::WGPUPresentMode,
    ) -> types::WGPUBool;
}

/// Recoverable errors produced by the safe WebGPU facade.
@derive(Copy, Clone, Debug, Eq)
pub enum Error {
    OutOfMemory,
    Released,
    InstanceCreationFailed,
    WaitFailed,
    AdapterUnavailable,
    AdapterRequestCancelled,
    AdapterRequestFailed,
    DeviceRequestCancelled,
    DeviceRequestFailed,
    ResourceCreationFailed,
    InvalidBufferRange,
    InvalidTextureData,
    BufferMapCancelled,
    BufferMapAborted,
    BufferMapFailed,
    QueueWorkCancelled,
    QueueWorkFailed,
    SurfaceTimeout,
    SurfaceOutdated,
    SurfaceLost,
    SurfaceOccluded,
    SurfaceFailed,
    SurfaceCapabilitiesUnavailable,
    PresentModeUnavailable,
    PresentFailed,
}

/// Linear RGBA clear color supplied to a render pass.
@derive(Copy, Clone, Debug)
pub struct Color {
    pub r: f64,
    pub g: f64,
    pub b: f64,
    pub a: f64,
}

impl Color {
    /// Creates a linear RGBA color.
    pub fn rgba(r: f64, g: f64, b: f64, a: f64) -> Color {
        Color { r: r, g: g, b: b, a: a }
    }
}

/// Vertex attribute scalar/vector encoding accepted by WebGPU.
@derive(Copy, Clone, Debug, Eq)
pub enum VertexFormat {
    Float32,
    Float32x2,
    Float32x3,
    Float32x4,
    Uint32,
}

/// Primitive assembly used by a render pipeline.
@derive(Copy, Clone, Debug, Eq)
pub enum PrimitiveTopology {
    TriangleList,
    TriangleStrip,
}

impl PrimitiveTopology {
    fn as_raw(&self) -> types::WGPUPrimitiveTopology {
        match *self {
            PrimitiveTopology::TriangleList => {
                constants::WGPUPrimitiveTopology_TriangleList
            },
            PrimitiveTopology::TriangleStrip => {
                constants::WGPUPrimitiveTopology_TriangleStrip
            },
        }
    }
}

/// Frame ordering policy requested from a presentation surface.
@derive(Copy, Clone, Debug, Eq)
pub enum PresentMode {
    /// Waits for vertical blanking and never tears. Always supported.
    Fifo,
    /// Uses FIFO normally but may present late frames immediately.
    FifoRelaxed,
    /// Presents immediately with the lowest latency and possible tearing.
    Immediate,
    /// Retains only the newest queued frame without tearing.
    Mailbox,
}

impl PresentMode {
    fn as_raw(&self) -> types::WGPUPresentMode {
        match *self {
            PresentMode::Fifo => constants::WGPUPresentMode_Fifo,
            PresentMode::FifoRelaxed => constants::WGPUPresentMode_FifoRelaxed,
            PresentMode::Immediate => constants::WGPUPresentMode_Immediate,
            PresentMode::Mailbox => constants::WGPUPresentMode_Mailbox,
        }
    }
}

@test
fn present_modes_should_preserve_the_webgpu_abi_values() {
    let fifo: PresentMode = PresentMode::Fifo;
    let relaxed: PresentMode = PresentMode::FifoRelaxed;
    let immediate: PresentMode = PresentMode::Immediate;
    let mailbox: PresentMode = PresentMode::Mailbox;
    assert(fifo.as_raw() == constants::WGPUPresentMode_Fifo);
    assert(relaxed.as_raw() == constants::WGPUPresentMode_FifoRelaxed);
    assert(immediate.as_raw() == constants::WGPUPresentMode_Immediate);
    assert(mailbox.as_raw() == constants::WGPUPresentMode_Mailbox);
}

impl VertexFormat {
    fn as_raw(&self) -> types::WGPUVertexFormat {
        match *self {
            VertexFormat::Float32 => constants::WGPUVertexFormat_Float32,
            VertexFormat::Float32x2 => constants::WGPUVertexFormat_Float32x2,
            VertexFormat::Float32x3 => constants::WGPUVertexFormat_Float32x3,
            VertexFormat::Float32x4 => constants::WGPUVertexFormat_Float32x4,
            VertexFormat::Uint32 => constants::WGPUVertexFormat_Uint32,
        }
    }
}

/// One checked vertex-buffer field supplied to pipeline creation.
@derive(Copy, Clone, Debug, Eq)
pub struct VertexAttribute {
    format: VertexFormat,
    offset: u64,
    shader_location: u32,
}

impl VertexAttribute {
    /// Describes one shader location inside a vertex or instance record.
    pub fn new(
        format: VertexFormat,
        offset: u64,
        shader_location: u32,
    ) -> VertexAttribute {
        VertexAttribute {
            format: format,
            offset: offset,
            shader_location: shader_location,
        }
    }
}

/// Creates a WebGPU string view that borrows `value`.
///
/// The returned view must not outlive the source string. WebGPU descriptor
/// creation functions consume these strings during the call.
pub fn string_view(value: str) -> types::WGPUStringView {
    types::WGPUStringView {
        data: string_as_ptr(value) as *const c::Char,
        length: string_byte_len(value),
    }
}

/// Creates the empty WebGPU string view used for optional labels.
pub fn empty_string_view() -> types::WGPUStringView {
    types::WGPUStringView {
        data: c::null_const<c::Char>(),
        length: 0,
    }
}

/// An owning WebGPU instance with blocking callback synchronization.
pub struct Instance {
    raw: types::WGPUInstance,
}

impl Instance {
    /// Creates an instance configured for efficient blocking requests.
    pub fn create() -> Result<Instance, Error> {
        let raw = unsafe { wgpuBridgeCreateInstance() };
        if c::is_null_mut(raw) {
            Err(Error::InstanceCreationFailed)
        } else {
            Ok(Instance { raw: raw })
        }
    }

    /// Requests the system's default adapter and waits without busy-spinning.
    pub fn request_adapter(&self) -> Result<Adapter, Error> {
        let options = types::WGPURequestAdapterOptions {
            next_in_chain: c::null<types::WGPUChainedStruct>(),
            feature_level: constants::WGPUFeatureLevel_Undefined,
            power_preference: constants::WGPUPowerPreference_Undefined,
            force_fallback_adapter: 0,
            backend_type: constants::WGPUBackendType_Undefined,
            compatible_surface: c::null<()>(),
        };
        self.request_adapter_with(&options)
    }

    /// Requests an adapter using an advanced raw descriptor.
    ///
    /// The caller must keep every pointer in `options` valid for the call and
    /// obey all WebGPU descriptor-chain contracts.
    pub fn request_adapter_with(
        &self,
        options: &types::WGPURequestAdapterOptions,
    ) -> Result<Adapter, Error> {
        request_adapter_from(self.raw, options)
    }

    /// Returns the borrowed native instance handle for descriptor adapters.
    pub fn as_raw(&self) -> types::WGPUInstance {
        self.raw
    }

    /// Creates another owning reference to this native instance.
    pub fn clone_ref(&self) -> Instance {
        unsafe {
            api::wgpuInstanceAddRef(self.raw);
        }
        Instance { raw: self.raw }
    }

    /// Creates a surface from a platform descriptor chain.
    ///
    /// The caller must supply a valid chain whose native objects remain alive
    /// for the lifetime required by the selected window system.
    pub fn create_surface_with(
        &self,
        descriptor: &types::WGPUSurfaceDescriptor,
    ) -> Result<Surface, Error> {
        let raw = unsafe {
            api::wgpuInstanceCreateSurface(
                self.raw,
                descriptor as *const types::WGPUSurfaceDescriptor,
            )
        };
        if c::is_null_mut(raw) {
            return Err(Error::ResourceCreationFailed);
        }
        unsafe {
            api::wgpuInstanceAddRef(self.raw);
        }
        Ok(Surface { instance: self.raw, raw: raw })
    }

    /// Releases the instance after all dependent objects are gone.
    pub fn deinit(self) {
        unsafe {
            api::wgpuInstanceRelease(self.raw);
        }
    }
}

/// An owning physical-device adapter borrowing its instance.
pub struct Adapter {
    raw: types::WGPUAdapter,
}

impl Adapter {
    /// Requests a device with WebGPU's default descriptor.
    pub fn request_device(&self) -> Result<Device, Error> {
        require_live(self.raw)?;
        let mut status = constants::WGPURequestDeviceStatus_Error;
        let mut device: types::WGPUDevice = c::null<()>();
        let wait_status = unsafe {
            wgpuBridgeRequestDevice(
                self.raw,
                c::null_const<types::WGPUDeviceDescriptor>(),
                &mut status as *mut types::WGPURequestDeviceStatus,
                &mut device as *mut types::WGPUDevice,
            )
        };
        if wait_status == constants::WGPUWaitStatus_Success
            && status == constants::WGPURequestDeviceStatus_Success
            && !c::is_null_mut(device)
        {
            return Ok(Device { raw: device });
        }
        if !c::is_null_mut(device) {
            unsafe {
                api::wgpuDeviceRelease(device);
            }
        }
        if wait_status != constants::WGPUWaitStatus_Success {
            Err(Error::WaitFailed)
        } else if status == constants::WGPURequestDeviceStatus_CallbackCancelled {
            Err(Error::DeviceRequestCancelled)
        } else {
            Err(Error::DeviceRequestFailed)
        }
    }

    /// Returns the borrowed native adapter handle.
    pub fn as_raw(&self) -> types::WGPUAdapter {
        self.raw
    }

    /// Releases this adapter in place and invalidates its native handle.
    pub fn release(&mut self) {
        if !c::is_null_mut(self.raw) {
            unsafe {
                api::wgpuAdapterRelease(self.raw);
            }
            self.raw = c::null<()>();
        }
    }

    /// Releases this adapter reference.
    pub fn deinit(self) {
        if !c::is_null_mut(self.raw) {
            unsafe {
                api::wgpuAdapterRelease(self.raw);
            }
        }
    }
}

/// An owning logical device borrowing the instance that services its futures.
pub struct Device {
    raw: types::WGPUDevice,
}

impl Device {
    /// Gets an owning reference to the device's default queue.
    pub fn queue(&self) -> Result<Queue, Error> {
        require_live(self.raw)?;
        let raw = unsafe { api::wgpuDeviceGetQueue(self.raw) };
        if c::is_null_mut(raw) {
            Err(Error::ResourceCreationFailed)
        } else {
            unsafe {
                api::wgpuDeviceAddRef(self.raw);
            }
            Ok(Queue {
                device: self.raw,
                raw: raw,
            })
        }
    }

    /// Creates an owned, initially unmapped buffer.
    pub fn create_buffer(
        &self,
        size: u64,
        usage: types::WGPUBufferUsage,
    ) -> Result<Buffer, Error> {
        require_live(self.raw)?;
        if size == 0 {
            return Err(Error::InvalidBufferRange);
        }
        let descriptor = types::WGPUBufferDescriptor {
            next_in_chain: c::null<types::WGPUChainedStruct>(),
            label: empty_string_view(),
            usage: usage,
            size: size,
            mapped_at_creation: 0,
        };
        let raw = unsafe {
            api::wgpuDeviceCreateBuffer(
                self.raw,
                &descriptor as *const types::WGPUBufferDescriptor,
            )
        };
        if c::is_null_mut(raw) {
            Err(Error::ResourceCreationFailed)
        } else {
            unsafe {
                api::wgpuDeviceAddRef(self.raw);
            }
            Ok(Buffer {
                device: self.raw,
                raw: raw,
            })
        }
    }

    /// Creates a persistent buffer for vertex or instance data uploads.
    pub fn create_vertex_buffer(&self, size: u64) -> Result<Buffer, Error> {
        self.create_buffer(
            size,
            constants::WGPUBufferUsage_Vertex
                | constants::WGPUBufferUsage_CopyDst,
        )
    }

    /// Creates an RGBA8 texture for sampled images and queue uploads.
    pub fn create_rgba8_texture(
        &self,
        width: u32,
        height: u32,
        srgb: bool,
    ) -> Result<Texture, Error> {
        require_live(self.raw)?;
        if width == 0 || height == 0 || width > 0x3fff_ffff {
            return Err(Error::InvalidTextureData);
        }
        let format: types::WGPUTextureFormat = if srgb {
            constants::WGPUTextureFormat_RGBA8UnormSrgb
        } else {
            constants::WGPUTextureFormat_RGBA8Unorm
        };
        let descriptor = types::WGPUTextureDescriptor {
            next_in_chain: c::null<types::WGPUChainedStruct>(),
            label: empty_string_view(),
            usage: constants::WGPUTextureUsage_CopyDst
                | constants::WGPUTextureUsage_TextureBinding,
            dimension: constants::WGPUTextureDimension_2D,
            size: types::WGPUExtent3D {
                width: width,
                height: height,
                depth_or_array_layers: 1,
            },
            format: format,
            mip_level_count: 1,
            sample_count: 1,
            view_format_count: 0,
            view_formats: c::null_const<types::WGPUTextureFormat>(),
        };
        let raw = unsafe {
            api::wgpuDeviceCreateTexture(
                self.raw,
                &descriptor as *const types::WGPUTextureDescriptor,
            )
        };
        if c::is_null_mut(raw) {
            Err(Error::ResourceCreationFailed)
        } else {
            Ok(Texture { raw: raw, width: width, height: height })
        }
    }

    /// Creates a clamp-to-edge nearest-neighbor sampler.
    pub fn create_nearest_sampler(&self) -> Result<Sampler, Error> {
        require_live(self.raw)?;
        let descriptor = types::WGPUSamplerDescriptor {
            next_in_chain: c::null<types::WGPUChainedStruct>(),
            label: empty_string_view(),
            address_mode_u: constants::WGPUAddressMode_ClampToEdge,
            address_mode_v: constants::WGPUAddressMode_ClampToEdge,
            address_mode_w: constants::WGPUAddressMode_ClampToEdge,
            mag_filter: constants::WGPUFilterMode_Nearest,
            min_filter: constants::WGPUFilterMode_Nearest,
            mipmap_filter: constants::WGPUMipmapFilterMode_Nearest,
            lod_min_clamp: 0.0,
            lod_max_clamp: 32.0,
            compare: constants::WGPUCompareFunction_Undefined,
            max_anisotropy: 1,
        };
        let raw = unsafe {
            api::wgpuDeviceCreateSampler(
                self.raw,
                &descriptor as *const types::WGPUSamplerDescriptor,
            )
        };
        if c::is_null_mut(raw) {
            Err(Error::ResourceCreationFailed)
        } else {
            Ok(Sampler { raw: raw })
        }
    }

    /// Binds one sampler and one sampled texture to a pipeline layout.
    pub fn create_texture_bind_group(
        &self,
        layout: &BindGroupLayout,
        sampler: &Sampler,
        view: &TextureView,
    ) -> Result<BindGroup, Error> {
        require_live(self.raw)?;
        require_live(layout.raw)?;
        require_live(sampler.raw)?;
        require_live(view.raw)?;
        let entries = [
            types::WGPUBindGroupEntry {
                next_in_chain: c::null<types::WGPUChainedStruct>(),
                binding: 0,
                buffer: c::null<()>(),
                offset: 0,
                size: 0,
                sampler: sampler.raw,
                texture_view: c::null<()>(),
            },
            types::WGPUBindGroupEntry {
                next_in_chain: c::null<types::WGPUChainedStruct>(),
                binding: 1,
                buffer: c::null<()>(),
                offset: 0,
                size: 0,
                sampler: c::null<()>(),
                texture_view: view.raw,
            },
        ];
        let descriptor = types::WGPUBindGroupDescriptor {
            next_in_chain: c::null<types::WGPUChainedStruct>(),
            label: empty_string_view(),
            layout: layout.raw,
            entry_count: 2,
            entries: slice::as_ptr(&entries),
        };
        let raw = unsafe {
            api::wgpuDeviceCreateBindGroup(
                self.raw,
                &descriptor as *const types::WGPUBindGroupDescriptor,
            )
        };
        if c::is_null_mut(raw) {
            Err(Error::ResourceCreationFailed)
        } else {
            Ok(BindGroup { raw: raw })
        }
    }

    /// Creates a WGSL shader module from borrowed UTF-8 source text.
    pub fn create_shader_module_wgsl(
        &self,
        label: str,
        source: str,
    ) -> Result<ShaderModule, Error> {
        require_live(self.raw)?;
        let mut wgsl = types::WGPUShaderSourceWGSL {
            chain: types::WGPUChainedStruct {
                next: c::null<types::WGPUChainedStruct>(),
                s_type: constants::WGPUSType_ShaderSourceWGSL,
            },
            code: string_view(source),
        };
        let descriptor = types::WGPUShaderModuleDescriptor {
            next_in_chain: &mut wgsl.chain as *mut types::WGPUChainedStruct,
            label: string_view(label),
        };
        let raw = unsafe {
            api::wgpuDeviceCreateShaderModule(
                self.raw,
                &descriptor as *const types::WGPUShaderModuleDescriptor,
            )
        };
        owned_shader_module(raw)
    }

    /// Creates a single-buffer render pipeline from WGSL.
    ///
    /// The pipeline uses triangle lists, alpha blending, automatic pipeline
    /// layout inference, and either per-vertex or per-instance attributes.
    pub fn create_render_pipeline_wgsl(
        &self,
        label: str,
        source: str,
        target_format: types::WGPUTextureFormat,
        array_stride: u64,
        instance_step: bool,
        attributes: &[VertexAttribute],
    ) -> Result<RenderPipeline, Error> {
        self.create_render_pipeline_wgsl_with_topology(
            label,
            source,
            target_format,
            array_stride,
            instance_step,
            attributes,
            PrimitiveTopology::TriangleList,
        )
    }

    /// Creates a single-buffer render pipeline with explicit primitive assembly.
    pub fn create_render_pipeline_wgsl_with_topology(
        &self,
        label: str,
        source: str,
        target_format: types::WGPUTextureFormat,
        array_stride: u64,
        instance_step: bool,
        attributes: &[VertexAttribute],
        topology: PrimitiveTopology,
    ) -> Result<RenderPipeline, Error> {
        require_live(self.raw)?;
        if array_stride == 0 || slice::len(attributes) == 0 {
            return Err(Error::ResourceCreationFailed);
        }
        let allocator = general_allocator();
        let raw_result: Result<Vec<types::WGPUVertexAttribute>, AllocError> =
            Vec::with_capacity(&allocator, slice::len(attributes));
        let mut raw_attributes = match raw_result {
            Ok(value) => value,
            Err(_) => {
                return Err(Error::OutOfMemory);
            },
        };
        defer raw_attributes.deinit();
        let mut index: usize = 0;
        while index < slice::len(attributes) {
            let attribute = attributes[index];
            let raw_attribute = types::WGPUVertexAttribute {
                next_in_chain: c::null<types::WGPUChainedStruct>(),
                format: attribute.format.as_raw(),
                offset: attribute.offset,
                shader_location: attribute.shader_location,
            };
            match raw_attributes.push(raw_attribute) {
                Ok(_) => {},
                Err(_) => {
                    return Err(Error::OutOfMemory);
                },
            }
            index += 1;
        }
        let shader = self.create_shader_module_wgsl(label, source)?;
        defer shader.deinit();
        let vertex_buffer = types::WGPUVertexBufferLayout {
            next_in_chain: c::null<types::WGPUChainedStruct>(),
            step_mode: if instance_step {
                constants::WGPUVertexStepMode_Instance
            } else {
                constants::WGPUVertexStepMode_Vertex
            },
            array_stride: array_stride,
            attribute_count: raw_attributes.len(),
            attributes: slice::as_ptr(raw_attributes.as_slice()),
        };
        let vertex = types::WGPUVertexState {
            next_in_chain: c::null<types::WGPUChainedStruct>(),
            module: shader.as_raw(),
            entry_point: string_view("vs_main"),
            constant_count: 0,
            constants: c::null_const<types::WGPUConstantEntry>(),
            buffer_count: 1,
            buffers: &vertex_buffer as *const types::WGPUVertexBufferLayout,
        };
        let blend = types::WGPUBlendState {
            color: types::WGPUBlendComponent {
                operation: constants::WGPUBlendOperation_Add,
                src_factor: constants::WGPUBlendFactor_SrcAlpha,
                dst_factor: constants::WGPUBlendFactor_OneMinusSrcAlpha,
            },
            alpha: types::WGPUBlendComponent {
                operation: constants::WGPUBlendOperation_Add,
                src_factor: constants::WGPUBlendFactor_One,
                dst_factor: constants::WGPUBlendFactor_OneMinusSrcAlpha,
            },
        };
        let target = types::WGPUColorTargetState {
            next_in_chain: c::null<types::WGPUChainedStruct>(),
            format: target_format,
            blend: &blend as *const types::WGPUBlendState,
            write_mask: constants::WGPUColorWriteMask_All,
        };
        let fragment = types::WGPUFragmentState {
            next_in_chain: c::null<types::WGPUChainedStruct>(),
            module: shader.as_raw(),
            entry_point: string_view("fs_main"),
            constant_count: 0,
            constants: c::null_const<types::WGPUConstantEntry>(),
            target_count: 1,
            targets: &target as *const types::WGPUColorTargetState,
        };
        let descriptor = types::WGPURenderPipelineDescriptor {
            next_in_chain: c::null<types::WGPUChainedStruct>(),
            label: string_view(label),
            layout: c::null<()>(),
            vertex: vertex,
            primitive: types::WGPUPrimitiveState {
                next_in_chain: c::null<types::WGPUChainedStruct>(),
                topology: topology.as_raw(),
                strip_index_format: constants::WGPUIndexFormat_Undefined,
                front_face: constants::WGPUFrontFace_CCW,
                cull_mode: constants::WGPUCullMode_None,
                unclipped_depth: 0,
            },
            depth_stencil: c::null_const<types::WGPUDepthStencilState>(),
            multisample: types::WGPUMultisampleState {
                next_in_chain: c::null<types::WGPUChainedStruct>(),
                count: 1,
                mask: 4294967295,
                alpha_to_coverage_enabled: 0,
            },
            fragment: &fragment as *const types::WGPUFragmentState,
        };
        let raw = unsafe {
            api::wgpuDeviceCreateRenderPipeline(
                self.raw,
                &descriptor as *const types::WGPURenderPipelineDescriptor,
            )
        };
        if c::is_null_mut(raw) {
            Err(Error::ResourceCreationFailed)
        } else {
            Ok(RenderPipeline { raw: raw })
        }
    }

    /// Creates an empty command encoder.
    pub fn create_command_encoder(&self) -> Result<CommandEncoder, Error> {
        require_live(self.raw)?;
        let raw = unsafe {
            api::wgpuDeviceCreateCommandEncoder(
                self.raw,
                c::null_const<types::WGPUCommandEncoderDescriptor>(),
            )
        };
        if c::is_null_mut(raw) {
            Err(Error::ResourceCreationFailed)
        } else {
            Ok(CommandEncoder {
                raw: raw,
            })
        }
    }

    /// Clears, submits, and presents one acquired surface frame transactionally.
    ///
    /// The texture view is never exposed, so it cannot outlive its frame.
    pub fn clear_and_present(
        &self,
        queue: &Queue,
        frame: SurfaceFrame,
        color: Color,
    ) -> Result<(), Error> {
        let mut frame = frame;
        if c::is_null_mut(self.raw)
            || c::is_null_mut(queue.raw)
            || c::is_null_mut(queue.device)
            || c::is_null_mut(frame.surface)
            || c::is_null_mut(frame.texture)
        {
            frame.release();
            return Err(Error::Released);
        }
        let view = unsafe {
            api::wgpuTextureCreateView(
                frame.texture,
                c::null_const<types::WGPUTextureViewDescriptor>(),
            )
        };
        if c::is_null_mut(view) {
            frame.release();
            return Err(Error::ResourceCreationFailed);
        }
        let mut encoder = match self.create_command_encoder() {
            Ok(value) => value,
            Err(error) => {
                unsafe {
                    api::wgpuTextureViewRelease(view);
                }
                frame.release();
                return Err(error);
            },
        };
        match record_clear(&mut encoder, view, color) {
            Ok(_) => {},
            Err(error) => {
                encoder.release();
                unsafe {
                    api::wgpuTextureViewRelease(view);
                }
                frame.release();
                return Err(error);
            },
        }
        let commands = match encoder.finish() {
            Ok(value) => value,
            Err(error) => {
                unsafe {
                    api::wgpuTextureViewRelease(view);
                }
                frame.release();
                return Err(error);
            },
        };
        match queue.submit(commands) {
            Ok(_) => {},
            Err(error) => {
                unsafe {
                    api::wgpuTextureViewRelease(view);
                }
                frame.release();
                return Err(error);
            },
        }
        unsafe {
            api::wgpuTextureViewRelease(view);
        }
        frame.present()
    }

    /// Clears, draws one instanced vertex buffer, submits, and presents.
    pub fn draw_instanced_and_present(
        &self,
        queue: &Queue,
        frame: SurfaceFrame,
        color: Color,
        pipeline: &RenderPipeline,
        bind_group: &BindGroup,
        vertex_buffer: &Buffer,
        instance_count: u32,
        byte_length: u64,
    ) -> Result<(), Error> {
        self.draw_instanced_vertices_and_present(
            queue,
            frame,
            color,
            pipeline,
            bind_group,
            vertex_buffer,
            6,
            instance_count,
            byte_length,
        )
    }

    /// Draws a fixed vertex count per instance and presents the frame.
    pub fn draw_instanced_vertices_and_present(
        &self,
        queue: &Queue,
        frame: SurfaceFrame,
        color: Color,
        pipeline: &RenderPipeline,
        bind_group: &BindGroup,
        vertex_buffer: &Buffer,
        vertex_count: u32,
        instance_count: u32,
        byte_length: u64,
    ) -> Result<(), Error> {
        let mut frame = frame;
        if c::is_null_mut(self.raw)
            || c::is_null_mut(queue.raw)
            || c::is_null_mut(queue.device)
            || c::is_null_mut(frame.surface)
            || c::is_null_mut(frame.texture)
            || c::is_null_mut(pipeline.raw)
            || c::is_null_mut(bind_group.raw)
            || c::is_null_mut(vertex_buffer.raw)
        {
            frame.release();
            return Err(Error::Released);
        }
        if vertex_count == 0
            || instance_count == 0
            || byte_length == 0
            || byte_length > vertex_buffer.size()
        {
            frame.release();
            return Err(Error::InvalidBufferRange);
        }
        let view = unsafe {
            api::wgpuTextureCreateView(
                frame.texture,
                c::null_const<types::WGPUTextureViewDescriptor>(),
            )
        };
        if c::is_null_mut(view) {
            frame.release();
            return Err(Error::ResourceCreationFailed);
        }
        let mut encoder = match self.create_command_encoder() {
            Ok(value) => value,
            Err(error) => {
                unsafe {
                    api::wgpuTextureViewRelease(view);
                }
                frame.release();
                return Err(error);
            },
        };
        match record_instanced(
            &mut encoder,
            view,
            color,
            pipeline,
            bind_group,
            vertex_buffer,
            vertex_count,
            instance_count,
            byte_length,
        ) {
            Ok(_) => {},
            Err(error) => {
                encoder.release();
                unsafe {
                    api::wgpuTextureViewRelease(view);
                }
                frame.release();
                return Err(error);
            },
        }
        let commands = match encoder.finish() {
            Ok(value) => value,
            Err(error) => {
                unsafe {
                    api::wgpuTextureViewRelease(view);
                }
                frame.release();
                return Err(error);
            },
        };
        match queue.submit(commands) {
            Ok(_) => {},
            Err(error) => {
                unsafe {
                    api::wgpuTextureViewRelease(view);
                }
                frame.release();
                return Err(error);
            },
        }
        unsafe {
            api::wgpuTextureViewRelease(view);
        }
        frame.present()
    }

    /// Returns the borrowed native device handle.
    pub fn as_raw(&self) -> types::WGPUDevice {
        self.raw
    }

    /// Releases this device in place and invalidates its native handle.
    pub fn release(&mut self) {
        if !c::is_null_mut(self.raw) {
            unsafe {
                api::wgpuDeviceRelease(self.raw);
            }
            self.raw = c::null<()>();
        }
    }

    /// Releases the logical device after all child resources are gone.
    pub fn deinit(self) {
        if !c::is_null_mut(self.raw) {
            unsafe {
                api::wgpuDeviceRelease(self.raw);
            }
        }
    }
}

/// An owning queue reference borrowing its device and instance.
pub struct Queue {
    device: types::WGPUDevice,
    raw: types::WGPUQueue,
}

impl Queue {
    /// Copies bytes immediately into a buffer at `offset`.
    pub fn write_buffer(
        &self,
        buffer: &Buffer,
        offset: u64,
        data: &[u8],
    ) -> Result<(), Error> {
        require_live(self.raw)?;
        require_live(self.device)?;
        require_live(buffer.raw)?;
        let len = slice::byte_len(data);
        if offset > buffer.size() || len as u64 > buffer.size() - offset {
            return Err(Error::InvalidBufferRange);
        }
        let pointer = slice::bytes_as_ptr(data) as *const ();
        unsafe {
            api::wgpuQueueWriteBuffer(self.raw, buffer.as_raw(), offset, pointer, len);
        }
        Ok(())
    }

    /// Copies padding-free `@derive(Pod)` values into a GPU buffer.
    pub fn write_buffer_pod<T: Pod>(
        &self,
        buffer: &Buffer,
        offset: u64,
        data: &[T],
    ) -> Result<(), Error> {
        require_live(self.raw)?;
        require_live(self.device)?;
        require_live(buffer.raw)?;
        let byte_length = slice::len(data) * slice::element_size(data);
        if offset > buffer.size()
            || byte_length as u64 > buffer.size() - offset
        {
            return Err(Error::InvalidBufferRange);
        }
        let pointer = slice::as_ptr(data) as *const ();
        unsafe {
            api::wgpuQueueWriteBuffer(
                self.raw,
                buffer.as_raw(),
                offset,
                pointer,
                byte_length,
            );
        }
        Ok(())
    }

    /// Uploads one tightly packed RGBA8 image into a matching texture.
    pub fn write_texture_rgba8(
        &self,
        texture: &Texture,
        data: &[u8],
    ) -> Result<(), Error> {
        require_live(self.raw)?;
        require_live(self.device)?;
        require_live(texture.raw)?;
        if texture.width > 0x3fff_ffff {
            return Err(Error::InvalidTextureData);
        }
        let row_bytes = texture.width * 4;
        let expected = row_bytes as u64 * texture.height as u64;
        if slice::byte_len(data) as u64 != expected {
            return Err(Error::InvalidTextureData);
        }
        let destination = types::WGPUTexelCopyTextureInfo {
            texture: texture.raw,
            mip_level: 0,
            origin: types::WGPUOrigin3D { x: 0, y: 0, z: 0 },
            aspect: constants::WGPUTextureAspect_All,
        };
        let layout = types::WGPUTexelCopyBufferLayout {
            offset: 0,
            bytes_per_row: row_bytes,
            rows_per_image: texture.height,
        };
        let size = types::WGPUExtent3D {
            width: texture.width,
            height: texture.height,
            depth_or_array_layers: 1,
        };
        let pointer = slice::bytes_as_ptr(data) as *const ();
        unsafe {
            api::wgpuQueueWriteTexture(
                self.raw,
                &destination as *const types::WGPUTexelCopyTextureInfo,
                pointer,
                slice::byte_len(data),
                &layout as *const types::WGPUTexelCopyBufferLayout,
                &size as *const types::WGPUExtent3D,
            );
        }
        Ok(())
    }

    /// Submits one finished command buffer and releases its host reference.
    pub fn submit(&self, command: CommandBuffer) -> Result<(), Error> {
        let mut command = command;
        if c::is_null_mut(self.raw)
            || c::is_null_mut(self.device)
            || c::is_null_mut(command.raw)
        {
            command.release();
            return Err(Error::Released);
        }
        let raw = command.as_raw();
        unsafe {
            api::wgpuQueueSubmit(
                self.raw,
                1,
                &raw as *const types::WGPUCommandBuffer,
            );
        }
        command.release();
        Ok(())
    }

    /// Waits for previously submitted work without consuming CPU.
    pub fn wait(&self) -> Result<(), Error> {
        require_live(self.raw)?;
        require_live(self.device)?;
        if unsafe {
            api::wgpuDevicePoll(
                self.device,
                1,
                c::null_const<types::WGPUSubmissionIndex>(),
            )
        } != 0 {
            Ok(())
        } else {
            Err(Error::QueueWorkFailed)
        }
    }

    /// Returns the borrowed native queue handle.
    pub fn as_raw(&self) -> types::WGPUQueue {
        self.raw
    }

    /// Releases the queue and its retained device reference in place.
    pub fn release(&mut self) {
        if !c::is_null_mut(self.raw) {
            unsafe {
                api::wgpuQueueRelease(self.raw);
            }
            self.raw = c::null<()>();
        }
        if !c::is_null_mut(self.device) {
            unsafe {
                api::wgpuDeviceRelease(self.device);
            }
            self.device = c::null<()>();
        }
    }

    /// Releases this queue reference.
    pub fn deinit(self) {
        if !c::is_null_mut(self.raw) {
            unsafe {
                api::wgpuQueueRelease(self.raw);
            }
        }
        if !c::is_null_mut(self.device) {
            unsafe {
                api::wgpuDeviceRelease(self.device);
            }
        }
    }
}

/// An owning sampled texture.
pub struct Texture {
    raw: types::WGPUTexture,
    width: u32,
    height: u32,
}

impl Texture {
    /// Creates a view over the complete texture.
    pub fn create_view(&self) -> Result<TextureView, Error> {
        require_live(self.raw)?;
        let raw = unsafe {
            api::wgpuTextureCreateView(
                self.raw,
                c::null_const<types::WGPUTextureViewDescriptor>(),
            )
        };
        if c::is_null_mut(raw) {
            Err(Error::ResourceCreationFailed)
        } else {
            Ok(TextureView { raw: raw })
        }
    }

    pub fn width(&self) -> u32 { self.width }

    pub fn height(&self) -> u32 { self.height }

    pub fn byte_len(&self) -> u64 {
        self.width as u64 * self.height as u64 * 4
    }

    /// Releases the texture in place.
    pub fn release(&mut self) {
        if !c::is_null_mut(self.raw) {
            unsafe {
                api::wgpuTextureRelease(self.raw);
            }
            self.raw = c::null<()>();
            self.width = 0;
            self.height = 0;
        }
    }
}

