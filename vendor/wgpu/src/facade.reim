        if !c::is_null_mut(self.raw) {
            unsafe {
                api::wgpuCommandBufferRelease(self.raw);
            }
        }
    }
}

/// An owning presentation surface borrowing its instance.
pub struct Surface {
    instance: types::WGPUInstance,
    raw: types::WGPUSurface,
}

fn configure_surface(
    surface: &mut Surface,
    device: &Device,
    format: types::WGPUTextureFormat,
    width: u32,
    height: u32,
    present_mode: PresentMode,
) -> Result<(), Error> {
    require_live(surface.raw)?;
    require_live(surface.instance)?;
    require_live(device.raw)?;
    if format == 0 || width == 0 || height == 0 {
        return Err(Error::SurfaceFailed);
    }
    let config = types::WGPUSurfaceConfiguration {
        next_in_chain: c::null<types::WGPUChainedStruct>(),
        device: device.as_raw(),
        format: format,
        usage: constants::WGPUTextureUsage_RenderAttachment,
        width: width,
        height: height,
        view_format_count: 0,
        view_formats: c::null_const<types::WGPUTextureFormat>(),
        alpha_mode: constants::WGPUCompositeAlphaMode_Auto,
        present_mode: present_mode.as_raw(),
    };
    unsafe {
        api::wgpuSurfaceConfigure(
            surface.raw,
            &config as *const types::WGPUSurfaceConfiguration,
        );
    }
    Ok(())
}

impl Surface {
    /// Requests an adapter compatible with this surface.
    pub fn request_adapter(&self) -> Result<Adapter, Error> {
        require_live(self.instance)?;
        require_live(self.raw)?;
        let options = types::WGPURequestAdapterOptions {
            next_in_chain: c::null<types::WGPUChainedStruct>(),
            feature_level: constants::WGPUFeatureLevel_Undefined,
            power_preference: constants::WGPUPowerPreference_Undefined,
            force_fallback_adapter: 0,
            backend_type: constants::WGPUBackendType_Undefined,
            compatible_surface: self.raw,
        };
        request_adapter_from(self.instance, &options)
    }

    /// Returns the adapter's most preferred format for this surface.
    pub fn preferred_format(
        &self,
        adapter: &Adapter,
    ) -> Result<types::WGPUTextureFormat, Error> {
        require_live(self.raw)?;
        require_live(self.instance)?;
        require_live(adapter.raw)?;
        let mut capabilities = types::WGPUSurfaceCapabilities {
            next_in_chain: c::null<types::WGPUChainedStruct>(),
            usages: 0,
            format_count: 0,
            formats: c::null_const<types::WGPUTextureFormat>(),
            present_mode_count: 0,
            present_modes: c::null_const<types::WGPUPresentMode>(),
            alpha_mode_count: 0,
            alpha_modes: c::null_const<types::WGPUCompositeAlphaMode>(),
        };
        let status = unsafe {
            api::wgpuSurfaceGetCapabilities(
                self.raw,
                adapter.as_raw(),
                &mut capabilities as *mut types::WGPUSurfaceCapabilities,
            )
        };
        let format = if status == constants::WGPUStatus_Success
            && capabilities.format_count > 0
            && !c::is_null(capabilities.formats)
        {
            unsafe { *capabilities.formats }
        } else {
            0
        };
        unsafe {
            api::wgpuSurfaceCapabilitiesFreeMembers(capabilities);
        }
        if format == 0 {
            Err(Error::SurfaceCapabilitiesUnavailable)
        } else {
            Ok(format)
        }
    }

    /// Returns whether the adapter supports `present_mode` on this surface.
    pub fn supports_present_mode(
        &self,
        adapter: &Adapter,
        present_mode: PresentMode,
    ) -> Result<bool, Error> {
        require_live(self.raw)?;
        require_live(self.instance)?;
        require_live(adapter.raw)?;
        Ok(unsafe {
            wgpuBridgeSurfaceSupportsPresentMode(
                self.raw,
                adapter.as_raw(),
                present_mode.as_raw(),
            ) != 0
        })
    }

    /// Configures this surface for rendering and FIFO presentation.
    pub fn configure(
        &mut self,
        device: &Device,
        format: types::WGPUTextureFormat,
        width: u32,
        height: u32,
    ) -> Result<(), Error> {
        configure_surface(self, device, format, width, height, PresentMode::Fifo)
    }

    /// Configures this surface with an explicitly supported presentation mode.
    pub fn configure_with_present_mode(
        &mut self,
        adapter: &Adapter,
        device: &Device,
        format: types::WGPUTextureFormat,
        width: u32,
        height: u32,
        present_mode: PresentMode,
    ) -> Result<(), Error> {
        if !self.supports_present_mode(adapter, present_mode)? {
            return Err(Error::PresentModeUnavailable);
        }
        configure_surface(self, device, format, width, height, present_mode)
    }

    /// Acquires the next presentable texture.
    pub fn acquire(&self) -> Result<SurfaceFrame, Error> {
        require_live(self.raw)?;
        require_live(self.instance)?;
        let mut texture = types::WGPUSurfaceTexture {
            next_in_chain: c::null<types::WGPUChainedStruct>(),
            texture: c::null<()>(),
            status: 0,
        };
        unsafe {
            api::wgpuSurfaceGetCurrentTexture(
                self.raw,
                &mut texture as *mut types::WGPUSurfaceTexture,
            );
        }
        if texture.status == constants::WGPUSurfaceGetCurrentTextureStatus_SuccessOptimal
            || texture.status == constants::WGPUSurfaceGetCurrentTextureStatus_SuccessSuboptimal
        {
            if c::is_null_mut(texture.texture) {
                Err(Error::SurfaceFailed)
            } else {
                unsafe {
                    api::wgpuSurfaceAddRef(self.raw);
                }
                Ok(SurfaceFrame {
                    surface: self.raw,
                    texture: texture.texture,
                    suboptimal: texture.status
                        == constants::WGPUSurfaceGetCurrentTextureStatus_SuccessSuboptimal,
                })
            }
        } else {
            Err(surface_error(texture.status))
        }
    }

    /// Removes the current device configuration.
    pub fn unconfigure(&mut self) -> Result<(), Error> {
        require_live(self.raw)?;
        require_live(self.instance)?;
        unsafe {
            api::wgpuSurfaceUnconfigure(self.raw);
        }
        Ok(())
    }

    /// Returns the borrowed native surface handle.
    pub fn as_raw(&self) -> types::WGPUSurface {
        self.raw
    }

    /// Releases the surface and retained instance reference in place.
    pub fn release(&mut self) {
        if !c::is_null_mut(self.raw) {
            unsafe {
                api::wgpuSurfaceRelease(self.raw);
            }
            self.raw = c::null<()>();
        }
        if !c::is_null_mut(self.instance) {
            unsafe {
                api::wgpuInstanceRelease(self.instance);
            }
            self.instance = c::null<()>();
        }
    }

    /// Releases the surface after it has been unconfigured.
    pub fn deinit(self) {
        if !c::is_null_mut(self.raw) {
            unsafe {
                api::wgpuSurfaceRelease(self.raw);
            }
        }
        if !c::is_null_mut(self.instance) {
            unsafe {
                api::wgpuInstanceRelease(self.instance);
            }
        }
    }
}

/// One acquired presentation image.
pub struct SurfaceFrame {
    surface: types::WGPUSurface,
    texture: types::WGPUTexture,
    suboptimal: bool,
}

impl SurfaceFrame {
    /// Reports whether the surface should be reconfigured soon.
    pub fn is_suboptimal(&self) -> bool {
        self.suboptimal
    }

    /// Presents the frame and releases its texture reference.
    pub fn present(self) -> Result<(), Error> {
        let mut frame = self;
        if c::is_null_mut(frame.surface) || c::is_null_mut(frame.texture) {
            frame.release();
            return Err(Error::Released);
        }
        let status = unsafe { api::wgpuSurfacePresent(frame.surface) };
        frame.release();
        if status == constants::WGPUStatus_Success {
            Ok(())
        } else {
            Err(Error::PresentFailed)
        }
    }

    /// Releases an acquired frame without presenting it.
    pub fn discard(self) {
        let mut frame = self;
        frame.release();
    }

    /// Releases an acquired frame in place without presenting it.
    pub fn release(&mut self) {
        if !c::is_null_mut(self.texture) {
            unsafe {
                api::wgpuTextureRelease(self.texture);
            }
            self.texture = c::null<()>();
        }
        if !c::is_null_mut(self.surface) {
            unsafe {
                api::wgpuSurfaceRelease(self.surface);
            }
            self.surface = c::null<()>();
        }
    }
}

fn record_clear(
    encoder: &mut CommandEncoder,
    view: types::WGPUTextureView,
    color: Color,
) -> Result<(), Error> {
    let attachment = types::WGPURenderPassColorAttachment {
        next_in_chain: c::null<types::WGPUChainedStruct>(),
        view: view,
        depth_slice: 4294967295,
        resolve_target: c::null<()>(),
        load_op: constants::WGPULoadOp_Clear,
        store_op: constants::WGPUStoreOp_Store,
        clear_value: types::WGPUColor {
            r: color.r,
            g: color.g,
            b: color.b,
            a: color.a,
        },
    };
    let descriptor = types::WGPURenderPassDescriptor {
        next_in_chain: c::null<types::WGPUChainedStruct>(),
        label: empty_string_view(),
        color_attachment_count: 1,
        color_attachments: &attachment
            as *const types::WGPURenderPassColorAttachment,
        depth_stencil_attachment: c::null_const<
            types::WGPURenderPassDepthStencilAttachment,
        >(),
        occlusion_query_set: c::null<()>(),
        timestamp_writes: c::null_const<types::WGPUPassTimestampWrites>(),
    };
    let pass = unsafe {
        api::wgpuCommandEncoderBeginRenderPass(
            encoder.raw,
            &descriptor as *const types::WGPURenderPassDescriptor,
        )
    };
    if c::is_null_mut(pass) {
        return Err(Error::ResourceCreationFailed);
    }
    unsafe {
        api::wgpuRenderPassEncoderEnd(pass);
        api::wgpuRenderPassEncoderRelease(pass);
    }
    Ok(())
}

fn record_instanced(
    encoder: &mut CommandEncoder,
    view: types::WGPUTextureView,
    color: Color,
    pipeline: &RenderPipeline,
    bind_group: &BindGroup,
    vertex_buffer: &Buffer,
    vertex_count: u32,
    instance_count: u32,
    byte_length: u64,
) -> Result<(), Error> {
    let attachment = types::WGPURenderPassColorAttachment {
        next_in_chain: c::null<types::WGPUChainedStruct>(),
        view: view,
        depth_slice: 4294967295,
        resolve_target: c::null<()>(),
        load_op: constants::WGPULoadOp_Clear,
        store_op: constants::WGPUStoreOp_Store,
        clear_value: types::WGPUColor {
            r: color.r,
            g: color.g,
            b: color.b,
            a: color.a,
        },
    };
    let descriptor = types::WGPURenderPassDescriptor {
        next_in_chain: c::null<types::WGPUChainedStruct>(),
        label: empty_string_view(),
        color_attachment_count: 1,
        color_attachments: &attachment
            as *const types::WGPURenderPassColorAttachment,
        depth_stencil_attachment: c::null_const<
            types::WGPURenderPassDepthStencilAttachment,
        >(),
        occlusion_query_set: c::null<()>(),
        timestamp_writes: c::null_const<types::WGPUPassTimestampWrites>(),
    };
    let pass = unsafe {
        api::wgpuCommandEncoderBeginRenderPass(
            encoder.raw,
            &descriptor as *const types::WGPURenderPassDescriptor,
        )
    };
    if c::is_null_mut(pass) {
        return Err(Error::ResourceCreationFailed);
    }
    unsafe {
        api::wgpuRenderPassEncoderSetPipeline(pass, pipeline.as_raw());
        api::wgpuRenderPassEncoderSetBindGroup(
            pass,
            0,
            bind_group.as_raw(),
            0,
            c::null_const<u32>(),
        );
        api::wgpuRenderPassEncoderSetVertexBuffer(
            pass,
            0,
            vertex_buffer.as_raw(),
            0,
            byte_length,
        );
        api::wgpuRenderPassEncoderDraw(
            pass,
            vertex_count,
            instance_count,
            0,
            0,
        );
        api::wgpuRenderPassEncoderEnd(pass);
        api::wgpuRenderPassEncoderRelease(pass);
    }
    Ok(())
}

fn owned_shader_module(
    raw: types::WGPUShaderModule,
) -> Result<ShaderModule, Error> {
    if c::is_null_mut(raw) {
        Err(Error::ResourceCreationFailed)
    } else {
        Ok(ShaderModule { raw: raw })
    }
}

fn request_adapter_from(
    instance: types::WGPUInstance,
    options: &types::WGPURequestAdapterOptions,
) -> Result<Adapter, Error> {
    require_live(instance)?;
    let mut status = constants::WGPURequestAdapterStatus_Error;
    let mut adapter: types::WGPUAdapter = c::null<()>();
    let wait_status = unsafe {
        wgpuBridgeRequestAdapter(
            instance,
            options as *const types::WGPURequestAdapterOptions,
            &mut status as *mut types::WGPURequestAdapterStatus,
            &mut adapter as *mut types::WGPUAdapter,
        )
    };
    if wait_status == constants::WGPUWaitStatus_Success
        && status == constants::WGPURequestAdapterStatus_Success
        && !c::is_null_mut(adapter)
    {
        return Ok(Adapter { raw: adapter });
    }
    if !c::is_null_mut(adapter) {
        unsafe {
            api::wgpuAdapterRelease(adapter);
        }
    }
    if wait_status != constants::WGPUWaitStatus_Success {
        Err(Error::WaitFailed)
    } else if status == constants::WGPURequestAdapterStatus_CallbackCancelled {
        Err(Error::AdapterRequestCancelled)
    } else if status == constants::WGPURequestAdapterStatus_Unavailable {
        Err(Error::AdapterUnavailable)
    } else {
        Err(Error::AdapterRequestFailed)
    }
}

fn require_live(handle: *mut ()) -> Result<(), Error> {
    if c::is_null_mut(handle) {
        Err(Error::Released)
    } else {
        Ok(())
    }
}

fn check_mapping_status(
    wait_status: types::WGPUWaitStatus,
    status: types::WGPUMapAsyncStatus,
) -> Result<(), Error> {
    if wait_status != constants::WGPUWaitStatus_Success {
        return Err(Error::WaitFailed);
    }
    if status == constants::WGPUMapAsyncStatus_CallbackCancelled {
        return Err(Error::BufferMapCancelled);
    }
    if status == constants::WGPUMapAsyncStatus_Aborted {
        return Err(Error::BufferMapAborted);
    }
    if status == constants::WGPUMapAsyncStatus_Success {
        Ok(())
    } else {
        Err(Error::BufferMapFailed)
    }
}

fn surface_error(status: types::WGPUSurfaceGetCurrentTextureStatus) -> Error {
    if status == constants::WGPUSurfaceGetCurrentTextureStatus_Timeout {
        Error::SurfaceTimeout
    } else if status == constants::WGPUSurfaceGetCurrentTextureStatus_Outdated {
        Error::SurfaceOutdated
    } else if status == constants::WGPUSurfaceGetCurrentTextureStatus_Lost {
        Error::SurfaceLost
    } else if status == constants::WGPUSurfaceGetCurrentTextureStatus_Occluded {
        Error::SurfaceOccluded
    } else {
        Error::SurfaceFailed
    }
}

@test
fn released_owners_should_reject_native_operations_and_cleanup_twice() {
    let mut adapter = Adapter { raw: c::null<()>() };
    assert(match adapter.request_device() {
        Err(Error::Released) => true,
        _ => false,
    });
    adapter.release();
    adapter.deinit();

    let mut device = Device { raw: c::null<()>() };
    assert(match device.queue() {
        Err(Error::Released) => true,
        _ => false,
    });
    assert(match device.create_vertex_buffer(64) {
        Err(Error::Released) => true,
        _ => false,
    });
    device.release();
    device.deinit();

    let mut buffer = Buffer {
        device: c::null<()>(),
        raw: c::null<()>(),
    };
    assert(buffer.size() == 0);
    {
        let mapping = buffer.map_read(0, 1);
        assert(match mapping {
            Err(Error::Released) => true,
            _ => false,
        });
    }
    buffer.destroy();
    buffer.release();
    buffer.deinit();

    let mut texture = Texture {
        raw: c::null<()>(),
        width: 0,
        height: 0,
    };
    assert(match texture.create_view() {
        Err(Error::Released) => true,
        _ => false,
    });
    texture.release();

    let mut pipeline = RenderPipeline { raw: c::null<()>() };
    assert(match pipeline.bind_group_layout(0) {
        Err(Error::Released) => true,
        _ => false,
    });
    pipeline.release();
    pipeline.deinit();

    let encoder = CommandEncoder { raw: c::null<()>() };
    assert(match encoder.finish() {
        Err(Error::Released) => true,
        _ => false,
    });
    let mut encoder = CommandEncoder { raw: c::null<()>() };
    encoder.release();
    encoder.deinit();
}

@test
fn released_queue_surface_and_frame_should_not_cross_the_ffi_boundary() {
    let mut queue = Queue {
        device: c::null<()>(),
        raw: c::null<()>(),
    };
    let commands = CommandBuffer { raw: c::null<()>() };
    assert(match queue.submit(commands) {
        Err(Error::Released) => true,
        _ => false,
    });
    assert(match queue.wait() {
        Err(Error::Released) => true,
        _ => false,
    });
    queue.release();
    queue.deinit();

    let mut surface = Surface {
        instance: c::null<()>(),
        raw: c::null<()>(),
    };
    assert(match surface.acquire() {
        Err(Error::Released) => true,
        _ => false,
    });
    assert(match surface.unconfigure() {
        Err(Error::Released) => true,
        _ => false,
    });
    surface.release();
    surface.deinit();

    let frame = SurfaceFrame {
        surface: c::null<()>(),
        texture: c::null<()>(),
        suboptimal: false,
    };
    assert(match frame.present() {
        Err(Error::Released) => true,
        _ => false,
    });
    let discarded = SurfaceFrame {
        surface: c::null<()>(),
        texture: c::null<()>(),
        suboptimal: false,
    };
    discarded.discard();
}
