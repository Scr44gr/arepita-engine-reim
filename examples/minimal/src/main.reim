from std::alloc import AllocError, general_allocator;
from std::io import println;
from std::string import String;

from arepita_engine::ecs import Component, Entities, Entity, Registry;

@derive(Copy, Component)
struct Position {
    x: f32,
    y: f32,
}

@derive(Copy, Component)
struct Velocity {
    x: f32,
    y: f32,
}

fn movement(
    entity: Entity,
    position: &mut Position,
    reads: (Velocity),
) {
    let _ = entity;
    let velocity = reads.0;
    position.x += velocity.x * 0.5;
    position.y += velocity.y * 0.5;
}

fn spawn_mover(
    entities: &mut Entities,
    registry: &mut Registry<Position, Velocity>,
    position: Position,
    velocity: Velocity,
) -> Result<Entity, AllocError> {
    let entity = match entities.spawn() {
        Ok(value) => value,
        Err(_) => {
            return Err(AllocError::OutOfMemory);
        },
    };
    registry.insert<Position>(entity, position)?;
    registry.insert<Velocity>(entity, velocity)?;
    Ok(entity)
}

fn run() -> Result<i32, AllocError> {
    let allocator = general_allocator();
    let mut entities = Entities::new(&allocator)?;
    defer entities.deinit();

    let registry_result: Result<Registry<Position, Velocity>, AllocError> =
        Registry::new(&allocator);
    let mut registry = registry_result?;
    defer registry.deinit();

    let first = spawn_mover(
        &mut entities,
        &mut registry,
        Position { x: 0.0, y: 0.0 },
        Velocity { x: 3.0, y: -1.0 },
    )?;
    {
        let mut query = match registry.query<Position, Velocity>() {
            Some(value) => value,
            None => {
                return Ok(1);
            },
        };
        let _ = query.for_each(movement);
    };

    let position = match registry.get<Position>(first) {
        Some(value) => value,
        None => {
            return Ok(1);
        },
    };
    let mut message = String::with_capacity(&allocator, 96)?;
    defer message.deinit();
    message.push_format(
        f"entity={first.index()} position=({position.x}, {position.y}) allocated={registry.allocated_bytes()} bytes",
    )?;
    match println(message.as_str()) {
        Ok(_) => {},
        Err(_) => {},
    }

    if position.x == 1.5 && position.y == -0.5 {
        Ok(0)
    } else {
        Ok(2)
    }
}

fn main() -> i32 {
    match run() {
        Ok(code) => code,
        Err(_) => 3,
    }
}
