from std::alloc import general_allocator;
from std::io import println;
from std::string import String;

from arepita_engine::ecs import Component, Entity, Query, SystemPipeline, world;

@derive(Copy, Component)
struct Position {
    x: f32,
    y: f32,
}

@derive(Copy, Component)
struct Velocity {
    x: f32,
    y: f32,
}

fn movement(
    entity: Entity,
    position: &mut Position,
    reads: (Velocity),
) {
    let _ = entity;
    let velocity = reads.0;
    position.x += velocity.x * 0.5;
    position.y += velocity.y * 0.5;
}

fn movement_system(query: &mut Query<Position, Velocity>) {
    let _ = query.for_each(movement);
}

fn run() -> i32 {
    let allocator = general_allocator();
    let mut world = match world<Position, Velocity>(&allocator) {
        Ok(value) => value,
        Err(_) => {
            return 3;
        },
    };
    defer world.deinit();
    let first = match world.spawn() {
        Ok(value) => value,
        Err(_) => {
            return 3;
        },
    };
    let position = Position { x: 0.0, y: 0.0 };
    if match world.insert<Position>(first, position) {
        Ok(_) => false,
        _ => true,
    } {
        return 3;
    }
    let velocity = Velocity { x: 3.0, y: -1.0 };
    if match world.insert<Velocity>(first, velocity) {
        Ok(_) => false,
        _ => true,
    } {
        return 3;
    }

    let movement_system_id = world
        .add_system(movement_system)
        .expect("movement system registration should succeed");
    world.run_pipeline(SystemPipeline::Update);

    let position = match world.get<Position>(first) {
        Some(value) => value,
        None => {
            return 1;
        },
    };
    let mut message = match String::with_capacity(&allocator, 96) {
        Ok(value) => value,
        Err(_) => {
            return 3;
        },
    };
    defer message.deinit();
    if match message.push_format(
        f"entity={first.index()} system={movement_system_id.raw()} position=({position.x}, {position.y}) allocated={world.allocated_bytes()} bytes",
    ) {
        Ok(_) => false,
        Err(_) => true,
    } {
        return 3;
    }
    match println(message.as_str()) {
        Ok(_) => {},
        Err(_) => {},
    }

    if position.x == 1.5 && position.y == -0.5 {
        0
    } else {
        2
    }
}

fn main() -> i32 {
    run()
}
