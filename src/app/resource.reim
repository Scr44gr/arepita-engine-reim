/// Marker for explicit application resources.
pub trait Resource: Send + Sync {}

/// Cleanup contract for resources owned by an ECS `World`.
///
/// Resources that own allocations, threads, or native handles release those
/// values exactly once. Plain value resources provide a no-op implementation.
pub trait ManagedResource: Resource {
    /// Releases all state owned by this resource.
    fn release_resource(&mut self);
}

/// Marker for main-thread resources such as windows, renderers, and audio.
pub trait LocalResource {}

/// Internal static-dispatch contract implemented by typed resource sets.
pub trait ResourceSet {
    /// Borrows one registered resource by its concrete type.
    fn registered_resource<T: ManagedResource>(&self) -> &T;
    /// Exclusively borrows one registered resource by its concrete type.
    fn registered_resource_mut<T: ManagedResource>(&mut self) -> &mut T;
    /// Splits one mutable resource from any number of distinct shared resources.
    fn split_resource_mut<Write: ManagedResource, ...Read: ManagedResource>(
        &mut self,
    ) -> (&mut Write, ...Read => &Read);
    /// Splits any number of distinct resources for exclusive access.
    fn split_resources_mut<...Selected: ManagedResource>(
        &mut self,
    ) -> (...Selected => &mut Selected);
    /// Releases every owned resource in reverse registration order.
    fn release_resources(&mut self);
}

/// A statically typed heterogeneous collection of world resources.
///
/// Resource lookup is a compile-time tuple-field selection. No type IDs,
/// hashing, virtual dispatch, or per-resource allocation is used.
pub struct ResourceRegistry<...Resources: ManagedResource> {
    values: (...Resources),
}

/// Zero-sized resource registry used by a newly created ECS `World`.
pub type EmptyResources = ResourceRegistry<>;

/// Creates a zero-sized registry ready for fluent resource registration.
pub fn empty_resource_registry() -> EmptyResources {
    ResourceRegistry { values: () }
}

/// Creates a typed registry containing one owned resource.
pub fn resource_registry<T: ManagedResource>(value: T) -> ResourceRegistry<T> {
    ResourceRegistry { values: (value,) }
}

impl<...Resources: ManagedResource> ResourceRegistry<...Resources> {
    /// Prepends a resource while moving all existing owners exactly once.
    pub fn prepend<T: ManagedResource>(
        self,
        value: T,
    ) -> ResourceRegistry<T, ...Resources> {
        let values: (T, ...Resources) = (
            value,
            ...Resources => self.values.take_type<Resources>(),
        );
        values.assert_unique_types();
        ResourceRegistry { values: values }
    }

    /// Borrows a registered resource by type.
    pub fn get<T: ManagedResource>(&self) -> &T {
        self.values.get_type<T>()
    }

    /// Exclusively borrows a registered resource by type.
    pub fn get_mut<T: ManagedResource>(&mut self) -> &mut T {
        self.values.get_type_mut<T>()
    }
}

impl<...Resources: ManagedResource> ResourceSet for ResourceRegistry<...Resources> {
    fn registered_resource<T: ManagedResource>(&self) -> &T {
        self.get<T>()
    }

    fn registered_resource_mut<T: ManagedResource>(&mut self) -> &mut T {
        self.get_mut<T>()
    }

    fn split_resource_mut<Write: ManagedResource, ...Read: ManagedResource>(
        &mut self,
    ) -> (&mut Write, ...Read => &Read) {
        self.values.split_type_mut<Write, ...Read => Read>()
    }

    fn split_resources_mut<...Selected: ManagedResource>(
        &mut self,
    ) -> (...Selected => &mut Selected) {
        self.values.split_types_mut<...Selected => Selected>()
    }

    fn release_resources(&mut self) {
        let _ = (
            ...Resources => {
                let resource: &mut Resources =
                    self.values.get_type_mut<Resources>();
                resource.release_resource()
            },
        );
    }
}

/// A typed resource owner with no runtime name lookup.
pub struct ResourceCell<T> {
    value: T,
}

impl<T: Resource> ResourceCell<T> {
    /// Wraps a resource for inclusion in application state.
    pub fn new(value: T) -> ResourceCell<T> {
        ResourceCell { value: value }
    }

    /// Borrows the resource for reading.
    pub fn get(&self) -> &T {
        &self.value
    }

    /// Borrows the resource exclusively.
    pub fn get_mut(&mut self) -> &mut T {
        &mut self.value
    }

    /// Unwraps the resource and transfers ownership to the caller.
    pub fn into_inner(self) -> T {
        self.value
    }
}
