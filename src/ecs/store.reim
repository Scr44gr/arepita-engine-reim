from std::alloc import AllocError, Allocator, ArenaAllocator, general_allocator;
from std::collections import Vec;
import std::slice as slice;

from self::entity import Entities, Entity;

/// Marker implemented by plain data that may live in packed component stores.
///
/// `Copy` keeps swap removal and parallel chunk movement allocation-free.
/// `Send + Sync` allows the scheduler to move disjoint stores between workers.
pub trait Component: Copy + Send + Sync {}

struct EntityIndex {
    sparse: Vec<usize>,
    dense: Vec<Entity>,
}

impl EntityIndex {
    pub fn new(allocator: &Allocator) -> Result<EntityIndex, AllocError> {
        let sparse_result: Result<Vec<usize>, AllocError> = Vec::new(allocator);
        let sparse = sparse_result?;
        let dense_result: Result<Vec<Entity>, AllocError> = Vec::new(allocator);
        let dense = dense_result?;
        Ok(EntityIndex { sparse: sparse, dense: dense })
    }

    pub fn find(&self, entity: Entity) -> Option<usize> {
        let encoded = self.sparse.get(entity.index() as usize)?;
        if encoded == 0 {
            return None;
        }
        let index = encoded - 1;
        match self.dense.get(index) {
            Some(stored) => if stored == entity { Some(index) } else { None },
            None => None,
        }
    }

    pub fn push(&mut self, entity: Entity) -> Result<(), AllocError> {
        let sparse_index = entity.index() as usize;
        while self.sparse.len() <= sparse_index {
            self.sparse.push(0)?;
        }
        let dense_index = self.dense.len();
        self.dense.push(entity)?;
        let _ = self.sparse.set(sparse_index, dense_index + 1);
        Ok(())
    }

    pub fn reserve(
        &mut self,
        additional: usize,
        highest_entity_index: usize,
    ) -> Result<(), AllocError> {
        self.dense.reserve(additional)?;
        let sparse_length = match highest_entity_index.checked_add(1) {
            Some(value) => value,
            None => {
                return Err(AllocError::OutOfMemory);
            },
        };
        if sparse_length > self.sparse.len() {
            self.sparse.reserve(sparse_length - self.sparse.len())?;
            while self.sparse.len() < sparse_length {
                if !self.sparse.push_within_capacity(0) {
                    panic("component sparse reservation became inconsistent")
                }
            }
        }
        Ok(())
    }

    pub fn rollback_last(&mut self, entity: Entity) {
        let _ = self.dense.pop();
        let _ = self.sparse.set(entity.index() as usize, 0);
    }

    pub fn swap_remove(&mut self, entity: Entity, index: usize) {
        let last_index = self.dense.len() - 1;
        if index != last_index {
            let moved = match self.dense.get(last_index) {
                Some(value) => value,
                None => panic("component entity index became inconsistent"),
            };
            let _ = self.dense.set(index, moved);
            let _ = self.sparse.set(moved.index() as usize, index + 1);
        }
        let _ = self.dense.pop();
        let _ = self.sparse.set(entity.index() as usize, 0);
    }

    pub fn as_slice(&self) -> &[Entity] {
        self.dense.as_slice()
    }

    pub fn allocated_bytes(&self) -> usize {
        self.sparse.allocated_bytes() + self.dense.allocated_bytes()
    }

    pub fn release(&mut self) {
        self.sparse.release();
        self.dense.release();
    }
}

struct PackedValues<T> {
    inner: Vec<T>,
}

impl<T: Component> PackedValues<T> {
    pub fn new(allocator: &Allocator) -> Result<PackedValues<T>, AllocError> {
        let created: Result<Vec<T>, AllocError> = Vec::new(allocator);
        let inner = created?;
        Ok(PackedValues { inner: inner })
    }

    pub fn len(&self) -> usize {
        self.inner.len()
    }

    pub fn is_empty(&self) -> bool {
        self.inner.is_empty()
    }

    pub fn get(&self, index: usize) -> Option<T> {
        self.inner.get(index)
    }

    pub fn get_ref(&self, index: usize) -> Option<&T> {
        self.inner.get_ref(index)
    }

    pub fn get_mut(&mut self, index: usize) -> Option<&mut T> {
        self.inner.get_mut(index)
    }

    pub fn set(&mut self, index: usize, value: T) -> bool {
        self.inner.set(index, value)
    }

    pub fn push(&mut self, value: T) -> Result<(), AllocError> {
        self.inner.push(value)
    }

    pub fn reserve(&mut self, additional: usize) -> Result<(), AllocError> {
        self.inner.reserve(additional)
    }

    pub fn pop(&mut self) -> Option<T> {
        self.inner.pop()
    }

    pub fn as_slice(&self) -> &[T] {
        self.inner.as_slice()
    }

    pub fn as_mut_slice(&mut self) -> &mut [T] {
        self.inner.as_mut_slice()
    }

    pub fn allocated_bytes(&self) -> usize {
        self.inner.allocated_bytes()
    }

    pub fn release(&mut self) {
        self.inner.release();
    }
}

/// A packed sparse set for one component type.
///
/// Lookup, replacement, and removal are O(1). Iteration touches contiguous
/// values without allocating query tuples. Removing a value changes dense
/// order by moving the final entry into its slot.
pub struct ComponentStore<T> {
    arena: ArenaAllocator,
    index: EntityIndex,
    values: PackedValues<T>,
    released: bool,
}

impl<T: Component> ComponentStore<T> {
    /// Creates an empty component store.
    pub fn new(allocator: &Allocator) -> Result<ComponentStore<T>, AllocError> {
        let mut arena = ArenaAllocator::init(allocator)?;
        let storage_allocator = arena.allocator_value();
        let index = match EntityIndex::new(&storage_allocator) {
            Ok(value) => value,
            Err(error) => {
                arena.release();
                return Err(error);
            },
        };
        let values_result: Result<PackedValues<T>, AllocError> =
            PackedValues::new(&storage_allocator);
        let values = match values_result {
            Ok(value) => value,
            Err(error) => {
                arena.release();
                return Err(error);
            },
        };
        Ok(ComponentStore {
            arena: arena,
            index: index,
            values: values,
            released: false,
        })
    }

    /// Returns the number of stored components.
    pub fn len(&self) -> usize {
        self.values.len()
    }

    /// Returns whether the store has no components.
    pub fn is_empty(&self) -> bool {
        self.values.is_empty()
    }

    /// Returns bytes reserved for sparse indices, entities, and component data.
    ///
    /// Arena metadata is intentionally excluded, so this value is stable and
    /// useful for comparing component layouts between builds.
    pub fn allocated_bytes(&self) -> usize {
        self.index.allocated_bytes() + self.values.allocated_bytes()
    }

    /// Prepares dense and sparse capacity before a deferred command barrier.
    pub fn reserve(
        &mut self,
        additional: usize,
        highest_entity_index: u32,
    ) -> Result<(), AllocError> {
        if self.released {
            return Err(AllocError::OutOfMemory);
        }
        self.values.reserve(additional)?;
        self.index.reserve(additional, highest_entity_index as usize)
    }

    /// Inserts or replaces an entity's component.
    ///
    /// The previous value is returned when the entity was already present.
    pub fn insert(
        &mut self,
        entity: Entity,
        value: T,
    ) -> Result<Option<T>, AllocError> {
        if self.released {
            return Err(AllocError::OutOfMemory);
        }
        match self.index.find(entity) {
            Some(index) => {
                let previous = self.values.get(index);
                let _ = self.values.set(index, value);
                Ok(previous)
            },
            None => {
                self.index.push(entity)?;
                match self.values.push(value) {
                    Ok(_) => Ok(None),
                    Err(error) => {
                        self.index.rollback_last(entity);
                        Err(error)
                    },
                }
            },
        }
    }

    /// Returns a copied component value for `entity`.
    pub fn get(&self, entity: Entity) -> Option<T> {
        if self.released {
            return None;
        }
        let index = self.index.find(entity)?;
        self.values.get(index)
    }

    /// Borrows a component without copying it.
    pub fn get_ref(&self, entity: Entity) -> Option<&T> {
        if self.released {
            return None;
        }
        let index = self.index.find(entity)?;
        self.values.get_ref(index)
    }

    /// Exclusively borrows a component for in-place mutation.
    pub fn get_mut(&mut self, entity: Entity) -> Option<&mut T> {
        if self.released {
            return None;
        }
        let index = self.index.find(entity)?;
        self.values.get_mut(index)
    }

    /// Replaces an existing component without allocating.
    pub fn set(&mut self, entity: Entity, value: T) -> bool {
        if self.released {
            return false;
        }
        match self.index.find(entity) {
            Some(index) => self.values.set(index, value),
            None => false,
        }
    }

    /// Returns whether `entity` owns this component.
    pub fn contains(&self, entity: Entity) -> bool {
        if self.released {
            return false;
        }
        match self.index.find(entity) {
            Some(_) => true,
            None => false,
        }
    }

    /// Removes and returns a component using swap-remove semantics.
    pub fn remove(&mut self, entity: Entity) -> Option<T> {
        if self.released {
            return None;
        }
        let index = self.index.find(entity)?;
        let last_index = self.values.len() - 1;
        let removed = self.values.get(index)?;
        if index != last_index {
            let moved_value = self.values.get(last_index)?;
            let _ = self.values.set(index, moved_value);
        }
        self.index.swap_remove(entity, index);
        let _ = self.values.pop();
        Some(removed)
    }

    /// Returns packed entity handles in the same order as `values`.
    pub fn entities(&self) -> &[Entity] {
        self.index.as_slice()
    }

    /// Returns the packed read-only component slice.
    pub fn values(&self) -> &[T] {
        self.values.as_slice()
    }

    /// Returns the packed mutable component slice.
    ///
    /// This is the preferred hot-loop and `parallel_for_mut` interface.
    pub fn values_mut(&mut self) -> &mut [T] {
        self.values.as_mut_slice()
    }

    /// Releases sparse and dense storage.
    pub fn deinit(&mut self) {
        if self.released {
            return;
        }
        self.index.release();
        self.values.release();
        self.arena.release();
        self.released = true;
    }

    /// Returns the packed index for an entity, if present.
    pub fn dense_index_of(&self, entity: Entity) -> Option<usize> {
        if self.released {
            return None;
        }
        self.index.find(entity)
    }

    /// Returns the entity at a packed index for allocation-free query drivers.
    pub fn entity_at(&self, index: usize) -> Option<Entity> {
        if self.released {
            return None;
        }
        self.index.dense.get(index)
    }

    /// Mutably borrows a value at a previously validated packed index.
    pub fn value_mut_at(&mut self, index: usize) -> Option<&mut T> {
        if self.released {
            return None;
        }
        self.values.get_mut(index)
    }
}

/// Runs an allocation-free two-component query.
///
/// The mutable store drives iteration, so choose the smaller mutable set when
/// either query orientation is valid. The read component is copied into the
/// callback; components are deliberately compact `Copy` data.
pub fn for_each2_mut<A: Component, B: Component>(
    primary: &mut ComponentStore<A>,
    secondary: &ComponentStore<B>,
    system: fn(Entity, &mut A, B) -> (),
) -> usize {
    let length = primary.len();
    let mut matched: usize = 0;
    let mut index: usize = 0;
    while index < length {
        let entity = match primary.entity_at(index) {
            Some(value) => value,
            None => panic("component entity index became inconsistent"),
        };
        match secondary.get(entity) {
            Some(read_value) => {
                let write_value = match primary.value_mut_at(index) {
                    Some(value) => value,
                    None => panic("component value index became inconsistent"),
                };
                system(entity, write_value, read_value);
                matched += 1;
            },
            None => {},
        }
        index += 1;
    }
    matched
}

@derive(Copy, Component)
struct TestPosition {
    x: f32,
    y: f32,
}

@derive(Copy, Component)
struct TestVelocity {
    x: f32,
    y: f32,
}

fn integrate_test_position(
    entity: Entity,
    position: &mut TestPosition,
    velocity: TestVelocity,
) {
    let _ = entity;
    position.x += velocity.x;
    position.y += velocity.y;
}

@test
fn component_store_should_replace_and_swap_remove_without_stale_hits() {
    let allocator = general_allocator();
    let mut entities = match Entities::new(&allocator) {
        Ok(value) => value,
        Err(_) => panic("entity registry allocation failed"),
    };
    defer entities.deinit();
    let created: Result<ComponentStore<TestPosition>, AllocError> =
        ComponentStore::new(&allocator);
    let mut store = match created {
        Ok(value) => value,
        Err(_) => panic("component store allocation failed"),
    };
    defer store.deinit();

    let first = match entities.spawn() {
        Ok(value) => value,
        Err(_) => panic("first entity spawn failed"),
    };
    let second = match entities.spawn() {
        Ok(value) => value,
        Err(_) => panic("second entity spawn failed"),
    };
    let first_insert = store.insert(first, TestPosition { x: 1.0, y: 2.0 });
    assert(match first_insert {
        Ok(None) => true,
        _ => false,
    });
    let second_insert = store.insert(second, TestPosition { x: 3.0, y: 4.0 });
    assert(match second_insert {
        Ok(None) => true,
        _ => false,
    });
    let replaced = store.insert(first, TestPosition { x: 5.0, y: 6.0 });
    assert(match replaced {
        Ok(Some(value)) => value.x == 1.0,
        _ => false,
    });
    assert(match store.remove(first) {
        Some(_) => true,
        None => false,
    });
    assert(!store.contains(first));
    assert(store.contains(second));
    assert(store.len() == 1);
}

@test
fn component_query_should_join_without_allocating() {
    let allocator = general_allocator();
    let mut entities = match Entities::new(&allocator) {
        Ok(value) => value,
        Err(_) => panic("entity registry allocation failed"),
    };
    defer entities.deinit();
    let position_result: Result<ComponentStore<TestPosition>, AllocError> =
        ComponentStore::new(&allocator);
    let mut positions = match position_result {
        Ok(value) => value,
        Err(_) => panic("position store allocation failed"),
    };
    defer positions.deinit();
    let velocity_result: Result<ComponentStore<TestVelocity>, AllocError> =
        ComponentStore::new(&allocator);
    let mut velocities = match velocity_result {
        Ok(value) => value,
        Err(_) => panic("velocity store allocation failed"),
    };
    defer velocities.deinit();

    let moving = match entities.spawn() {
        Ok(value) => value,
        Err(_) => panic("moving entity spawn failed"),
    };
    let stationary = match entities.spawn() {
        Ok(value) => value,
        Err(_) => panic("stationary entity spawn failed"),
    };
    let moving_position = TestPosition { x: 1.0, y: 2.0 };
    match positions.insert(moving, moving_position) {
        Ok(_) => {},
        Err(_) => panic("moving position insert failed"),
    }
    let stationary_position = TestPosition { x: 5.0, y: 6.0 };
    match positions.insert(stationary, stationary_position) {
        Ok(_) => {},
        Err(_) => panic("stationary position insert failed"),
    }
    let velocity = TestVelocity { x: 3.0, y: 4.0 };
    match velocities.insert(moving, velocity) {
        Ok(_) => {},
        Err(_) => panic("velocity insert failed"),
    }

    let before = positions.allocated_bytes() + velocities.allocated_bytes();
    let matched = for_each2_mut(
        &mut positions,
        &velocities,
        integrate_test_position,
    );
    let after = positions.allocated_bytes() + velocities.allocated_bytes();

    assert(matched == 1);
    assert(before == after);
    assert(match positions.get(moving) {
        Some(value) => value.x == 4.0 && value.y == 6.0,
        None => false,
    });
    assert(match positions.get(stationary) {
        Some(value) => value.x == 5.0 && value.y == 6.0,
        None => false,
    });
}

@test
fn released_component_store_should_expose_empty_slices() {
    let allocator = general_allocator();
    let created: Result<ComponentStore<TestPosition>, AllocError> =
        ComponentStore::new(&allocator);
    let mut store = match created {
        Ok(value) => value,
        Err(_) => panic("component store allocation failed"),
    };
    let mut entities = match Entities::new(&allocator) {
        Ok(value) => value,
        Err(_) => panic("entity registry allocation failed"),
    };
    defer entities.deinit();
    let entity = match entities.spawn() {
        Ok(value) => value,
        Err(_) => panic("entity spawn failed"),
    };
    store.deinit();
    store.deinit();
    assert(store.len() == 0);
    assert(store.allocated_bytes() == 0);
    let position = TestPosition { x: 0.0, y: 0.0 };
    assert(match store.insert(entity, position) {
        Err(AllocError::OutOfMemory) => true,
        _ => false,
    });
    assert(slice::len(store.values()) == 0);
}
