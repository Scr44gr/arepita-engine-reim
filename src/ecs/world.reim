from std::alloc import AllocError, Allocator, general_allocator;

from self::entity import Entities, Entity, EntityError;
from self::query import Query;
from self::registry import ComponentSet, Registry, create_registry;
from self::store import Component, ComponentStore;
from self::system import EmptySystems, QuerySystem, SystemChain, SystemList;
from super::app import ManagedResource, Resource, ResourceRegistry, ResourceSet;
from super::app::resource import ResourceSentinel, resource_registry;

/// Recoverable world lifecycle and storage failures.
@derive(Copy, Clone, Debug, Eq)
pub enum WorldError {
    OutOfMemory,
    EntityCapacityExhausted,
    InvalidEntity,
    Released,
}

/// Owns entity lifecycle and every component store used by an application.
///
/// Gameplay code uses `World` to spawn entities and attach components. The
/// heterogeneous registry remains private, while registered systems borrow
/// the precise stores required by each typed `Query`.
pub struct World<
    Resources: ResourceSet,
    Systems: SystemList,
    Storage: ComponentSet,
> {
    entities: Entities,
    resources: Resources,
    storage: Storage,
    systems: Systems,
    released: bool,
}

impl<
    Resources: ResourceSet,
    Systems: SystemList,
    Storage: ComponentSet,
> World<Resources, Systems, Storage> {
    /// Returns whether the world has released all owned storage.
    pub fn is_released(&self) -> bool {
        self.released
    }

    /// Adds a system whose required query is inferred from its function type.
    ///
    /// The returned world owns the extended static system chain. Calls may be
    /// fluently chained before binding the final world.
    pub fn add_system<Write: Component, ...Read: Component>(
        self,
        system: fn(&mut Query<Write, ...Read>) -> (),
    ) -> World<
        Resources,
        SystemChain<Systems, QuerySystem<Write, ...Read>>,
        Storage
    > {
        World {
            entities: self.entities,
            resources: self.resources,
            storage: self.storage,
            systems: SystemChain::new(
                self.systems,
                QuerySystem::new(system),
            ),
            released: self.released,
        }
    }

    /// Runs all registered systems in insertion order without allocating.
    pub fn run_systems(&mut self) {
        if self.is_released() {
            return;
        }
        self.systems.run_all<Storage>(&mut self.storage);
    }

    /// Borrows a registered resource by type.
    pub fn resource<T: ManagedResource>(&self) -> Option<&T> {
        if self.is_released() {
            return None;
        }
        Some(self.resources.registered_resource<T>())
    }

    /// Exclusively borrows a registered resource by type.
    pub fn resource_mut<T: ManagedResource>(&mut self) -> Option<&mut T> {
        if self.is_released() {
            return None;
        }
        Some(self.resources.registered_resource_mut<T>())
    }

    /// Borrows one resource and constructs one disjoint component query.
    ///
    /// This is the advanced path for systems that need both application state
    /// and packed components before mixed-parameter function injection is used.
    pub fn resource_query<
        T: ManagedResource,
        Write: Component,
        ...Read: Component,
    >(&mut self) -> Option<(&mut T, Query<Write, ...Read>)> {
        if self.is_released() {
            return None;
        }
        let mut parts = (&mut self.resources, &mut self.storage);
        let resource = parts.0.registered_resource_mut<T>();
        let query = match parts.1.component_query<Write, ...Read>() {
            Some(value) => value,
            None => {
                return None;
            },
        };
        Some((resource, query))
    }

    /// Returns the number of live entities.
    pub fn len(&self) -> usize {
        if self.released { 0 } else { self.entities.len() }
    }

    /// Returns whether no entities are alive.
    pub fn is_empty(&self) -> bool {
        self.len() == 0
    }

    /// Allocates or recycles one entity handle.
    pub fn spawn(&mut self) -> Result<Entity, WorldError> {
        if self.is_released() {
            return Err(WorldError::Released);
        }
        match self.entities.spawn() {
            Ok(entity) => Ok(entity),
            Err(EntityError::OutOfMemory) => Err(WorldError::OutOfMemory),
            Err(EntityError::CapacityExhausted) => {
                Err(WorldError::EntityCapacityExhausted)
            },
            _ => Err(WorldError::EntityCapacityExhausted),
        }
    }

    /// Retires an entity and removes every registered component it owns.
    pub fn despawn(&mut self, entity: Entity) -> Result<bool, WorldError> {
        if self.is_released() {
            return Err(WorldError::Released);
        }
        let removed = match self.entities.despawn(entity) {
            Ok(value) => value,
            Err(EntityError::OutOfMemory) => {
                return Err(WorldError::OutOfMemory);
            },
            Err(EntityError::CapacityExhausted) => {
                return Err(WorldError::EntityCapacityExhausted);
            },
            _ => {
                return Err(WorldError::EntityCapacityExhausted);
            },
        };
        if removed {
            self.storage.remove_entity_components(entity);
        }
        Ok(removed)
    }

    /// Returns whether an entity handle is alive in this world.
    pub fn contains_entity(&self, entity: Entity) -> bool {
        !self.released && self.entities.contains(entity)
    }

    /// Inserts or replaces a component on a live entity.
    pub fn insert<T: Component>(
        &mut self,
        entity: Entity,
        value: T,
    ) -> Result<Option<T>, WorldError> {
        if self.is_released() {
            return Err(WorldError::Released);
        }
        if !self.entities.contains(entity) {
            return Err(WorldError::InvalidEntity);
        }
        match self.storage.insert_component<T>(entity, value) {
            Ok(previous) => Ok(previous),
            Err(_) => Err(WorldError::OutOfMemory),
        }
    }

    /// Returns a copied component for a live entity.
    pub fn get<T: Component>(&self, entity: Entity) -> Option<T> {
        if !self.contains_entity(entity) {
            return None;
        }
        self.storage.component<T>(entity)
    }

    /// Borrows a component for a live entity.
    pub fn get_ref<T: Component>(&self, entity: Entity) -> Option<&T> {
        if !self.contains_entity(entity) {
            return None;
        }
        self.storage.component_ref<T>(entity)
    }

    /// Exclusively borrows a component for a live entity.
    pub fn get_mut<T: Component>(&mut self, entity: Entity) -> Option<&mut T> {
        if !self.contains_entity(entity) {
            return None;
        }
        self.storage.component_mut<T>(entity)
    }

    /// Returns whether a live entity owns a component.
    pub fn contains<T: Component>(&self, entity: Entity) -> bool {
        self.contains_entity(entity) && self.storage.contains_component<T>(entity)
    }

    /// Removes and returns one component from a live entity.
    pub fn remove<T: Component>(&mut self, entity: Entity) -> Option<T> {
        if !self.contains_entity(entity) {
            return None;
        }
        self.storage.remove_component<T>(entity)
    }

    /// Creates a typed query for an advanced custom runner.
    ///
    /// Normal gameplay systems receive this query automatically after being
    /// registered with `World::add_system`.
    pub fn query<Write: Component, ...Read: Component>(
        &mut self,
    ) -> Option<Query<Write, ...Read>> {
        if self.is_released() {
            return None;
        }
        self.storage.component_query<Write, ...Read>()
    }

    /// Returns a registered component store for packed or parallel work.
    pub fn store<T: Component>(&self) -> Option<&ComponentStore<T>> {
        if self.is_released() {
            return None;
        }
        self.storage.component_store<T>()
    }

    /// Returns a registered component store for packed or parallel mutation.
    pub fn store_mut<T: Component>(&mut self) -> Option<&mut ComponentStore<T>> {
        if self.is_released() {
            return None;
        }
        self.storage.component_store_mut<T>()
    }

    /// Returns bytes reserved by entity and component storage.
    pub fn allocated_bytes(&self) -> usize {
        if self.is_released() {
            return 0;
        }
        self.entities.allocated_bytes() + self.storage.component_allocated_bytes()
    }

    /// Releases entity and component storage exactly once.
    pub fn deinit(&mut self) {
        if self.is_released() {
            return;
        }
        self.resources.release_resources();
        self.storage.release_components();
        self.entities.deinit();
        self.released = true;
    }
}

impl<
    Systems: SystemList,
    Storage: ComponentSet,
    ...Resources: ManagedResource,
> World<ResourceRegistry<...Resources>, Systems, Storage> {
    /// Adds a typed resource and transfers its ownership to the world.
    pub fn add_resource<T: ManagedResource>(
        self,
        value: T,
    ) -> World<ResourceRegistry<T, ...Resources>, Systems, Storage> {
        World {
            entities: self.entities,
            resources: self.resources.prepend(value),
            storage: self.storage,
            systems: self.systems,
            released: self.released,
        }
    }

}

/// Creates an empty world whose component set is fixed at compile time.
pub fn world<...Components: Component>(
    allocator: &Allocator,
) -> Result<
    World<
        ResourceRegistry<ResourceSentinel>,
        EmptySystems,
        Registry<...Components>
    >,
    WorldError
> {
    let entities_result: Result<Entities, AllocError> = Entities::new(allocator);
    let mut entities = match entities_result {
        Ok(value) => value,
        Err(_) => {
            return Err(WorldError::OutOfMemory);
        },
    };
    let registry_result: Result<Registry<...Components>, AllocError> =
        create_registry<...Components>(allocator);
    let component_registry = match registry_result {
        Ok(value) => value,
        Err(_) => {
            entities.deinit();
            return Err(WorldError::OutOfMemory);
        },
    };
    Ok(World {
        entities: entities,
        resources: resource_registry(ResourceSentinel {}),
        storage: component_registry,
        systems: EmptySystems {},
        released: false,
    })
}

@derive(Copy, Component)
struct WorldPosition {
    x: i32,
}

@derive(Copy, Component)
struct WorldVelocity {
    x: i32,
}

@derive(Copy, Resource)
struct WorldScore {
    value: i32,
}

impl ManagedResource for WorldScore {
    fn release_resource(&mut self) {
        let _ = self;
    }
}

fn integrate_world_position(
    entity: Entity,
    position: &mut WorldPosition,
    reads: (WorldVelocity),
) {
    let _ = entity;
    position.x += reads.0.x;
}

fn movement_system(query: &mut Query<WorldPosition, WorldVelocity>) {
    let _ = query.for_each(integrate_world_position);
}

@test
fn world_should_reject_components_for_stale_entities() {
    let allocator = general_allocator();
    let created: Result<
        World<
            ResourceRegistry<ResourceSentinel>,
            EmptySystems,
            Registry<WorldPosition>
        >,
        WorldError
    > =
        world<WorldPosition>(&allocator);
    let mut world = match created {
        Ok(value) => value,
        Err(_) => panic("world allocation should succeed"),
    };
    defer world.deinit();
    let entity = match world.spawn() {
        Ok(value) => value,
        Err(_) => panic("entity spawn should succeed"),
    };
    assert(match world.despawn(entity) {
        Ok(true) => true,
        _ => false,
    });
    let position = WorldPosition { x: 42 };
    assert(match world.insert<WorldPosition>(entity, position) {
        Err(WorldError::InvalidEntity) => true,
        _ => false,
    });
}

@test
fn world_should_inject_queries_into_registered_systems() {
    let allocator = general_allocator();
    let created: Result<
        World<
            ResourceRegistry<ResourceSentinel>,
            EmptySystems,
            Registry<WorldPosition, WorldVelocity>
        >,
        WorldError
    > = world<WorldPosition, WorldVelocity>(&allocator);
    let mut world = match created {
        Ok(value) => value,
        Err(_) => panic("world allocation should succeed"),
    };
    let entity = match world.spawn() {
        Ok(value) => value,
        Err(_) => panic("entity spawn should succeed"),
    };
    let position = WorldPosition { x: 40 };
    assert(match world.insert<WorldPosition>(entity, position) {
        Ok(_) => true,
        _ => false,
    });
    let velocity = WorldVelocity { x: 1 };
    assert(match world.insert<WorldVelocity>(entity, velocity) {
        Ok(_) => true,
        _ => false,
    });

    let mut world = world
        .add_system(movement_system)
        .add_system(movement_system);
    defer world.deinit();
    world.run_systems();

    assert(match world.get<WorldPosition>(entity) {
        Some(position) => position.x == 42,
        None => false,
    });
}

@test
fn world_should_own_typed_resources_across_system_registration() {
    let allocator = general_allocator();
    let created: Result<
        World<
            ResourceRegistry<ResourceSentinel>,
            EmptySystems,
            Registry<WorldPosition, WorldVelocity>
        >,
        WorldError
    > = world<WorldPosition, WorldVelocity>(&allocator);
    let world = match created {
        Ok(value) => value,
        Err(_) => panic("world allocation should succeed"),
    };
    let world = world
        .add_system(movement_system)
        .add_resource(WorldScore { value: 40 });
    let mut world = world.add_system(movement_system);
    defer world.deinit();

    {
        let mut joined = match world.resource_query<
            WorldScore,
            WorldPosition,
            WorldVelocity,
        >() {
            Some(value) => value,
            None => panic("resource query should be available"),
        };
        joined.0.value += 1;
    };
    {
        match world.resource_mut<WorldScore>() {
            Some(score) => score.value += 1,
            None => panic("registered score resource should exist"),
        }
    };
    assert(match world.resource<WorldScore>() {
        Some(score) => score.value == 42,
        None => false,
    });
}
