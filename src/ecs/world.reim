from std::alloc import AllocError, Allocator, general_allocator;

from self::entity import Entities, Entity, EntityError;
from self::query import Query;
from self::registry import ComponentSet, Registry, create_registry;
from self::store import Component, ComponentStore;
from self::system import System, SystemId, SystemRegistry, SystemRegistryError;
from super::app import EmptyResources, ManagedResource, PipelineState, Resource, ResourceRegistry, ResourceSet, SystemPipeline;
from super::app::resource import empty_resource_registry, resource_registry;

/// Recoverable world lifecycle and storage failures.
@derive(Copy, Clone, Debug, Eq)
pub enum WorldError {
    OutOfMemory,
    EntityCapacityExhausted,
    SystemCapacityExhausted,
    InvalidEntity,
    Released,
}

/// Owns entity lifecycle and every component store used by an application.
///
/// Gameplay code uses `World` to spawn entities and attach components. The
/// heterogeneous registry remains private, while registered systems borrow
/// the precise stores required by each typed `Query`.
pub struct World<
    Resources: ResourceSet,
    Storage: ComponentSet,
> {
    entities: Entities,
    resources: Resources,
    storage: Storage,
    systems: SystemRegistry<Resources, Storage>,
    released: bool,
}

impl<
    Resources: ResourceSet,
    Storage: ComponentSet,
> World<Resources, Storage> {
    /// Returns whether the world has released all owned storage.
    pub fn is_released(&self) -> bool {
        self.released
    }

    /// Adds an Update system whose required query is inferred from its type.
    ///
    /// Registration keeps the world's concrete type stable and returns a
    /// monotonic ID that can later enable, disable, or remove the system.
    pub fn add_system<Current: System>(
        &mut self,
        system: Current,
    ) -> Result<SystemId, WorldError> {
        self.add_system_to(SystemPipeline::Update, system)
    }

    /// Installs one cohesive feature without exposing scheduler storage.
    ///
    /// The plugin receives this existing mutable world, so registration keeps
    /// the world's concrete type and ownership unchanged.
    pub fn add_plugin(
        &mut self,
        plugin: fn(&mut World<Resources, Storage>) -> Result<(), WorldError>,
    ) -> Result<(), WorldError> {
        if self.is_released() {
            return Err(WorldError::Released);
        }
        plugin(self)
    }

    /// Installs an ordered fixed set of cohesive features without allocating.
    ///
    /// Installation stops at the first error. Systems registered by earlier
    /// plugins remain installed, matching repeated `add_plugin` calls.
    pub fn add_plugins<const N: usize>(
        &mut self,
        plugins: [fn(&mut World<Resources, Storage>) -> Result<(), WorldError>; N],
    ) -> Result<(), WorldError> {
        if self.is_released() {
            return Err(WorldError::Released);
        }
        let mut index: usize = 0;
        while index < N {
            plugins[index](self)?;
            index += 1;
        }
        Ok(())
    }

    /// Adds a system to an explicit engine pipeline.
    pub fn add_system_to<Current: System>(
        &mut self,
        pipeline: SystemPipeline,
        system: Current,
    ) -> Result<SystemId, WorldError> {
        if self.is_released() {
            return Err(WorldError::Released);
        }
        match self.systems.add(pipeline, system) {
            Ok(id) => Ok(id),
            Err(SystemRegistryError::OutOfMemory) => Err(WorldError::OutOfMemory),
            Err(SystemRegistryError::IdExhausted) => {
                Err(WorldError::SystemCapacityExhausted)
            },
            Err(SystemRegistryError::Released) => Err(WorldError::Released),
            _ => Err(WorldError::OutOfMemory),
        }
    }

    /// Reserves room for additional systems in one execution pipeline.
    ///
    /// Capacity planning is allocation-only: it does not register systems,
    /// consume IDs, or change execution order.
    pub fn reserve_systems(
        &mut self,
        pipeline: SystemPipeline,
        additional: usize,
    ) -> Result<(), WorldError> {
        if self.is_released() {
            return Err(WorldError::Released);
        }
        match self.systems.reserve(pipeline, additional) {
            Ok(_) => Ok(()),
            Err(SystemRegistryError::OutOfMemory) => Err(WorldError::OutOfMemory),
            Err(SystemRegistryError::IdExhausted) => {
                Err(WorldError::SystemCapacityExhausted)
            },
            Err(SystemRegistryError::Released) => Err(WorldError::Released),
            _ => Err(WorldError::OutOfMemory),
        }
    }

    /// Enables or disables one registered system without changing its order.
    pub fn set_system_enabled(&mut self, id: SystemId, enabled: bool) -> bool {
        !self.is_released() && self.systems.set_enabled(id, enabled)
    }

    /// Removes one registered system while preserving survivor order.
    pub fn remove_system(&mut self, id: SystemId) -> bool {
        !self.is_released() && self.systems.remove(id)
    }

    /// Returns the number of systems registered in every pipeline.
    pub fn system_count(&self) -> usize {
        if self.is_released() { 0 } else { self.systems.len() }
    }

    /// Runs one engine pipeline in registration order without allocating.
    pub fn run_pipeline(&mut self, pipeline: SystemPipeline) {
        if self.is_released() {
            return;
        }
        self.systems.run_pipeline(
            pipeline,
            &mut self.entities,
            &mut self.resources,
            &mut self.storage,
        );
    }

    /// Borrows a registered resource by type.
    pub fn resource<T: ManagedResource>(&self) -> Option<&T> {
        if self.is_released() {
            return None;
        }
        Some(self.resources.registered_resource<T>())
    }

    /// Exclusively borrows a registered resource by type.
    pub fn resource_mut<T: ManagedResource>(&mut self) -> Option<&mut T> {
        if self.is_released() {
            return None;
        }
        Some(self.resources.registered_resource_mut<T>())
    }

    /// Exclusively borrows several distinct resources in one static split.
    pub fn resources_mut<...Selected: ManagedResource>(
        &mut self,
    ) -> Option<(...Selected => &mut Selected)> {
        if self.is_released() {
            return None;
        }
        Some(self.resources.split_resources_mut<...Selected>())
    }

    /// Borrows one resource and constructs one disjoint component query.
    ///
    /// This is the advanced path for systems that need both application state
    /// and packed components before mixed-parameter function injection is used.
    pub fn resource_query<
        T: ManagedResource,
        Write: Component,
        ...Read: Component,
    >(&mut self) -> Option<(&mut T, Query<Write, ...Read>)> {
        if self.is_released() {
            return None;
        }
        let mut parts = (&mut self.resources, &mut self.storage);
        let resource = parts.0.registered_resource_mut<T>();
        let query = match parts.1.component_query<Write, ...Read>() {
            Some(value) => value,
            None => {
                return None;
            },
        };
        Some((resource, query))
    }

    /// Returns the number of live entities.
    pub fn len(&self) -> usize {
        if self.released { 0 } else { self.entities.len() }
    }

    /// Returns whether no entities are alive.
    pub fn is_empty(&self) -> bool {
        self.len() == 0
    }

    /// Allocates or recycles one entity handle.
    pub fn spawn(&mut self) -> Result<Entity, WorldError> {
        if self.is_released() {
            return Err(WorldError::Released);
        }
        match self.entities.spawn() {
            Ok(entity) => Ok(entity),
            Err(EntityError::OutOfMemory) => Err(WorldError::OutOfMemory),
            Err(EntityError::CapacityExhausted) => {
                Err(WorldError::EntityCapacityExhausted)
            },
            _ => Err(WorldError::EntityCapacityExhausted),
        }
    }

    /// Retires an entity and removes every registered component it owns.
    pub fn despawn(&mut self, entity: Entity) -> Result<bool, WorldError> {
        if self.is_released() {
            return Err(WorldError::Released);
        }
        let removed = match self.entities.despawn(entity) {
            Ok(value) => value,
            Err(EntityError::OutOfMemory) => {
                return Err(WorldError::OutOfMemory);
            },
            Err(EntityError::CapacityExhausted) => {
                return Err(WorldError::EntityCapacityExhausted);
            },
            _ => {
                return Err(WorldError::EntityCapacityExhausted);
            },
        };
        if removed {
            self.storage.remove_entity_components(entity);
        }
        Ok(removed)
    }

    /// Returns whether an entity handle is alive in this world.
    pub fn contains_entity(&self, entity: Entity) -> bool {
        !self.released && self.entities.contains(entity)
    }

    /// Inserts or replaces a component on a live entity.
    pub fn insert<T: Component>(
        &mut self,
        entity: Entity,
        value: T,
    ) -> Result<Option<T>, WorldError> {
        if self.is_released() {
            return Err(WorldError::Released);
        }
        if !self.entities.contains(entity) {
            return Err(WorldError::InvalidEntity);
        }
        match self.storage.insert_component<T>(entity, value) {
            Ok(previous) => Ok(previous),
            Err(_) => Err(WorldError::OutOfMemory),
        }
    }

    /// Inserts a heterogeneous component bundle after reserving every store.
    ///
    /// Values are selected by type rather than tuple position. No component is
    /// written when any reservation fails, so callers never observe a partial
    /// bundle after a recoverable allocation error.
    pub fn insert_bundle<...Selected: Component>(
        &mut self,
        entity: Entity,
        values: (...Selected),
    ) -> Result<(), WorldError> {
        if self.is_released() {
            return Err(WorldError::Released);
        }
        if !self.entities.contains(entity) {
            return Err(WorldError::InvalidEntity);
        }
        values.assert_unique_types();
        let reservations = [
            ...Selected => {
                match self.storage.reserve_component<Selected>(entity) {
                    Ok(_) => true,
                    Err(_) => false,
                }
            },
        ];
        for reserved in reservations {
            if !reserved { return Err(WorldError::OutOfMemory); }
        }
        let insertions = [
            ...Selected => {
                let value = *values.get_type<Selected>();
                match self.storage.insert_component<Selected>(entity, value) {
                    Ok(_) => true,
                    Err(_) => false,
                }
            },
        ];
        for inserted in insertions {
            if !inserted {
                panic("reserved component insertion became inconsistent")
            }
        }
        Ok(())
    }

    /// Spawns an entity and attaches a complete typed bundle atomically.
    pub fn spawn_bundle<...Selected: Component>(
        &mut self,
        values: (...Selected),
    ) -> Result<Entity, WorldError> {
        let entity = self.spawn()?;
        match self.insert_bundle<...Selected>(entity, values) {
            Ok(_) => Ok(entity),
            Err(error) => {
                let _ = self.despawn(entity);
                Err(error)
            },
        }
    }

    /// Returns a copied component for a live entity.
    pub fn get<T: Component>(&self, entity: Entity) -> Option<T> {
        if !self.contains_entity(entity) {
            return None;
        }
        self.storage.component<T>(entity)
    }

    /// Borrows a component for a live entity.
    pub fn get_ref<T: Component>(&self, entity: Entity) -> Option<&T> {
        if !self.contains_entity(entity) {
            return None;
        }
        self.storage.component_ref<T>(entity)
    }

    /// Exclusively borrows a component for a live entity.
    pub fn get_mut<T: Component>(&mut self, entity: Entity) -> Option<&mut T> {
        if !self.contains_entity(entity) {
            return None;
        }
        self.storage.component_mut<T>(entity)
    }

    /// Returns whether a live entity owns a component.
    pub fn contains<T: Component>(&self, entity: Entity) -> bool {
        self.contains_entity(entity) && self.storage.contains_component<T>(entity)
    }

    /// Removes and returns one component from a live entity.
    pub fn remove<T: Component>(&mut self, entity: Entity) -> Option<T> {
        if !self.contains_entity(entity) {
            return None;
        }
        self.storage.remove_component<T>(entity)
    }

    /// Creates a typed query for an advanced custom runner.
    ///
    /// Normal gameplay systems receive this query automatically after being
    /// registered with `World::add_system`.
    pub fn query<Write: Component, ...Read: Component>(
        &mut self,
    ) -> Option<Query<Write, ...Read>> {
        if self.is_released() {
            return None;
        }
        self.storage.component_query<Write, ...Read>()
    }

    /// Returns a registered component store for packed or parallel work.
    pub fn store<T: Component>(&self) -> Option<&ComponentStore<T>> {
        if self.is_released() {
            return None;
        }
        self.storage.component_store<T>()
    }

    /// Returns a registered component store for packed or parallel mutation.
    pub fn store_mut<T: Component>(&mut self) -> Option<&mut ComponentStore<T>> {
        if self.is_released() {
            return None;
        }
        self.storage.component_store_mut<T>()
    }

    /// Returns bytes reserved by entity and component storage.
    pub fn allocated_bytes(&self) -> usize {
        if self.is_released() {
            return 0;
        }
        self.entities.allocated_bytes()
            + self.storage.component_allocated_bytes()
            + self.systems.allocated_bytes()
    }

    /// Releases entity and component storage exactly once.
    pub fn deinit(&mut self) {
        if self.is_released() {
            return;
        }
        self.systems.release();
        self.resources.release_resources();
        self.storage.release_components();
        self.entities.deinit();
        self.released = true;
    }
}

impl<
    Resources: ResourceSet,
    Storage: ComponentSet,
> PipelineState for World<Resources, Storage> {
    fn execute_pipeline(&mut self, pipeline: SystemPipeline) {
        World::run_pipeline(self, pipeline);
    }
}

/// Creates an empty world whose component set is fixed at compile time.
///
/// Omitting generic arguments collects concrete `@derive(Component)` types
/// from the root package. Explicit arguments remain available for isolated
/// worlds and focused tests.
pub fn world<...Components: Component>(
    allocator: &Allocator,
) -> Result<
    World<
        EmptyResources,
        Registry<...Components>
    >,
    WorldError
> {
    world_with_resources<EmptyResources, ...Components>(
        allocator,
        empty_resource_registry(),
    )
}

/// Creates a world from one complete resource registry.
///
/// Resources become part of the world in one move. Systems can then be added
/// through `&mut World` without changing the world's concrete type.
pub fn world_with_resources<
    Resources: ResourceSet,
    ...Components: Component,
>(
    allocator: &Allocator,
    resources: Resources,
) -> Result<World<Resources, Registry<...Components>>, WorldError> {
    let mut resources = resources;
    let entities_result: Result<Entities, AllocError> = Entities::new(allocator);
    let mut entities = match entities_result {
        Ok(value) => value,
        Err(_) => {
            resources.release_resources();
            return Err(WorldError::OutOfMemory);
        },
    };
    let registry_result: Result<Registry<...Components>, AllocError> =
        create_registry<...Components>(allocator);
    let mut component_registry = match registry_result {
        Ok(value) => value,
        Err(_) => {
            entities.deinit();
            resources.release_resources();
            return Err(WorldError::OutOfMemory);
        },
    };
    let systems_result: Result<
        SystemRegistry<Resources, Registry<...Components>>,
        SystemRegistryError
    > = SystemRegistry::new(allocator);
    let systems = match systems_result {
        Ok(value) => value,
        Err(SystemRegistryError::IdExhausted) => {
            component_registry.release_components();
            entities.deinit();
            resources.release_resources();
            return Err(WorldError::SystemCapacityExhausted);
        },
        Err(_) => {
            component_registry.release_components();
            entities.deinit();
            resources.release_resources();
            return Err(WorldError::OutOfMemory);
        },
    };
    Ok(World {
        entities: entities,
        resources: resources,
        storage: component_registry,
        systems: systems,
        released: false,
    })
}

@derive(Copy, Component)
struct WorldPosition {
    x: i32,
}

@derive(Copy, Component)
struct WorldVelocity {
    x: i32,
}

@derive(Copy, Resource)
struct WorldScore {
    value: i32,
}

impl ManagedResource for WorldScore {
    fn release_resource(&mut self) {
        let _ = self;
    }
}

fn integrate_world_position(
    entity: Entity,
    position: &mut WorldPosition,
    reads: (WorldVelocity),
) {
    let _ = entity;
    position.x += reads.0.x;
}

fn movement_system(query: &mut Query<WorldPosition, WorldVelocity>) {
    let _ = query.for_each(integrate_world_position);
}

fn scored_movement_system(
    score: &mut WorldScore,
    query: &mut Query<WorldPosition, WorldVelocity>,
) {
    score.value += 1;
    movement_system(query);
}

fn record_first_system(score: &mut WorldScore) {
    score.value = score.value * 10 + 1;
}

fn record_second_system(score: &mut WorldScore) {
    score.value = score.value * 10 + 2;
}

type WorldTestState = World<
    ResourceRegistry<WorldScore>,
    Registry<WorldPosition>
>;

fn ordered_world_test_plugin(world: &mut WorldTestState) -> Result<(), WorldError> {
    world.add_system(record_first_system)?;
    world.add_system(record_second_system)?;
    Ok(())
}

fn first_world_test_plugin(world: &mut WorldTestState) -> Result<(), WorldError> {
    world.add_system(record_first_system)?;
    Ok(())
}

fn second_world_test_plugin(world: &mut WorldTestState) -> Result<(), WorldError> {
    world.add_system(record_second_system)?;
    Ok(())
}

fn world_score_equals(
    world: &WorldTestState,
    expected: i32,
) -> bool {
    match world.resource<WorldScore>() {
        Some(score) => score.value == expected,
        None => false,
    }
}

@test
fn world_should_install_plugins_in_declared_order() {
    let allocator = general_allocator();
    let created: Result<WorldTestState, WorldError> = world_with_resources<
        ResourceRegistry<WorldScore>,
        WorldPosition,
    >(
        &allocator,
        resource_registry(WorldScore { value: 0 }),
    );
    let mut world = created.expect("world allocation should succeed");
    defer world.deinit();

    world
        .add_plugin(ordered_world_test_plugin)
        .expect("plugin installation should succeed");

    assert(world.system_count() == 2);
    world.run_pipeline(SystemPipeline::Update);
    assert(world_score_equals(&world, 12));
}

@test
fn world_should_install_an_ordered_plugin_collection() {
    let allocator = general_allocator();
    let created: Result<WorldTestState, WorldError> = world_with_resources<
        ResourceRegistry<WorldScore>,
        WorldPosition,
    >(
        &allocator,
        resource_registry(WorldScore { value: 0 }),
    );
    let mut world = created.expect("world allocation should succeed");
    defer world.deinit();

    let plugins: [fn(&mut WorldTestState) -> Result<(), WorldError>; 2] =
        [first_world_test_plugin, second_world_test_plugin];
    world
        .add_plugins(plugins)
        .expect("plugin collection installation should succeed");

    world.run_pipeline(SystemPipeline::Update);
    assert(world_score_equals(&world, 12));
}

@test
fn world_should_reject_components_for_stale_entities() {
    let allocator = general_allocator();
    let created: Result<
        World<
            EmptyResources,
            Registry<WorldPosition>
        >,
        WorldError
    > =
        world<WorldPosition>(&allocator);
    let mut world = match created {
        Ok(value) => value,
        Err(_) => panic("world allocation should succeed"),
    };
    defer world.deinit();
    let entity = match world.spawn() {
        Ok(value) => value,
        Err(_) => panic("entity spawn should succeed"),
    };
    assert(match world.despawn(entity) {
        Ok(true) => true,
        _ => false,
    });
    let position = WorldPosition { x: 42 };
    assert(match world.insert<WorldPosition>(entity, position) {
        Err(WorldError::InvalidEntity) => true,
        _ => false,
    });
}

@test
fn world_should_spawn_complete_typed_bundles() {
    let allocator = general_allocator();
    let created: Result<
        World<
            EmptyResources,
            Registry<WorldPosition, WorldVelocity>
        >,
        WorldError
    > = world<WorldPosition, WorldVelocity>(&allocator);
    let mut world = match created {
        Ok(value) => value,
        Err(_) => panic("world allocation should succeed"),
    };
    defer world.deinit();

    let position = WorldPosition { x: 40 };
    let velocity = WorldVelocity { x: 2 };
    let entity = match world.spawn_bundle((position, velocity)) {
        Ok(value) => value,
        Err(_) => panic("typed bundle spawn should succeed"),
    };
    assert(world.len() == 1);
    assert(match world.get<WorldPosition>(entity) {
        Some(value) => value.x == 40,
        None => false,
    });
    assert(match world.get<WorldVelocity>(entity) {
        Some(value) => value.x == 2,
        None => false,
    });
}

@test
fn world_should_inject_queries_into_registered_systems() {
    let allocator = general_allocator();
    let created: Result<
        World<
            EmptyResources,
            Registry<WorldPosition, WorldVelocity>
        >,
        WorldError
    > = world<WorldPosition, WorldVelocity>(&allocator);
    let mut world = match created {
        Ok(value) => value,
        Err(_) => panic("world allocation should succeed"),
    };
    let entity = match world.spawn() {
        Ok(value) => value,
        Err(_) => panic("entity spawn should succeed"),
    };
    let position = WorldPosition { x: 40 };
    assert(match world.insert<WorldPosition>(entity, position) {
        Ok(_) => true,
        _ => false,
    });
    let velocity = WorldVelocity { x: 1 };
    assert(match world.insert<WorldVelocity>(entity, velocity) {
        Ok(_) => true,
        _ => false,
    });

    let first = world
        .add_system(movement_system)
        .expect("first movement system registration should succeed");
    let render = world
        .add_system_to(SystemPipeline::Render, movement_system)
        .expect("render movement system registration should succeed");
    let second = world
        .add_system(movement_system)
        .expect("second movement system registration should succeed");
    defer world.deinit();
    assert(first.raw() < render.raw() && render.raw() < second.raw());
    world.run_pipeline(SystemPipeline::Update);

    assert(match world.get<WorldPosition>(entity) {
        Some(position) => position.x == 42,
        None => false,
    });
    world.run_pipeline(SystemPipeline::Render);
    assert(match world.get<WorldPosition>(entity) {
        Some(position) => position.x == 43,
        None => false,
    });
}

@test
fn world_should_own_typed_resources_across_system_registration() {
    let allocator = general_allocator();
    let created: Result<
        World<
            ResourceRegistry<WorldScore>,
            Registry<WorldPosition, WorldVelocity>
        >,
        WorldError
    > = world_with_resources<
        ResourceRegistry<WorldScore>,
        WorldPosition,
        WorldVelocity,
    >(
        &allocator,
        resource_registry(WorldScore { value: 40 }),
    );
    let mut world = match created {
        Ok(value) => value,
        Err(_) => panic("world allocation should succeed"),
    };
    world
        .add_system(scored_movement_system)
        .expect("first scored system registration should succeed");
    world
        .add_system(scored_movement_system)
        .expect("second scored system registration should succeed");
    defer world.deinit();
    world.run_pipeline(SystemPipeline::Update);
    assert(match world.resource<WorldScore>() {
        Some(score) => score.value == 42,
        None => false,
    });
}

@test
fn world_should_manage_registered_systems_by_stable_id() {
    let allocator = general_allocator();
    let created: Result<
        World<ResourceRegistry<WorldScore>, Registry<WorldPosition>>,
        WorldError
    > = world_with_resources<ResourceRegistry<WorldScore>, WorldPosition>(
        &allocator,
        resource_registry(WorldScore { value: 0 }),
    );
    let mut world = created.expect("world allocation should succeed");
    defer world.deinit();

    let first = world
        .add_system(record_first_system)
        .expect("first system registration should succeed");
    let second = world
        .add_system(record_second_system)
        .expect("second system registration should succeed");

    assert(first.raw() == 0 && second.raw() == 1);
    assert(world.system_count() == 2);
    world.run_pipeline(SystemPipeline::Update);
    assert(world_score_equals(&world, 12));

    assert(world.set_system_enabled(first, false));
    world.run_pipeline(SystemPipeline::Update);
    assert(world_score_equals(&world, 122));

    assert(world.set_system_enabled(first, true));
    assert(world.remove_system(second));
    assert(!world.remove_system(second));
    assert(world.system_count() == 1);
    world.run_pipeline(SystemPipeline::Update);
    assert(world_score_equals(&world, 1221));

    let replacement = world
        .add_system(record_second_system)
        .expect("replacement system registration should succeed");
    assert(replacement.raw() == 2);
    world.run_pipeline(SystemPipeline::Update);
    assert(world_score_equals(&world, 122112));
}

@test
fn system_ids_should_reject_foreign_and_replacement_worlds() {
    let allocator = general_allocator();
    let first_created: Result<
        World<ResourceRegistry<WorldScore>, Registry<WorldPosition>>,
        WorldError
    > = world_with_resources<ResourceRegistry<WorldScore>, WorldPosition>(
        &allocator,
        resource_registry(WorldScore { value: 0 }),
    );
    let second_created: Result<
        World<ResourceRegistry<WorldScore>, Registry<WorldPosition>>,
        WorldError
    > = world_with_resources<ResourceRegistry<WorldScore>, WorldPosition>(
        &allocator,
        resource_registry(WorldScore { value: 0 }),
    );
    let mut first_world = first_created.expect("first world should allocate");
    let mut second_world = second_created.expect("second world should allocate");
    defer first_world.deinit();
    defer second_world.deinit();

    let first_id = first_world
        .add_system(record_first_system)
        .expect("first world system should register");
    let second_id = second_world
        .add_system(record_first_system)
        .expect("second world system should register");

    assert(first_id.raw() == 0 && second_id.raw() == 0);
    assert(first_id != second_id);
    assert(!first_world.set_system_enabled(second_id, false));
    assert(!second_world.remove_system(first_id));
    first_world.run_pipeline(SystemPipeline::Update);
    second_world.run_pipeline(SystemPipeline::Update);
    assert(world_score_equals(&first_world, 1));
    assert(world_score_equals(&second_world, 1));

    first_world.deinit();
    let replacement_created: Result<
        World<ResourceRegistry<WorldScore>, Registry<WorldPosition>>,
        WorldError
    > = world_with_resources<ResourceRegistry<WorldScore>, WorldPosition>(
        &allocator,
        resource_registry(WorldScore { value: 0 }),
    );
    let mut replacement = replacement_created.expect("replacement world should allocate");
    defer replacement.deinit();
    let replacement_id = replacement
        .add_system(record_first_system)
        .expect("replacement system should register");

    assert(replacement_id.raw() == 0);
    assert(replacement_id != first_id);
    assert(!replacement.set_system_enabled(first_id, false));
    replacement.run_pipeline(SystemPipeline::Update);
    assert(world_score_equals(&replacement, 1));
}

@test
fn world_should_reserve_system_capacity_without_assigning_ids() {
    let allocator = general_allocator();
    let created: Result<
        World<ResourceRegistry<WorldScore>, Registry<WorldPosition>>,
        WorldError
    > = world_with_resources<ResourceRegistry<WorldScore>, WorldPosition>(
        &allocator,
        resource_registry(WorldScore { value: 0 }),
    );
    let mut world = created.expect("world allocation should succeed");
    defer world.deinit();

    let before_reservation = world.allocated_bytes();
    world
        .reserve_systems(SystemPipeline::Update, 2)
        .expect("system capacity reservation should succeed");
    let reserved_bytes = world.allocated_bytes();
    let first = world
        .add_system(record_first_system)
        .expect("first reserved registration should succeed");
    let second = world
        .add_system(record_second_system)
        .expect("second reserved registration should succeed");

    assert(reserved_bytes > before_reservation);
    assert(world.allocated_bytes() == reserved_bytes);
    assert(first.raw() == 0 && second.raw() == 1);
}

@test
fn world_should_reject_system_reservation_after_release() {
    let allocator = general_allocator();
    let created: Result<
        World<ResourceRegistry<WorldScore>, Registry<WorldPosition>>,
        WorldError
    > = world_with_resources<ResourceRegistry<WorldScore>, WorldPosition>(
        &allocator,
        resource_registry(WorldScore { value: 0 }),
    );
    let mut world = created.expect("world allocation should succeed");
    world.deinit();

    assert(match world.reserve_systems(SystemPipeline::Update, 1) {
        Err(WorldError::Released) => true,
        _ => false,
    });
    assert(match world.add_plugin(ordered_world_test_plugin) {
        Err(WorldError::Released) => true,
        _ => false,
    });
}
