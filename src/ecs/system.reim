    &FirstReadResource,
    &SecondReadResource,
    &ThirdReadResource,
    &mut QueryMut<First, ...Rest>,
) -> () {
    fn run<Resources: ResourceSet, Storage: ComponentSet>(
        &mut self,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
    ) {
        let selected = resources.split_resource_mut<
            WriteResource,
            FirstReadResource,
            SecondReadResource,
            ThirdReadResource,
        >();
        let mut query = match storage.component_query_mut<First, ...Rest>() {
            Some(value) => value,
            None => { return; },
        };
        let function = *self;
        function(
            selected.0,
            selected.1,
            selected.2,
            selected.3,
            &mut query,
        );
    }
}

@derive(Copy, Resource)
struct SystemTestCounter {
    value: i32,
}

impl ManagedResource for SystemTestCounter {
    fn release_resource(&mut self) {
        let _ = self;
    }
}

@derive(Copy, Component)
struct SystemTestComponent {
    value: i32,
}

const SYSTEM_TEST_STAGE_BYTES: usize = size_of<SystemEntry<
    ResourceRegistry<SystemTestCounter>,
    Registry<SystemTestComponent>,
>>() * 4;

fn increment_system_test_counter(counter: &mut SystemTestCounter) {
    counter.value += 1;
}

@test
fn failed_system_registration_should_not_consume_an_id() {
    let mut storage: [usize; 64] = [0; 64];
    let data = &mut storage[0] as *mut usize as *mut u8;
    let fixed = FixedBufferAllocator::init(data, SYSTEM_TEST_STAGE_BYTES)
        .expect("fixed system registry allocator should initialize");
    defer fixed.deinit();
    let mut registry: SystemRegistry<
        ResourceRegistry<SystemTestCounter>,
        Registry<SystemTestComponent>,
    > = SystemRegistry::new(fixed.allocator())
        .expect("system registry namespace should be available");
    defer registry.release();

    registry
        .reserve(SystemPipeline::Update, 1)
        .expect("Update stage reservation should fill the fixed allocator");
    assert(match registry.add(
        SystemPipeline::Input,
        increment_system_test_counter,
    ) {
        Err(SystemRegistryError::OutOfMemory) => true,
        _ => false,
    });
    let registered = registry
        .add(SystemPipeline::Update, increment_system_test_counter)
        .expect("reserved Update registration should not allocate");

    assert(registered.raw() == 0);
}
