}

impl<ReadResource: ManagedResource, Write: Component, ...Read: Component> System for fn(
    &ReadResource,
    &mut Query<Write, ...Read>,
) -> () {
    fn run<Resources: ResourceSet, Storage: ComponentSet>(
        &mut self,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
    ) {
        let resource = resources.registered_resource<ReadResource>();
        let mut query = match storage.component_query<Write, ...Read>() {
            Some(value) => value,
            None => { return; },
        };
        let function = *self;
        function(resource, &mut query);
    }
}

