/// A function system whose query is inferred from its parameter type.
pub struct QuerySystem<Write: Component, ...Read: Component> {
    function: fn(&mut Query<Write, ...Read>) -> (),
}

impl<Write: Component, ...Read: Component> QuerySystem<Write, ...Read> {
    /// Wraps a typed query function for static dispatch.
    pub fn new(
        function: fn(&mut Query<Write, ...Read>) -> (),
    ) -> QuerySystem<Write, ...Read> {
        QuerySystem { function: function }
    }

}

impl<Write: Component, ...Read: Component> System for QuerySystem<Write, ...Read> {
    fn run<Resources: ResourceSet, Storage: ComponentSet>(
        &mut self,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
    ) {
        let _ = resources;
        let mut query = match storage.component_query<Write, ...Read>() {
            Some(value) => value,
            None => {
                return;
            },
        };
        let function = self.function;
        function(&mut query);
    }
}

impl<Write: Component, ...Read: Component> System for fn(&mut Query<Write, ...Read>) -> () {
    fn run<Resources: ResourceSet, Storage: ComponentSet>(
        &mut self,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
    ) {
        let _ = resources;
        let mut query = match storage.component_query<Write, ...Read>() {
            Some(value) => value,
            None => { return; },
        };
        let function = *self;
        function(&mut query);
    }
}

impl<First: Component, ...Rest: Component> System for fn(
    &mut QueryMut<First, ...Rest>,
) -> () {
    fn run<Resources: ResourceSet, Storage: ComponentSet>(
        &mut self,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
