/// Internal static-dispatch contract implemented only for thin function
/// pointer signatures owned by this module.
pub trait System: Copy {
    /// Runs the system against a compatible component registry.
    fn run<Resources: ResourceSet, Storage: ComponentSet>(
        &mut self,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
    );
}

/// Stable identifier assigned when a system enters one world.
///
/// The visible number is local and monotonic, while an internal process-unique
/// namespace prevents IDs from affecting another or replacement world.
@derive(Copy, Clone, Debug, Eq, Hash)
pub struct SystemId {
    namespace: u64,
    pipeline: SystemPipeline,
    raw: usize,
}

impl SystemId {
    /// Returns the world-local numeric identifier.
    pub fn raw(&self) -> usize {
        self.raw
    }
}

/// Recoverable failures while changing a world's system registry.
@derive(Copy, Clone, Debug, Eq)
pub enum SystemRegistryError {
    OutOfMemory,
    IdExhausted,
    Released,
}

/// One type-erased system paired with its exact monomorphized runner.
@derive(Copy)
struct SystemEntry<Resources, Storage> {
    id: SystemId,
    address: usize,
    runner: fn(
        usize,
        &mut Entities,
        &mut Resources,
        &mut Storage,
    ) -> (),
    enabled: bool,
}

struct SystemStage<Resources, Storage> {
    entries: Vec<SystemEntry<Resources, Storage>>,
}

impl<Resources, Storage> SystemStage<Resources, Storage> {
    fn empty(allocator: &Allocator) -> SystemStage<Resources, Storage> {
        SystemStage { entries: Vec::empty(allocator) }
    }

    fn push(
        &mut self,
        entry: SystemEntry<Resources, Storage>,
    ) -> Result<(), SystemRegistryError> {
        match self.entries.push(entry) {
            Ok(_) => Ok(()),
            Err(AllocError::OutOfMemory) => Err(SystemRegistryError::OutOfMemory),
            _ => Err(SystemRegistryError::OutOfMemory),
        }
    }

    fn reserve(&mut self, additional: usize) -> Result<(), SystemRegistryError> {
        match self.entries.reserve(additional) {
            Ok(_) => Ok(()),
            Err(AllocError::OutOfMemory) => Err(SystemRegistryError::OutOfMemory),
            _ => Err(SystemRegistryError::OutOfMemory),
        }
    }

    fn run(
        &self,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
    ) {
        let mut index: usize = 0;
        while index < self.entries.len() {
            let entry = match self.entries.get_ref(index) {
                Some(value) => value,
                None => panic("system stage storage became inconsistent"),
            };
            if entry.enabled {
                let runner = entry.runner;
                runner(entry.address, entities, resources, storage);
            }
            index += 1;
        }
    }

    fn set_enabled(&mut self, id: SystemId, enabled: bool) -> bool {
        let mut index: usize = 0;
        while index < self.entries.len() {
            let entry = match self.entries.get_mut(index) {
                Some(value) => value,
                None => panic("system stage storage became inconsistent"),
            };
            if entry.id == id {
                entry.enabled = enabled;
                return true;
            }
            index += 1;
        }
        false
    }

    fn remove(&mut self, id: SystemId) -> bool {
        let mut index: usize = 0;
        while index < self.entries.len() {
            let matches = match self.entries.get(index) {
                Some(value) => value.id == id,
                None => panic("system stage storage became inconsistent"),
            };
            if matches {
                let _ = self.entries.remove(index);
                return true;
            }
            index += 1;
        }
        false
    }

    fn len(&self) -> usize {
        self.entries.len()
    }

    fn allocated_bytes(&self) -> usize {
        self.entries.allocated_bytes()
    }

    fn release(&mut self) {
        self.entries.release();
    }
}

/// Runtime registry for heterogeneous systems owned by one concrete world.
///
/// Each pipeline owns an independent packed stage, so execution visits only
/// systems registered for that pipeline. The public world type stays stable as
/// systems are added, removed, enabled, or disabled.
pub struct SystemRegistry<Resources, Storage> {
    input: SystemStage<Resources, Storage>,
    update: SystemStage<Resources, Storage>,
    physics: SystemStage<Resources, Storage>,
    async_update: SystemStage<Resources, Storage>,
    render: SystemStage<Resources, Storage>,
    render_ui: SystemStage<Resources, Storage>,
    namespace: u64,
    next_id: usize,
    released: bool,
}

impl<Resources, Storage> SystemRegistry<Resources, Storage> {
    /// Creates an empty registry with a process-unique owner namespace.
    pub fn new(
        allocator: &Allocator,
    ) -> Result<SystemRegistry<Resources, Storage>, SystemRegistryError> {
        let namespace = match next_registry_namespace() {
            Some(value) => value,
            None => { return Err(SystemRegistryError::IdExhausted); },
        };
        Ok(SystemRegistry {
            input: SystemStage::empty(allocator),
            update: SystemStage::empty(allocator),
            physics: SystemStage::empty(allocator),
            async_update: SystemStage::empty(allocator),
            render: SystemStage::empty(allocator),
            render_ui: SystemStage::empty(allocator),
            namespace: namespace,
            next_id: 0,
            released: false,
        })
    }

    /// Reserves room for `additional` registrations in one pipeline.
    ///
    /// Reservation does not assign IDs or change execution order. A successful
    /// call guarantees those registrations can be appended without another
    /// allocation unless systems are added to the same pipeline first.
    pub fn reserve(
        &mut self,
        pipeline: SystemPipeline,
        additional: usize,
    ) -> Result<(), SystemRegistryError> {
        if self.released {
            return Err(SystemRegistryError::Released);
        }
        match pipeline {
            SystemPipeline::Input => self.input.reserve(additional),
            SystemPipeline::Update => self.update.reserve(additional),
            SystemPipeline::Physics => self.physics.reserve(additional),
            SystemPipeline::AsyncUpdate => self.async_update.reserve(additional),
            SystemPipeline::Render => self.render.reserve(additional),
            SystemPipeline::RenderUi => self.render_ui.reserve(additional),
        }
    }

    /// Registers a function system and returns its monotonic world-local ID.
    pub fn add<Current: System>(
        &mut self,
        pipeline: SystemPipeline,
        system: Current,
    ) -> Result<SystemId, SystemRegistryError> {
        if self.released {
            return Err(SystemRegistryError::Released);
        }
        let next_id = match self.next_id.checked_add(1) {
            Some(value) => value,
            None => { return Err(SystemRegistryError::IdExhausted); },
        };
        let runner: fn(
            usize,
            &mut Entities,
            &mut Resources,
            &mut Storage,
        ) -> () = dispatch_system::<Current, Resources, Storage>;
        let entry: SystemEntry<Resources, Storage> = SystemEntry {
            id: SystemId {
                namespace: self.namespace,
                pipeline: pipeline,
                raw: self.next_id,
            },
            address: system as usize,
            runner: runner,
            enabled: true,
        };
        match pipeline {
            SystemPipeline::Input => self.input.push(entry)?,
            SystemPipeline::Update => self.update.push(entry)?,
            SystemPipeline::Physics => self.physics.push(entry)?,
            SystemPipeline::AsyncUpdate => self.async_update.push(entry)?,
            SystemPipeline::Render => self.render.push(entry)?,
            SystemPipeline::RenderUi => self.render_ui.push(entry)?,
        }
        self.next_id = next_id;
        Ok(entry.id)
    }

    pub fn run_pipeline(
        &self,
        pipeline: SystemPipeline,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
    ) {
        if self.released { return; }
        match pipeline {
            SystemPipeline::Input => self.input.run(entities, resources, storage),
            SystemPipeline::Update => self.update.run(entities, resources, storage),
            SystemPipeline::Physics => self.physics.run(entities, resources, storage),
            SystemPipeline::AsyncUpdate => {
                self.async_update.run(entities, resources, storage)
            },
            SystemPipeline::Render => self.render.run(entities, resources, storage),
            SystemPipeline::RenderUi => self.render_ui.run(entities, resources, storage),
        }
    }

    /// Enables or disables a registered system without changing its order.
    pub fn set_enabled(&mut self, id: SystemId, enabled: bool) -> bool {
        if self.released || id.namespace != self.namespace { return false; }
        match id.pipeline {
            SystemPipeline::Input => self.input.set_enabled(id, enabled),
            SystemPipeline::Update => self.update.set_enabled(id, enabled),
            SystemPipeline::Physics => self.physics.set_enabled(id, enabled),
            SystemPipeline::AsyncUpdate => self.async_update.set_enabled(id, enabled),
            SystemPipeline::Render => self.render.set_enabled(id, enabled),
            SystemPipeline::RenderUi => self.render_ui.set_enabled(id, enabled),
        }
    }

    /// Removes a registered system while preserving the order of survivors.
    pub fn remove(&mut self, id: SystemId) -> bool {
        if self.released || id.namespace != self.namespace { return false; }
        match id.pipeline {
            SystemPipeline::Input => self.input.remove(id),
            SystemPipeline::Update => self.update.remove(id),
            SystemPipeline::Physics => self.physics.remove(id),
            SystemPipeline::AsyncUpdate => self.async_update.remove(id),
            SystemPipeline::Render => self.render.remove(id),
            SystemPipeline::RenderUi => self.render_ui.remove(id),
        }
    }

    pub fn len(&self) -> usize {
        self.input.len()
            + self.update.len()
            + self.physics.len()
            + self.async_update.len()
            + self.render.len()
            + self.render_ui.len()
    }

    pub fn allocated_bytes(&self) -> usize {
        self.input.allocated_bytes()
            + self.update.allocated_bytes()
            + self.physics.allocated_bytes()
            + self.async_update.allocated_bytes()
            + self.render.allocated_bytes()
            + self.render_ui.allocated_bytes()
    }

    pub fn release(&mut self) {
        if self.released { return; }
        self.render_ui.release();
        self.render.release();
        self.async_update.release();
        self.physics.release();
        self.update.release();
        self.input.release();
        self.released = true;
    }
}

fn dispatch_system<
    Current: System,
    Resources: ResourceSet,
    Storage: ComponentSet,
>(
    address: usize,
    entities: &mut Entities,
    resources: &mut Resources,
    storage: &mut Storage,
) {
    // `add` derives both values from the same concrete `Current` function
    // pointer. Entries are private, so this reverse cast cannot be forged by
    // gameplay code.
    let mut system = unsafe { address as Current };
    system.run<Resources, Storage>(entities, resources, storage);
}

impl<WriteResource: ManagedResource> System for fn(&mut WriteResource) -> () {
    fn run<Resources: ResourceSet, Storage: ComponentSet>(
        &mut self,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
    ) {
        let _ = storage;
        let resource = resources.registered_resource_mut<WriteResource>();
        let function = *self;
        function(resource);
    }
}

impl<WriteResource: ManagedResource, ReadResource: ManagedResource> System for fn(
    &mut WriteResource,
    &ReadResource,
) -> () {
    fn run<Resources: ResourceSet, Storage: ComponentSet>(
        &mut self,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
    ) {
        let _ = storage;
        let selected = resources.split_resource_mut<WriteResource, ReadResource>();
        let function = *self;
        function(selected.0, selected.1);
    }
}

impl<FirstResource: ManagedResource, SecondResource: ManagedResource> System for fn(
    &mut FirstResource,
    &mut SecondResource,
) -> () {
    fn run<Resources: ResourceSet, Storage: ComponentSet>(
        &mut self,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
    ) {
        let _ = storage;
        let selected = resources.split_resources_mut<FirstResource, SecondResource>();
        let function = *self;
        function(selected.0, selected.1);
    }
}

impl<
    FirstWriteResource: ManagedResource,
    SecondWriteResource: ManagedResource,
    ReadResource: ManagedResource,
    Write: Component,
    ...Read: Component,
> System for fn(
    &mut FirstWriteResource,
    &mut SecondWriteResource,
    &ReadResource,
    &mut Query<Write, ...Read>,
) -> () {
    fn run<Resources: ResourceSet, Storage: ComponentSet>(
        &mut self,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
    ) {
        let selected = resources.split_resources_mut<
            FirstWriteResource,
            SecondWriteResource,
            ReadResource,
        >();
        let mut query = match storage.component_query<Write, ...Read>() {
            Some(value) => value,
            None => { return; },
        };
        let function = *self;
        function(selected.0, selected.1, &*selected.2, &mut query);
    }
}

