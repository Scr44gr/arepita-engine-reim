/// One statically linked system preceded by an existing system list.
pub struct SystemChain<Previous: SystemList, Current: System> {
    previous: Previous,
    pipeline: SystemPipeline,
    current: Current,
}

impl<Previous: SystemList, Current: System> SystemChain<Previous, Current> {
    /// Appends `current` after an existing system list.
    pub fn new(
        previous: Previous,
        pipeline: SystemPipeline,
        current: Current,
    ) -> SystemChain<Previous, Current> {
        SystemChain {
            previous: previous,
            pipeline: pipeline,
            current: current,
        }
    }
}

impl<Previous: SystemList, Current: System> SystemList for SystemChain<Previous, Current> {
    fn run_pipeline<Resources: ResourceSet, Storage: ComponentSet>(
        &mut self,
        pipeline: SystemPipeline,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
    ) {
        self.previous.run_pipeline<Resources, Storage>(
            pipeline,
            entities,
            resources,
            storage,
        );
        if self.pipeline == pipeline {
            self.current.run<Resources, Storage>(entities, resources, storage);
        }
    }
}
