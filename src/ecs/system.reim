from self::entity import Entities;
from self::query import Query, QueryMut;
from self::registry import ComponentSet;
from self::store import Component;
from super::app import ManagedResource, ResourceSet, SystemPipeline;

/// Internal static-dispatch contract implemented by registered systems.
pub trait System {
    /// Runs the system against a compatible component registry.
    fn run<Resources: ResourceSet, Storage: ComponentSet>(
        &mut self,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
    );
}

/// Internal static-dispatch contract implemented by system chains.
pub trait SystemList {
    /// Runs linked systems in registration order for one pipeline.
    fn run_pipeline<Resources: ResourceSet, Storage: ComponentSet>(
        &mut self,
        pipeline: SystemPipeline,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
    );
}

/// Empty system-list terminator used by a newly created world.
pub struct EmptySystems {}

impl SystemList for EmptySystems {
    fn run_pipeline<Resources: ResourceSet, Storage: ComponentSet>(
        &mut self,
        pipeline: SystemPipeline,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
    ) {
        let _ = self;
        let _ = pipeline;
        let _ = resources;
        let _ = storage;
    }
}

impl<WriteResource: ManagedResource> System for fn(&mut WriteResource) -> () {
    fn run<Resources: ResourceSet, Storage: ComponentSet>(
        &mut self,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
    ) {
        let _ = storage;
        let resource = resources.registered_resource_mut<WriteResource>();
        let function = *self;
        function(resource);
    }
}

impl<WriteResource: ManagedResource, ReadResource: ManagedResource> System for fn(
    &mut WriteResource,
    &ReadResource,
) -> () {
    fn run<Resources: ResourceSet, Storage: ComponentSet>(
        &mut self,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
    ) {
        let _ = storage;
        let selected = resources.split_resource_mut<WriteResource, ReadResource>();
        let function = *self;
        function(selected.0, selected.1);
    }
}

impl<FirstResource: ManagedResource, SecondResource: ManagedResource> System for fn(
    &mut FirstResource,
    &mut SecondResource,
) -> () {
    fn run<Resources: ResourceSet, Storage: ComponentSet>(
        &mut self,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
    ) {
        let _ = storage;
        let selected = resources.split_resources_mut<FirstResource, SecondResource>();
        let function = *self;
        function(selected.0, selected.1);
    }
}

impl<
    FirstWriteResource: ManagedResource,
    SecondWriteResource: ManagedResource,
    ReadResource: ManagedResource,
    Write: Component,
    ...Read: Component,
> System for fn(
    &mut FirstWriteResource,
    &mut SecondWriteResource,
    &ReadResource,
    &mut Query<Write, ...Read>,
) -> () {
    fn run<Resources: ResourceSet, Storage: ComponentSet>(
        &mut self,
        entities: &mut Entities,
        resources: &mut Resources,
        storage: &mut Storage,
    ) {
        let selected = resources.split_resources_mut<
            FirstWriteResource,
            SecondWriteResource,
            ReadResource,
        >();
        let mut query = match storage.component_query<Write, ...Read>() {
            Some(value) => value,
            None => { return; },
        };
        let function = *self;
        function(selected.0, selected.1, &*selected.2, &mut query);
    }
}

impl<
    FirstWriteResource: ManagedResource,
    SecondWriteResource: ManagedResource,
    First: Component,
    ...Rest: Component,
> System for fn(
    &mut FirstWriteResource,
    &mut SecondWriteResource,
