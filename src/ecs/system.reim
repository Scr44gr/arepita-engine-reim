from self::query import Query;
from self::registry import ComponentSet;
from self::store import Component;

/// Internal static-dispatch contract implemented by registered systems.
pub trait System {
    /// Runs the system against a compatible component registry.
    fn run<Storage: ComponentSet>(
        &mut self,
        storage: &mut Storage,
    );
}

/// Internal static-dispatch contract implemented by system chains.
pub trait SystemList {
    /// Runs every linked system in registration order.
    fn run_all<Storage: ComponentSet>(
        &mut self,
        storage: &mut Storage,
    );
}

/// Empty system-list terminator used by a newly created world.
pub struct EmptySystems {}

impl SystemList for EmptySystems {
    fn run_all<Storage: ComponentSet>(
        &mut self,
        storage: &mut Storage,
    ) {
        let _ = self;
        let _ = storage;
    }
}

/// A function system whose query is inferred from its parameter type.
pub struct QuerySystem<Write: Component, ...Read: Component> {
    function: fn(&mut Query<Write, ...Read>) -> (),
}

impl<Write: Component, ...Read: Component> QuerySystem<Write, ...Read> {
    /// Wraps a typed query function for static dispatch.
    pub fn new(
        function: fn(&mut Query<Write, ...Read>) -> (),
    ) -> QuerySystem<Write, ...Read> {
        QuerySystem { function: function }
    }

}

impl<Write: Component, ...Read: Component> System for QuerySystem<Write, ...Read> {
    fn run<Storage: ComponentSet>(
        &mut self,
        storage: &mut Storage,
    ) {
        let mut query = match storage.component_query<Write, ...Read>() {
            Some(value) => value,
            None => {
                return;
            },
        };
        let function = self.function;
        function(&mut query);
    }
}

/// One statically linked system preceded by an existing system list.
pub struct SystemChain<Previous: SystemList, Current: System> {
    previous: Previous,
    current: Current,
}

impl<Previous: SystemList, Current: System> SystemChain<Previous, Current> {
    /// Appends `current` after an existing system list.
    pub fn new(previous: Previous, current: Current) -> SystemChain<Previous, Current> {
        SystemChain { previous: previous, current: current }
    }
}

impl<Previous: SystemList, Current: System> SystemList for SystemChain<Previous, Current> {
    fn run_all<Storage: ComponentSet>(
        &mut self,
        storage: &mut Storage,
    ) {
        self.previous.run_all<Storage>(storage);
        self.current.run<Storage>(storage);
    }
}
