from std::alloc import AllocError;

from self::entity import Entity;
from self::store import Component, ComponentStore;

/// An allocation-free query with one writable component and any number of
/// read-only component types.
///
/// The first store drives dense iteration. Every read component is probed by
/// entity, so the query remains correct when stores have different dense order
/// or membership. Query construction statically splits disjoint registry
/// fields; no runtime type lookup or erased pointer is involved.
pub struct Query<Write: Component, ...Read: Component> {
    stores: (
        &mut ComponentStore<Write>,
        ...Read => &ComponentStore<Read>
    ),
}

/// An allocation-free query that mutably borrows every requested component.
///
/// `First` drives dense iteration. Remaining stores are split statically and
/// matched by entity, so systems can update several capabilities in one pass
/// without reopening the registry or constructing body-level queries.
pub struct QueryMut<First: Component, ...Rest: Component> {
    stores: (
        &mut ComponentStore<First>,
        ...Rest => &mut ComponentStore<Rest>
    ),
}

impl<Write: Component, ...Read: Component> Query<Write, ...Read> {
    /// Creates a query from a compiler-validated disjoint store split.
    ///
    /// Most applications should call `Registry::query`; this constructor is
    /// public so registry-like aggregate owners can reuse the query engine.
    pub fn from_stores(
        stores: (
            &mut ComponentStore<Write>,
            ...Read => &ComponentStore<Read>
        ),
    ) -> Query<Write, ...Read> {
        Query { stores: stores }
    }

    /// Returns the number of values in the writable driving store.
    ///
    /// The number of matching rows can be lower when a read component is
    /// missing from an entity.
    pub fn candidate_count(&self) -> usize {
        self.stores.0.len()
    }

    /// Runs `system` for every entity that owns all requested components.
    ///
    /// Read components are passed as a tuple in generic order. The tuple is
    /// made from compact `Copy` values, while the writable component is
    /// borrowed in place. The returned count is the number of matched rows.
    pub fn for_each(
        &mut self,
        system: fn(Entity, &mut Write, (...Read)) -> (),
    ) -> usize {
        let length = self.stores.0.len();
        let mut matched: usize = 0;
        let mut index: usize = 0;
        while index < length {
            let entity = match self.stores.0.entity_at(index) {
                Some(value) => value,
                None => panic("query driving entity index became inconsistent"),
            };
            let reads: (...Read) = (
                ...Read => {
                    let selected = self.stores.get_type<&ComponentStore<Read>>();
                    let store = *selected;
                    match store.get(entity) {
                        Some(value) => value,
                        None => {
                            index += 1;
                            continue;
                        },
                    }
                },
            );
            let write = match self.stores.0.value_mut_at(index) {
                Some(value) => value,
                None => panic("query driving value index became inconsistent"),
            };
            system(entity, write, reads);
            matched += 1;
            index += 1;
        }
        matched
    }

    /// Runs `system` with one caller-owned context for every matching entity.
    ///
    /// The context makes resource-backed systems allocation-free without
    /// globals or captured closures. It is borrowed only for the duration of
    /// this call and cannot escape the query.
    pub fn for_each_with<Context>(
        &mut self,
        context: &mut Context,
        system: fn(&mut Context, Entity, &mut Write, (...Read)) -> (),
    ) -> usize {
        let length = self.stores.0.len();
        let mut matched: usize = 0;
        let mut index: usize = 0;
        while index < length {
            let entity = match self.stores.0.entity_at(index) {
                Some(value) => value,
                None => panic("query driving entity index became inconsistent"),
            };
            let reads: (...Read) = (
                ...Read => {
                    let selected = self.stores.get_type<&ComponentStore<Read>>();
                    let store = *selected;
                    match store.get(entity) {
                        Some(value) => value,
                        None => {
                            index += 1;
                            continue;
                        },
                    }
                },
            );
            let write = match self.stores.0.value_mut_at(index) {
                Some(value) => value,
                None => panic("query driving value index became inconsistent"),
            };
            system(context, entity, write, reads);
            matched += 1;
            index += 1;
        }
        matched
    }

    /// Runs `system` for a bounded contiguous range of the driving store.
    ///
    /// This is intended for deterministic time slicing: callers can divide
    /// `candidate_count()` into stable ranges and process one range per frame
    /// without scanning every component first.
    pub fn for_each_range_with<Context>(
        &mut self,
        start: usize,
        maximum: usize,
        context: &mut Context,
        system: fn(&mut Context, Entity, &mut Write, (...Read)) -> (),
    ) -> usize {
        let length = self.stores.0.len();
        if start >= length || maximum == 0 { return 0; }
        let remaining = length - start;
        let selected = if maximum < remaining { maximum } else { remaining };
        let end = start + selected;
        let mut matched: usize = 0;
        let mut index = start;
        while index < end {
            let entity = match self.stores.0.entity_at(index) {
                Some(value) => value,
                None => panic("query driving entity index became inconsistent"),
            };
            let reads: (...Read) = (
                ...Read => {
                    let selected_store = self.stores.get_type<&ComponentStore<Read>>();
                    let store = *selected_store;
                    match store.get(entity) {
                        Some(value) => value,
                        None => {
                            index += 1;
                            continue;
                        },
                    }
                },
            );
            let write = match self.stores.0.value_mut_at(index) {
                Some(value) => value,
                None => panic("query driving value index became inconsistent"),
            };
            system(context, entity, write, reads);
            matched += 1;
            index += 1;
        }
        matched
    }
}

impl<First: Component, ...Rest: Component> QueryMut<First, ...Rest> {
    /// Creates a multi-write query from a statically validated store split.
    pub fn from_stores(
        stores: (
            &mut ComponentStore<First>,
            ...Rest => &mut ComponentStore<Rest>
        ),
    ) -> QueryMut<First, ...Rest> {
        QueryMut { stores: stores }
    }

    /// Returns the number of values in the driving store.
    pub fn candidate_count(&self) -> usize {
        self.stores.0.len()
    }

    /// Reserves one slot in a selected store before a structural command.
    ///
    /// `Selected` must be one of this query's component types. Bundle builders
    /// reserve every selected type first, then perform allocation-free inserts.
    pub fn reserve_component<Selected: Component>(
        &mut self,
        entity: Entity,
    ) -> Result<(), AllocError> {
        let selected = self.stores.get_type_mut<
            &mut ComponentStore<Selected>
        >();
        let store = &mut **selected;
        store.reserve(1, entity.index())
    }

    /// Inserts or replaces one selected component after optional reservation.
    pub fn insert_component<Selected: Component>(
        &mut self,
        entity: Entity,
        value: Selected,
    ) -> Result<Option<Selected>, AllocError> {
        let selected = self.stores.get_type_mut<
            &mut ComponentStore<Selected>
        >();
        let store = &mut **selected;
        store.insert(entity, value)
    }

    /// Inserts one complete typed component bundle without partial writes.
    ///
    /// Every selected store is reserved before the first component is
    /// inserted. A reservation failure therefore leaves all stores unchanged.
    /// The tuple order is irrelevant because values are selected by type.
    pub fn insert_bundle(
        &mut self,
        entity: Entity,
        values: (First, ...Rest),
    ) -> Result<(), AllocError> {
        values.assert_unique_types();
        let first_reserved = match self.reserve_component<First>(entity) {
            Ok(_) => true,
            Err(_) => false,
        };
        if !first_reserved { return Err(AllocError::OutOfMemory); }
        let reservations = [
            ...Rest => {
                match self.reserve_component<Rest>(entity) {
                    Ok(_) => true,
                    Err(_) => false,
                }
            },
        ];
        for reserved in reservations {
            if !reserved { return Err(AllocError::OutOfMemory); }
        }

        let first = *values.get_type<First>();
        match self.insert_component<First>(entity, first) {
            Ok(_) => {},
            Err(_) => panic("reserved component insertion became inconsistent"),
        }
        let insertions = [
            ...Rest => {
                let value = *values.get_type<Rest>();
                match self.insert_component<Rest>(entity, value) {
                    Ok(_) => true,
                    Err(_) => false,
                }
            },
        ];
        for inserted in insertions {
            if !inserted {
                panic("reserved component insertion became inconsistent")
            }
        }
        Ok(())
    }

    /// Mutably visits every entity that owns all requested components.
    pub fn for_each(
        &mut self,
        system: fn(Entity, &mut First, (...Rest => &mut Rest)) -> (),
    ) -> usize {
        let length = self.stores.0.len();
        let mut matched: usize = 0;
        let mut index: usize = 0;
        while index < length {
            let entity = match self.stores.0.entity_at(index) {
                Some(value) => value,
                None => panic("query driving entity index became inconsistent"),
            };
            let rest: (...Rest => &mut Rest) = (
                ...Rest => {
                    let selected = self.stores.get_type_mut<
                        &mut ComponentStore<Rest>
                    >();
                    let store = &mut **selected;
                    match store.get_mut(entity) {
                        Some(value) => value,
                        None => {
                            index += 1;
                            continue;
                        },
                    }
                },
            );
            let first = match self.stores.0.value_mut_at(index) {
                Some(value) => value,
                None => panic("query driving value index became inconsistent"),
            };
            system(entity, first, rest);
            matched += 1;
            index += 1;
        }
        matched
    }

    /// Mutably visits matching entities with one caller-owned context.
    pub fn for_each_with<Context>(
        &mut self,
        context: &mut Context,
        system: fn(
            &mut Context,
            Entity,
            &mut First,
            (...Rest => &mut Rest),
        ) -> (),
    ) -> usize {
        let length = self.stores.0.len();
        let mut matched: usize = 0;
        let mut index: usize = 0;
        while index < length {
            let entity = match self.stores.0.entity_at(index) {
                Some(value) => value,
                None => panic("query driving entity index became inconsistent"),
            };
            let rest: (...Rest => &mut Rest) = (
                ...Rest => {
                    let selected = self.stores.get_type_mut<
                        &mut ComponentStore<Rest>
                    >();
                    let store = &mut **selected;
                    match store.get_mut(entity) {
                        Some(value) => value,
                        None => {
                            index += 1;
                            continue;
                        },
                    }
                },
            );
            let first = match self.stores.0.value_mut_at(index) {
                Some(value) => value,
                None => panic("query driving value index became inconsistent"),
            };
            system(context, entity, first, rest);
            matched += 1;
            index += 1;
        }
        matched
    }

    /// Mutably visits a bounded contiguous range of the driving store.
    ///
    /// The range is clamped to the current dense length, making it suitable
    /// for frame-to-frame work partitioning even as entities are added or
    /// removed at structural barriers.
    pub fn for_each_range_with<Context>(
        &mut self,
        start: usize,
        maximum: usize,
        context: &mut Context,
        system: fn(
            &mut Context,
            Entity,
            &mut First,
            (...Rest => &mut Rest),
        ) -> (),
    ) -> usize {
        let length = self.stores.0.len();
        if start >= length || maximum == 0 { return 0; }
        let remaining = length - start;
        let selected = if maximum < remaining { maximum } else { remaining };
        let end = start + selected;
        let mut matched: usize = 0;
        let mut index = start;
        while index < end {
            let entity = match self.stores.0.entity_at(index) {
                Some(value) => value,
                None => panic("query driving entity index became inconsistent"),
            };
            let rest: (...Rest => &mut Rest) = (
                ...Rest => {
                    let selected_store = self.stores.get_type_mut<
                        &mut ComponentStore<Rest>
                    >();
                    let store = &mut **selected_store;
                    match store.get_mut(entity) {
                        Some(value) => value,
                        None => {
                            index += 1;
                            continue;
                        },
                    }
                },
            );
            let first = match self.stores.0.value_mut_at(index) {
                Some(value) => value,
                None => panic("query driving value index became inconsistent"),
            };
            system(context, entity, first, rest);
            matched += 1;
            index += 1;
        }
        matched
    }
}
