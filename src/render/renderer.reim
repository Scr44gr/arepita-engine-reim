from sdl3 import Window;
from self::context import ClearColor, GpuContext, PresentationMode, RenderFrame, RendererBackend, RendererError;
from self::sprite_batch import SpriteBatch;
from self::sprite_renderer import PreparedSpriteLayer, RenderReport, SpriteRenderer, SpriteView;
from wgpu_sdl3 import WindowSurface, create_window_surface;

/// High-level renderer that owns presentation resources in dependency order.
///
/// The SDL window remains owned by `WindowHost`. This object owns the surface,
/// GPU context, and sprite pipeline, which prevents applications from
/// accidentally releasing a device before its buffers or surface.
pub struct Renderer {
    surface: WindowSurface,
    context: GpuContext,
    sprites: SpriteRenderer,
    released: bool,
}

/// Immutable renderer creation policy.
@derive(Copy, Clone, Debug, Eq)
pub struct RendererConfig {
    sprite_capacity: usize,
    presentation_mode: PresentationMode,
    backend: RendererBackend,
}

impl RendererConfig {
    /// Creates a FIFO renderer configuration with fixed sprite capacity.
    pub fn new(sprite_capacity: usize) -> RendererConfig {
        RendererConfig {
            sprite_capacity: sprite_capacity,
            presentation_mode: PresentationMode::Fifo,
            backend: RendererBackend::Automatic,
        }
    }

    /// Selects a presentation mode. Creation fails when it is unsupported.
    pub fn with_presentation_mode(
        self,
        presentation_mode: PresentationMode,
    ) -> RendererConfig {
        let mut config = self;
        config.presentation_mode = presentation_mode;
        config
    }

    /// Returns the prepared no-growth sprite capacity.
    pub fn sprite_capacity(&self) -> usize { self.sprite_capacity }

    /// Returns the requested presentation mode.
    pub fn presentation_mode(&self) -> PresentationMode {
        self.presentation_mode
    }

    /// Selects a native graphics API instead of automatic adapter selection.
    pub fn with_backend(self, backend: RendererBackend) -> RendererConfig {
        let mut config = self;
        config.backend = backend;
        config
    }

    pub fn backend(&self) -> RendererBackend { self.backend }
}

impl Renderer {
    /// Creates a renderer and reserves a fixed no-growth sprite capacity.
    pub fn create(
        window: &Window,
        sprite_capacity: usize,
    ) -> Result<Renderer, RendererError> {
        Renderer::create_with_config(window, RendererConfig::new(sprite_capacity))
    }

    /// Creates a renderer from an explicit immutable configuration.
    pub fn create_with_config(
        window: &Window,
        config: RendererConfig,
    ) -> Result<Renderer, RendererError> {
        let mut surface = match create_window_surface(window) {
            Ok(value) => value,
            Err(_) => {
                return Err(RendererError::SurfaceCreationFailed);
            },
        };
        let mut context = match GpuContext::create_with_options(
            &mut surface,
            config.presentation_mode,
            config.backend,
        ) {
            Ok(value) => value,
            Err(error) => {
                surface.release();
                return Err(error);
            },
        };
        let sprites = match SpriteRenderer::create(
            &context,
            config.sprite_capacity,
        ) {
            Ok(value) => value,
            Err(error) => {
                context.release(&mut surface);
                surface.release();
                return Err(error);
            },
        };
        Ok(Renderer {
            surface: surface,
            context: context,
            sprites: sprites,
            released: false,
        })
    }

    /// Replaces the sprite material shader without recreating the surface,
    /// device, atlas texture, or instance buffer.
    ///
    /// Applications should call this during loading before frame submission.
    pub fn set_sprite_shader(
        &mut self,
        shader_source: str,
    ) -> Result<(), RendererError> {
        if self.released {
            return Err(RendererError::Released);
        }
        self.sprites.set_shader(&self.context, shader_source)
    }

    /// Reconfigures the presentation surface after a size or density change.
    pub fn resize(&mut self) -> Result<(), RendererError> {
        if self.released {
            return Err(RendererError::Released);
        }
        self.context.resize(&mut self.surface)
    }

    /// Returns whether the surface now yields images at its configured extent.
    pub fn surface_extent_ready(&self) -> Result<bool, RendererError> {
        if self.released {
            return Err(RendererError::Released);
        }
        self.context.surface_extent_ready(&self.surface)
    }

    /// Begins one shared render transaction without recording a sprite layer.
    pub fn begin_frame(
        &self,
        clear: ClearColor,
    ) -> Result<RenderFrame, RendererError> {
        if self.released {
            return Err(RendererError::Released);
        }
        self.context.begin_render_frame(&self.surface, clear)
    }

    /// Records an ordinary transient sprite batch into an existing frame.
    pub fn draw_sprites_into_frame(
        &self,
        batch: &SpriteBatch,
        frame: &mut RenderFrame,
    ) -> Result<RenderReport, RendererError> {
        if self.released {
            return Err(RendererError::Released);
        }
        self.sprites.draw_into(&self.context, batch, frame)
    }

    /// Uploads a sprite layer once so later frames can draw GPU-resident ranges.
    pub fn prepare_sprite_layer(
        &self,
        batch: &SpriteBatch,
    ) -> Result<PreparedSpriteLayer, RendererError> {
        if self.released {
            return Err(RendererError::Released);
        }
        self.sprites.prepare_layer(&self.context, batch)
    }

    /// Refreshes a prepared layer after its source data changes.
    pub fn update_sprite_layer(
        &self,
        layer: &mut PreparedSpriteLayer,
        batch: &SpriteBatch,
    ) -> Result<(), RendererError> {
        if self.released {
            return Err(RendererError::Released);
        }
        self.sprites.update_layer(&self.context, layer, batch)
    }

    /// Draws a visible range from a persistent world-space sprite layer.
    pub fn draw_prepared_sprite_range(
        &self,
        layer: &PreparedSpriteLayer,
        first_instance: usize,
        instance_count: usize,
        frame: &mut RenderFrame,
    ) -> Result<RenderReport, RendererError> {
        if self.released {
            return Err(RendererError::Released);
        }
        self.sprites.draw_layer_range_into(
            layer,
            first_instance,
            instance_count,
            frame,
        )
    }

    /// Updates the projection used by prepared world-space layers.
    pub fn set_world_sprite_view(
        &self,
        view: SpriteView,
    ) -> Result<(), RendererError> {
        if self.released {
            return Err(RendererError::Released);
        }
        self.sprites.set_world_view(&self.context, view)
    }

    /// Updates parameters attached to ordinary clip-space sprite batches.
    pub fn set_screen_sprite_view(
        &self,
        view: SpriteView,
    ) -> Result<(), RendererError> {
        if self.released {
            return Err(RendererError::Released);
        }
        self.sprites.set_screen_view(&self.context, view)
    }

    /// Draws one packed sprite batch and reports the submitted work.
    pub fn draw_sprites(
        &self,
        batch: &SpriteBatch,
        clear: ClearColor,
    ) -> Result<RenderReport, RendererError> {
        if self.released {
            return Err(RendererError::Released);
        }
        let result = self.draw_sprites_to_frame(batch, clear)?;
        let frame = result.0;
        let report = result.1;
        self.present_frame(frame)?;
        Ok(report)
    }

    /// Records sprites into a frame that remains open for ordered extensions.
    ///
    /// The caller must finish the returned frame with `present_frame` or
    /// discard it after a later rendering error.
    pub fn draw_sprites_to_frame(
        &self,
        batch: &SpriteBatch,
        clear: ClearColor,
    ) -> Result<(RenderFrame, RenderReport), RendererError> {
        if self.released {
            return Err(RendererError::Released);
        }
        let mut frame = self.begin_frame(clear)?;
        match self.draw_sprites_into_frame(batch, &mut frame) {
            Ok(report) => Ok((frame, report)),
            Err(error) => {
                frame.discard();
                Err(error)
            },
        }
    }

    /// Submits and presents a frame after every ordered layer has recorded.
    pub fn present_frame(&self, frame: RenderFrame) -> Result<(), RendererError> {
        if self.released {
            frame.discard();
            Err(RendererError::Released)
        } else {
            self.context.finish_render_frame(frame)
        }
    }

    /// Borrows backend state for safe renderer extensions such as debug UI.
    pub fn backend_context(&self) -> Result<&GpuContext, RendererError> {
        if self.released {
            Err(RendererError::Released)
        } else {
            Ok(&self.context)
        }
    }

    /// Grows persistent instance storage outside frame-critical work.
    pub fn reserve_sprites(
        &mut self,
        capacity: usize,
    ) -> Result<(), RendererError> {
        if self.released {
            return Err(RendererError::Released);
        }
        self.sprites.reserve(&self.context, capacity)
    }

    /// Replaces the active sprite atlas from tightly packed sRGB RGBA8 pixels.
    pub fn set_sprite_atlas_rgba8(
        &mut self,
        width: u32,
        height: u32,
        pixels: &[u8],
    ) -> Result<(), RendererError> {
        if self.released {
            return Err(RendererError::Released);
        }
        self.sprites.set_atlas_rgba8(
            &self.context,
            width,
            height,
            pixels,
        )
    }

    /// Replaces the application-defined auxiliary sprite texture.
    ///
    /// Custom material shaders can sample it from group 0, binding 2. The
    /// renderer keeps a 1x1 white fallback bound until an application opts in.
    pub fn set_sprite_auxiliary_rgba8(
        &mut self,
        width: u32,
        height: u32,
        pixels: &[u8],
    ) -> Result<(), RendererError> {
        if self.released {
            return Err(RendererError::Released);
        }
        self.sprites.set_auxiliary_rgba8(
            &self.context,
            width,
            height,
            pixels,
        )
    }

    /// Updates the existing auxiliary texture without replacing GPU handles.
    pub fn update_sprite_auxiliary_rgba8(
        &self,
        width: u32,
        height: u32,
        pixels: &[u8],
    ) -> Result<(), RendererError> {
        if self.released {
            return Err(RendererError::Released);
        }
        self.sprites.update_auxiliary_rgba8(
            &self.context,
            width,
            height,
            pixels,
        )
    }

    /// Returns persistent GPU buffer memory tracked by the renderer.
    pub fn allocated_gpu_bytes(&self) -> u64 {
        if self.released { 0 } else { self.sprites.allocated_bytes() }
    }

    /// Returns the drawable width in physical pixels.
    pub fn width(&self) -> u32 {
        self.context.width()
    }

    /// Returns the drawable height in physical pixels.
    pub fn height(&self) -> u32 {
        self.context.height()
    }

    /// Returns whether presentation is paused for a zero-sized window.
    pub fn is_suspended(&self) -> bool {
        self.context.is_suspended()
    }

    /// Returns the active presentation policy.
    pub fn presentation_mode(&self) -> PresentationMode {
        self.context.presentation_mode()
    }

    /// Returns the requested graphics backend retained by the live context.
    pub fn backend(&self) -> RendererBackend { self.context.backend() }

    /// Returns whether this renderer has crossed its final release barrier.
    pub fn is_released(&self) -> bool {
        self.released
    }

    /// Releases pipeline, buffer, device, surface, and platform objects once.
    pub fn release(&mut self) {
        if self.released {
            return;
        }
        self.sprites.release();
        self.context.release(&mut self.surface);
        self.surface.release();
        self.released = true;
    }
}

@test
fn renderer_config_should_default_to_fifo_and_preserve_explicit_mode() {
    let default = RendererConfig::new(2_048);
    assert(default.sprite_capacity() == 2_048);
    assert(default.presentation_mode() == PresentationMode::Fifo);

    let immediate = default.with_presentation_mode(PresentationMode::Immediate);
    assert(immediate.sprite_capacity() == 2_048);
    assert(immediate.presentation_mode() == PresentationMode::Immediate);
    assert(immediate.backend() == RendererBackend::Automatic);
    let vulkan = immediate.with_backend(RendererBackend::Vulkan);
    assert(vulkan.backend() == RendererBackend::Vulkan);
}
