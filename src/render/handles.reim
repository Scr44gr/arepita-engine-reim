/// Generational handle for an uploaded texture.
@derive(Copy, Clone, Debug, Eq, Hash)
pub struct TextureHandle {
    index: u32,
    generation: u32,
}

impl TextureHandle {
    pub fn from_parts(index: u32, generation: u32) -> TextureHandle {
        TextureHandle { index: index, generation: generation }
    }

    pub fn index(&self) -> u32 { self.index }

    pub fn generation(&self) -> u32 { self.generation }
}
/// Generational handle for an immutable mesh allocation.
@derive(Copy, Clone, Debug, Eq, Hash)
pub struct MeshHandle {
    index: u32,
